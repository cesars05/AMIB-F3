def chart_base(ch,legend=False):
    ch.font.size=Pt(10); ch.font.name="Arial"
    ch.has_legend=legend
    if legend: ch.legend.position=XL_LEGEND_POSITION.BOTTOM; ch.legend.include_in_layout=False; ch.legend.font.size=Pt(10)
    cs=ch._chartSpace; c=cs.find(qn("c:chart")); t=c.find(qn("c:title"))
    if t is not None: c.remove(t)
    atd=c.find(qn("c:autoTitleDeleted"))
    if atd is None: atd=etree.Element(qn("c:autoTitleDeleted")); c.insert(0,atd)
    atd.set("val","1")
def fix_invert(ser):
    ser.invert_if_negative=False
    for d in ser._element.findall(qn("c:dPt")):
        if d.find(qn("c:invertIfNegative")) is None:
            e=etree.Element(qn("c:invertIfNegative")); e.set("val","0"); d.find(qn("c:idx")).addnext(e)
def pad(ch,vals,lo=0.30,hi=0.20):
    v=[x for x in vals if num(x)]; a=min(v+[0]); b=max(v+[0]); sp=(b-a) or 1
    va=ch.value_axis; va.minimum_scale=a-lo*sp if a<0 else 0; va.maximum_scale=b+hi*sp if b>0 else 0
def ser_labels(s,fmt,bold=False,size=10,pos=XL_LABEL_POSITION.OUTSIDE_END):
