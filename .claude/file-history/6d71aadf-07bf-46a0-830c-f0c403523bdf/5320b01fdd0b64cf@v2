def setcell(ce,text,font=10,bold=False,color=BLACK,fill=None,align=PP_ALIGN.CENTER,top_line=False):
    ce.margin_left=ce.margin_right=Emu(40000); ce.margin_top=ce.margin_bottom=Emu(10000); ce.vertical_anchor=MSO_ANCHOR.MIDDLE
    tf=ce.text_frame; tf.word_wrap=True; tf.clear(); p=tf.paragraphs[0]; p.alignment=align
    r=p.add_run(); r.text=str(text); run_fmt(r,font,bold,False,color)
    tcPr=ce._tc.get_or_add_tcPr()
    for ch_ in list(tcPr): tcPr.remove(ch_)
    for tag in ("a:lnL","a:lnR","a:lnT","a:lnB"):
        ln=etree.SubElement(tcPr,qn(tag))
        if tag=="a:lnT" and top_line:
            ln.set("w","9525"); sf=etree.SubElement(ln,qn("a:solidFill")); c=etree.SubElement(sf,qn("a:srgbClr")); c.set("val","000000")
        else: ln.set("w","0"); etree.SubElement(ln,qn("a:noFill"))
    if fill is None: etree.SubElement(tcPr,qn("a:noFill"))
    else: sf=etree.SubElement(tcPr,qn("a:solidFill")); c=etree.SubElement(sf,qn("a:srgbClr")); c.set("val",fill)
def table(sl,x,y,w,hdr,rows,col_w,row_h=19.2,font=10,hdr_fill="242852",total=False,hi_rows=(),row_colors=None):
    nr=len(rows)+1; nc=len(hdr)
    gf=sl.shapes.add_table(nr,nc,E(x),E(y),E(w),E(row_h*nr)); tb=gf.table; tblPr=tb._tbl.tblPr
    for a in ("bandRow","firstRow"): tblPr.set(a,"0")
    sid=tblPr.find(qn("a:tableStyleId"))
    if sid is not None: sid.text="{5940675A-B579-460E-94D1-54222C63F5DA}"
    tot=sum(col_w)
    for i,cw in enumerate(col_w): tb.columns[i].width=E(w*cw/tot)
    for r in range(nr): tb.rows[r].height=E(row_h)
    for c,h in enumerate(hdr): setcell(tb.cell(0,c),h,font,True,WHITE,hdr_fill,PP_ALIGN.LEFT if c==0 else PP_ALIGN.CENTER)
    for r,row in enumerate(rows,1):
        last=total and r==nr-1
        fill="EEF2FA" if last else ("F2F2F2" if (r-1) in hi_rows else None)
        col=row_colors[r-1] if row_colors and row_colors[r-1] else BLACK
        for c,v in enumerate(row): setcell(tb.cell(r,c),v,font,last or (row_colors is not None and row_colors[r-1] is not None),col,fill,PP_ALIGN.LEFT if c==0 else PP_ALIGN.CENTER,top_line=last)
    return tb
def note_box(sl,x,y,w,items,size=9,space=4):
    cpl=(w-7.2-10.8)/(size*0.50)
    nl=sum(math.ceil(len("".join(t for t,_ in it))/cpl) for it in items)
    hh=nl*size*1.2+space*(len(items)-1)+8
    sh=sl.shapes.add_textbox(E(x),E(y),E(w),E(hh)); tf=sh.text_frame; tf.word_wrap=True
    tf.margin_left=tf.margin_right=tf.margin_top=tf.margin_bottom=Emu(45720)
    sh.line.color.rgb=BLACK; sh.line.width=Pt(0.75)
    bp=tf._txBody.find(qn("a:bodyPr"))
    for c in list(bp): bp.remove(c)
    bp.set("wrap","square")
    for k,it in enumerate(items):
        p=tf.paragraphs[0] if k==0 else tf.add_paragraph(); p.alignment=PP_ALIGN.JUSTIFY; p.space_after=Pt(space)
        for t,st in it:
            r=p.add_run(); r.text=t; run_fmt(r,size,st>0,False,NAVYB if st==2 else BLACK)
        pPr=p._p.get_or_add_pPr(); pPr.set("marL","137160"); pPr.set("indent","-137160")
        bf=etree.SubElement(pPr,qn("a:buFont")); bf.set("typeface","Arial"); bc=etree.SubElement(pPr,qn("a:buChar")); bc.set("char","•")
    return sh

