def bar_chart(sl,x,y,w,h,cats,series,horizontal=True,fmt="0.0",gap=80,legend=None,per_point=None,lo=0.30,hi=0.22,cat_size=10,lbl=10):
    """series: list of (name, values, color, bold_labels)"""
    cd=CategoryChartData(); cd.categories=cats
    for nm,vals,_,_ in series: cd.add_series(nm,vals)
    t=XL_CHART_TYPE.BAR_CLUSTERED if horizontal else XL_CHART_TYPE.COLUMN_CLUSTERED
    ch=sl.shapes.add_chart(t,E(x),E(y),E(w),E(h),cd).chart
    chart_base(ch,legend if legend is not None else len(series)>1)
    ca=ch.category_axis; va=ch.value_axis
    ca.tick_labels.font.size=Pt(cat_size); ca.format.line.color.rgb=BLACK; ca.has_major_gridlines=False
    ca.tick_label_position=XL_TICK_LABEL_POSITION.LOW; ca.major_tick_mark=2  # out
    va.visible=False; va.has_major_gridlines=False
    if horizontal: ca.reverse_order=True
    for k,(nm,vals,col,bold) in enumerate(series):
        s=ch.plots[0].series[k]; s.format.fill.solid(); s.format.fill.fore_color.rgb=col
        if per_point:
            cols=per_point(k)
            if cols:
                for i,c_ in enumerate(cols): pt=s.points[i]; pt.format.fill.solid(); pt.format.fill.fore_color.rgb=c_
        fix_invert(s); ser_labels(s,fmt,bold,lbl)
    ch.plots[0].gap_width=gap
    if len(series)>1: ch.plots[0].overlap=-15
    pad(ch,[v for _,vals,_,_ in series for v in vals],lo,hi)
    return ch
