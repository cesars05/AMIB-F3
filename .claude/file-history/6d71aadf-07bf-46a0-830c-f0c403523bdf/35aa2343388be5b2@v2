def rng(ds, col, absolute=True):
    return f"'{ds}'!${col}$11:${col}${DS_END}"


MEAN = "Summary!$D$5"


def harm(w, v, cond=""):
    return (f"SUMPRODUCT({w}*({v}>0){cond})/SUMPRODUCT({w}*({v}>0){cond}/({v}+({v}<=0)))")


def arith(w, v, cond=""):
    return f"SUMPRODUCT({w}*({v}<>0){cond}*{v})/SUMPRODUCT({w}*({v}<>0){cond})"


def metric(kind, w, v, cond=""):
    if kind == "harm":
        return f"=IFERROR({harm(w, v, cond)},\"\")"
    if kind == "arith":
        return f"=IFERROR({arith(w, v, cond)},\"\")"
    return f"=IFERROR(IF({MEAN}=\"Harmonic\",{harm(w, v, cond)},{arith(w, v, cond)}),\"\")"


