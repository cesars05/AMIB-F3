def R(fn, *a, **k):
    for t in range(200):
        try:
            return fn(*a, **k)
        except pywintypes.com_error as e:
            if e.args[0] in (-2147418111, -2147417846, -2146777998):
                time.sleep(1); continue
            raise

def L(n):  # 1-based column -> letter
    s = ""
    while n:
        n, r = divmod(n - 1, 26); s = chr(65 + r) + s
    return s
def C(letter):
    n = 0
    for ch in letter: n = n * 26 + ord(ch) - 64
    return n

