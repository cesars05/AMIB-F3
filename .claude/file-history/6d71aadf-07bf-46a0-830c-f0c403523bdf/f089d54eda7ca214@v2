def fmt_from(src, dst):
    """Copy the visible style of src onto dst without using the clipboard."""
    def _do():
        if src.Interior.Pattern != -4142:
            dst.Interior.Color = src.Interior.Color
        f, g = dst.Font, src.Font
        f.Name = g.Name; f.Size = g.Size; f.Bold = g.Bold; f.Color = g.Color
        b = src.Borders(9)
        if b.LineStyle != -4142:
            dst.Borders(9).LineStyle = b.LineStyle; dst.Borders(9).Weight = b.Weight; dst.Borders(9).Color = b.Color
        dst.VerticalAlignment = src.VerticalAlignment
    R(_do)

def put(ws, addr, rows):
    n = len(rows); m = max(len(r) for r in rows)
    rows = [list(r) + [None] * (m - len(r)) for r in rows]
    R(lambda: setattr(ws.Range(addr).GetResize(n, m), "Value2", tuple(tuple(r) for r in rows)))

def note(ws, addr, text):
    c = ws.Range(addr); c.Value = text; c.Font.Italic = True; c.Font.Size = 9; c.Font.Color = GREY

def sheet(name, after):
    """Reuse sheet if it exists (keeps inbound references valid), else create."""
    for s in wb.Worksheets:
        if s.Name == name:
            s.Activate()
            for co in list(s.ChartObjects()): co.Delete()
            s.Cells.Clear(); s.Cells.FormatConditions.Delete()
            return s
    ws = wb.Worksheets.Add(After=wb.Worksheets(after)); ws.Name = name; ws.Activate()
    return ws

def base(ws):
