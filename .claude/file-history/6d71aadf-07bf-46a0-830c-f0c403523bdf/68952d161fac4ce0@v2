"""Hit rate of AZTD picks vs the peers' same-sector return (formulas)."""
import pickle, re
import engine as E
from build_live_helpers import *   # noqa
X = pickle.load(open(E.S + "/live_refs.pkl", "rb"))
def Lc(n):
    s = ""
    while n: n, r = divmod(n - 1, 26); s = chr(65 + r) + s
    return s
ST = wb.Worksheets("Attr Setup"); HD = wb.Worksheets("Attr Holdings")
NM = X["NM"]; r0 = X["r0"]; MC0 = X["MC0"]
W0 = 11; S0 = W0 + NM + 1; K0 = S0 + NM + 1; ZC = 11 + 3 * (NM + 1) + 4
e0 = 8; el = int(re.findall(r"\$(\d+)$", X["HFUND"])[0])
SECS = E.GICS + ["Unclassified"]
# ---- peer composite sector return per month (Attr Setup)
p0 = ST.UsedRange.Row + ST.UsedRange.Rows.Count + 3
ST.Range(f"C{p0-1}").Value = "Peer composite monthly return by sector (sum of peer contributions / sum of peer start weights)"
ST.Range(f"C{p0-1}").Font.Bold = True
put(ST, f"C{p0}", [["Sector"]]); fmt_from(BAR, ST.Range(f"C{p0}:{Lc(MC0+NM-1)}{p0}"))
for j in range(NM):
    ST.Range(f"{Lc(MC0+j)}{p0}").Formula = f"={Lc(MC0+j)}{r0}"
ST.Range(f"D{p0}:{Lc(MC0+NM-1)}{p0}").NumberFormat = "mmm-yy"
HF, HS = X["HFUND"], X["HSEC"]
for i, s in enumerate(SECS):
    rr = p0 + 1 + i
    ST.Range(f"C{rr}").Value = s
    for j in range(NM):
        kc, sc = Lc(K0 + j), Lc(S0 + j)
        K = f"'Attr Holdings'!${kc}${e0}:${kc}${el}"; W = f"'Attr Holdings'!${sc}${e0}:${sc}${el}"
        ST.Range(f"{Lc(MC0+j)}{rr}").Formula = f'=IFERROR(SUMIFS({K},{HF},"<>AZTD",{HS},$C{rr})/SUMIFS({W},{HF},"<>AZTD",{HS},$C{rr}),0)'
ST.Range(f"D{p0+1}:{Lc(MC0+NM-1)}{p0+len(SECS)}").NumberFormat = "0.0%"
PSEC = f"'Attr Setup'!$D${p0+1}:${Lc(MC0+NM-1)}${p0+len(SECS)}"
PLIST = f"'Attr Setup'!$C${p0+1}:$C${p0+len(SECS)}"
YFL = f"'Attr Setup'!$D${r0+3}:${Lc(MC0+NM-1)}${r0+3}"
# ---- per AZTD holding: return while held vs peer sector over the same months
RET = f"'Attr Returns'!${Lc(10+NM+1)}$8:${Lc(10+NM+1+NM-1)}${8+len(E.META)-1}"
H0 = ZC + 4
heads = ["Months held (period)", "Stock return while held (period)", "Peer sector return same months (period)", "Beat peers' sector (period)",
         "Months held (YTD)", "Stock return while held (YTD)", "Peer sector return same months (YTD)", "Beat peers' sector (YTD)"]
put(HD, f"{Lc(H0)}7", [heads]); fmt_from(BAR, HD.Range(f"{Lc(H0)}7:{Lc(H0+7)}7")); HD.Range(f"{Lc(H0)}7:{Lc(H0+7)}7").WrapText = True
SW = f"{Lc(S0)}{e0}:{Lc(S0+NM-1)}{e0}"
r_ = f"IFERROR(--INDEX({RET},$H{e0},0),0)"
ps = f"IFERROR(--INDEX({PSEC},MATCH($F{e0},{PLIST},0),0),0)"
hp = f"({SW}>0)"; hy = f"({SW}>0)*({YFL}=1)"
fx = {
    0: f'=IF($C{e0}="AZTD",SUM(--{hp}),"")',
    1: f'=IF(AND($C{e0}="AZTD",{Lc(H0)}{e0}>0),PRODUCT(IF({hp},1+{r_},1))-1,"")',
    2: f'=IF(AND($C{e0}="AZTD",{Lc(H0)}{e0}>0),PRODUCT(IF({hp},1+{ps},1))-1,"")',
    3: f'=IF(ISNUMBER({Lc(H0+1)}{e0}),--({Lc(H0+1)}{e0}>{Lc(H0+2)}{e0}),"")',
    4: f'=IF($C{e0}="AZTD",SUM(--{hy}),"")',
    5: f'=IF(AND($C{e0}="AZTD",{Lc(H0+4)}{e0}>0),PRODUCT(IF({hy},1+{r_},1))-1,"")',
    6: f'=IF(AND($C{e0}="AZTD",{Lc(H0+4)}{e0}>0),PRODUCT(IF({hy},1+{ps},1))-1,"")',
    7: f'=IF(ISNUMBER({Lc(H0+5)}{e0}),--({Lc(H0+5)}{e0}>{Lc(H0+6)}{e0}),"")',
}
# only AZTD rows (they are at the top of the sheet)
azn = sum(1 for x in HD.Range(f"C{e0}:C{el}").Value if x[0] == "AZTD")
last = e0 + azn - 1
for k, f in fx.items():
    R(lambda: setattr(HD.Range(f"{Lc(H0+k)}{e0}:{Lc(H0+k)}{last}"), "Formula2", f))
HD.Range(f"{Lc(H0+1)}{e0}:{Lc(H0+2)}{last}").NumberFormat = "0.0%"; HD.Range(f"{Lc(H0+5)}{e0}:{Lc(H0+6)}{last}").NumberFormat = "0.0%"
HR = {k: f"'Attr Holdings'!${Lc(H0+k)}${e0}:${Lc(H0+k)}${last}" for k in range(8)}
HR["FUND"] = f"'Attr Holdings'!$C${e0}:$C${last}"; HR["SEC"] = f"'Attr Holdings'!$F${e0}:$F${last}"
HR["NAME"] = f"'Attr Holdings'!$E${e0}:$E${last}"
HR["CP"] = f"'Attr Holdings'!${Lc(Z0:=11+3*(NM+1))}${e0}:${Lc(Z0)}${last}".replace("Z0:=", "") if False else None
Z0 = 11 + 3 * (NM + 1)
HR["WP"] = f"'Attr Holdings'!${Lc(Z0)}${e0}:${Lc(Z0)}${last}"; HR["CP"] = f"'Attr Holdings'!${Lc(Z0+1)}${e0}:${Lc(Z0+1)}${last}"
HR["WY"] = f"'Attr Holdings'!${Lc(Z0+2)}${e0}:${Lc(Z0+2)}${last}"; HR["CY"] = f"'Attr Holdings'!${Lc(Z0+3)}${e0}:${Lc(Z0+3)}${last}"
pickle.dump(HR, open(E.S + "/hit_refs.pkl", "wb"))
app.Calculation = -4105; app.ScreenUpdating = True
print("hit-rate helpers written", azn, p0)
