def table(sl,x,y,w,hdr,rows,col_w=None,row_h=16,font=8,bold_last=False,first_left=True,hdr_fill=NAVY):
    nr=len(rows)+1; nc=len(hdr)
    gf=sl.shapes.add_table(nr,nc,Emu(int(x*12700)),Emu(int(y*12700)),Emu(int(w*12700)),Emu(int(row_h*nr*12700)))
    tb=gf.table
    tblPr=tb._tbl.tblPr
    for a in ("bandRow","firstRow"): tblPr.set(a,"0")
    sid=tblPr.find(qn("a:tableStyleId"))
    if sid is not None: sid.text="{5940675A-B579-460E-94D1-54222C63F5DA}"   # No Style, Table Grid
    if col_w:
        tot=sum(col_w)
        for i,cw in enumerate(col_w): tb.columns[i].width=Emu(int(w*12700*cw/tot))
    for r in range(nr): tb.rows[r].height=Emu(int(row_h*12700))
    def cell(r,c,text,bold=False,color=BLACK,fill=None,align=PP_ALIGN.CENTER):
        ce=tb.cell(r,c); ce.margin_left=ce.margin_right=Emu(36000); ce.margin_top=ce.margin_bottom=Emu(12000)
        ce.vertical_anchor=MSO_ANCHOR.MIDDLE
        tf=ce.text_frame; tf.word_wrap=True; txt(tf,str(text),font,bold,color,align=align)
        if fill is None: ce.fill.background()
        else: ce.fill.solid(); ce.fill.fore_color.rgb=fill
        # borders: thin bottom light grey
        tcPr=ce._tc.get_or_add_tcPr()
        for tag in ("a:lnL","a:lnR","a:lnT","a:lnB"):
            ln=etree.SubElement(tcPr,qn(tag)); ln.set("w","6350" if tag=="a:lnB" else "0")
            if tag=="a:lnB":
                sf=etree.SubElement(ln,qn("a:solidFill")); clr=etree.SubElement(sf,qn("a:srgbClr")); clr.set("val","D9D9D9")
            else: etree.SubElement(ln,qn("a:noFill"))
        fills=[ch_ for ch_ in tcPr if ch_.tag in (qn("a:solidFill"),qn("a:noFill"))]
        for f_ in fills: tcPr.remove(f_); tcPr.append(f_)
    for c_,h in enumerate(hdr): cell(0,c_,h,True,WHITE,hdr_fill,PP_ALIGN.LEFT if (c_==0 and first_left) else PP_ALIGN.CENTER)
    for r_,row in enumerate(rows,1):
        last=(bold_last and r_==nr-1)
        for c_,v in enumerate(row):
            cell(r_,c_,v,bold=last or (r_==1 and False),fill=RGBColor(0xEE,0xF2,0xFA) if last else None,align=PP_ALIGN.LEFT if (c_==0 and first_left) else PP_ALIGN.CENTER)
    return tb

