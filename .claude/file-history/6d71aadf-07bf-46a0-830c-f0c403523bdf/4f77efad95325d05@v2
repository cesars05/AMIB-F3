def style_chart(ch,legend=True,size=8):
    ch.font.size=Pt(size); ch.font.name="Arial"
    ch.has_legend=legend
    if legend:
        ch.legend.position=XL_LEGEND_POSITION.BOTTOM; ch.legend.include_in_layout=False; ch.legend.font.size=Pt(size)
def axis_clean(ch,cat_low=True,val_fmt=None,grid=False,val_visible=True):
    ca=ch.category_axis; va=ch.value_axis
    ca.tick_labels.font.size=Pt(8); va.tick_labels.font.size=Pt(8)
    ca.format.line.color.rgb=BLACK; ca.has_major_gridlines=False
    va.has_major_gridlines=grid; va.format.line.fill.background() if not val_visible else None
    if grid: va.major_gridlines.format.line.color.rgb=RGBColor(0xD9,0xD9,0xD9)
    if cat_low: ca.tick_label_position=XL_TICK_LABEL_POSITION.LOW
    if val_fmt: va.tick_labels.number_format=val_fmt; va.tick_labels.number_format_is_linked=False
