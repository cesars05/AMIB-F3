def txt(tf,text,size=10,bold=False,color=BLACK,italic=False,align=None):
    tf.clear(); p=tf.paragraphs[0]; r=p.add_run(); r.text=text; f=r.font; f.size=Pt(size); f.bold=bold; f.italic=italic; f.color.rgb=color; f.name="Arial"
    if align: p.alignment=align
    return p
def tbox(sl,x,y,w,h,text="",size=9,bold=False,color=BLACK,italic=False,align=None,anchor=MSO_ANCHOR.TOP,wrap=True):
    sh=sl.shapes.add_textbox(Emu(int(x*12700)),Emu(int(y*12700)),Emu(int(w*12700)),Emu(int(h*12700)))
    tf=sh.text_frame; tf.word_wrap=wrap; tf.margin_left=tf.margin_right=Emu(0); tf.margin_top=tf.margin_bottom=Emu(0); tf.vertical_anchor=anchor
    txt(tf,text,size,bold,color,italic,align); return sh
def rich(tf,parts,size=9,first=True,space_after=3,bullet=False):
    """parts: list of (text,bold) tuples -> one paragraph"""
    p=tf.paragraphs[0] if first else tf.add_paragraph()
    for t,b in parts:
        r=p.add_run(); r.text=t; r.font.size=Pt(size); r.font.bold=b; r.font.name="Arial"; r.font.color.rgb=BLACK
    p.space_after=Pt(space_after)
    if bullet:
        pPr=p._p.get_or_add_pPr(); pPr.set("marL","114300"); pPr.set("indent","-114300")
        bu=etree.SubElement(pPr,qn("a:buChar")); bu.set("char","•")
    return p
def line(sl,x,y,w,color=BLACK,wt=0.75):
