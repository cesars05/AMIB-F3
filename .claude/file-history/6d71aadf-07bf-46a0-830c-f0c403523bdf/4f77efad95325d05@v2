def pct(v,d=1,sign=False):
    if v is None or v=="" : return "n/a"
    f=f"{{:+.{d}f}}%" if sign else f"{{:.{d}f}}%"
    return f.format(v*100)
def pp(v,d=1): return f"{v*100:+.{d}f}pp"

