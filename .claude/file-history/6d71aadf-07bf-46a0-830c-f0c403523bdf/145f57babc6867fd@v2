import pywintypes
BUSY=(-2147418111,-2147417846,-2146777998)
def _retry(fn):
    for i in range(600):
        try: return fn()
        except pywintypes.com_error as e:
            code=e.args[0]; inner=e.args[2][5] if (len(e.args)>2 and e.args[2] and len(e.args[2])>5) else None
            if code in BUSY or inner in BUSY: time.sleep(1); continue
            raise
def _unwrap(v): return object.__getattribute__(v,"_o") if isinstance(v,P) else v
def _wrap(v):
    if hasattr(v,"_oleobj_"): return P(v)
    if callable(v): return lambda *a,**k: _wrap(_retry(lambda: v(*[_unwrap(x) for x in a],**{kk:_unwrap(vv) for kk,vv in k.items()})))
    return v
class P:
    def __init__(self,o): object.__setattr__(self,"_o",o)
    def __getattr__(self,n): return _wrap(_retry(lambda: getattr(object.__getattribute__(self,"_o"),n)))
    def __setattr__(self,n,v): _retry(lambda: setattr(object.__getattribute__(self,"_o"),n,_unwrap(v)))
    def __call__(self,*a,**k): return _wrap(_retry(lambda: object.__getattribute__(self,"_o")(*[_unwrap(x) for x in a],**{kk:_unwrap(vv) for kk,vv in k.items()})))
