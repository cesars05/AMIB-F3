def bar_chart(anchor, title, series, cats, h=330):
    ch = A.ChartObjects().Add(A.Range(anchor).Left, A.Range(anchor).Top, 540, h)
    c = ch.Chart; c.ChartType = 57
    for nm, rng, color in series:
        s = c.SeriesCollection().NewSeries(); s.Name = nm; s.Values = A.Range(rng); s.XValues = A.Range(cats)
        s.Format.Fill.ForeColor.RGB = color
    c.HasTitle = True; c.ChartTitle.Text = title; c.ChartTitle.Font.Size = 11; c.ChartTitle.Font.Bold = True
    c.HasLegend = True; c.Legend.Position = -4107
    c.Axes(2).TickLabels.NumberFormat = "0.0%"; c.Axes(1).ReversePlotOrder = True; c.Axes(1).TickLabelPosition = -4134
    return ch
