def contrib_block(r, title, groups, dim_rng, ckey, wkey, resid_key):
    ccol = X["HCP"] if ckey == "P" else X["HCY"]; wcol = X["HWP"] if wkey == "P" else X["HWY"]
    hdr(r, [title] + FUNDS + ["Peer avg", "AZTD vs peer", "Avg wt AZTD", "Avg wt peers"], "L")
    for i, g in enumerate(groups):
        rr = r + 1 + i
        row = [g] + [f'=SUMIFS({ccol},{X["HFUND"]},"{f}",{dim_rng},$C{rr})' for f in FUNDS]
        row += [f"=AVERAGE(E{rr}:H{rr})", f"=D{rr}-I{rr}", f'=SUMIFS({wcol},{X["HFUND"]},"AZTD",{dim_rng},$C{rr})',
                "=(" + "+".join(f'SUMIFS({wcol},{X["HFUND"]},"{p}",{dim_rng},$C{rr})' for p in PEERS) + f")/{len(PEERS)}"]
        put(A, f"C{rr}", [row])
        A.Range(f"C{rr}").Borders(9).LineStyle = 1
    t = r + 1 + len(groups)
    if groups[-1] in ("Unclassified", "Other"):
        u = t - 1
        cells = [f'=SUMIFS({ccol},{X["HFUND"]},"{f}")-SUM({c}{r+1}:{c}{u-1})' for f, c in zip(FUNDS, "DEFGH")]
        cells += [f"=AVERAGE(E{u}:H{u})", f"=D{u}-I{u}", f'=SUMIFS({wcol},{X["HFUND"]},"AZTD")-SUM(K{r+1}:K{u-1})',
                  "=(" + "+".join(f'SUMIFS({wcol},{X["HFUND"]},"{p}")' for p in PEERS) + f")/{len(PEERS)}-SUM(L{r+1}:L{u-1})"]
        put(A, f"D{u}", [cells])
    put(A, f"C{t}", [["Total holdings-based"] + [f"=SUM({c}{r+1}:{c}{t-1})" for c in "DEFGHIJKL"]])
    hk, ak = ("Holdings ann.", "Actual ann.") if resid_key == "P" else ("Holdings YTD-26", "Actual YTD-26")
    put(A, f"C{t+1}", [["Actual - holdings (trading, fees, cash)"] + [f"={st(ak, f)}-{st(hk, f)}" for f in FUNDS] +
                       [f"=AVERAGE(E{t+1}:H{t+1})", f"=D{t+1}-I{t+1}"]])
    put(A, f"C{t+2}", [["Fund return (actual)"] + [f"={c}{t}+{c}{t+1}" for c in "DEFGHIJ"]])
    A.Range(f"C{t}:L{t}").Font.Bold = True; A.Range(f"C{t}:L{t}").Borders(8).LineStyle = 1
    A.Range(f"C{t+1}:J{t+1}").Font.Italic = True
    A.Range(f"C{t+2}:J{t+2}").Font.Bold = True; A.Range(f"C{t+2}:J{t+2}").Borders(8).LineStyle = 1
    A.Range(f"D{r+1}:J{t+2}").NumberFormat = PP; A.Range(f"K{r+1}:L{t}").NumberFormat = PCT
    A.Range(f"D{r+1}:L{t+2}").HorizontalAlignment = -4108
    gap_cf(f"J{r+1}:J{t+2}")
    return t + 2

