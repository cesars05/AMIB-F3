# ---- 3. Brinson (period-level, formulas) ----
def brinson_block(r, title, blkP, blkY, groups):
    hdr(r, [title, "Allocation " + PLAB, "Selection " + PLAB, "Total " + PLAB, "Allocation YTD", "Selection YTD", "Total YTD"], "I")
    n = len(groups)
    for i, g in enumerate(groups):
        rr = r + 1 + i
        row = [g]
        for blk in (blkP, blkY):
            s = blk + 1 + i; t = blk + 1 + n
            wa, wp, ca, cp, RP = f"$K${s}", f"$L${s}", f"$D${s}", f"$I${s}", f"$I${t}"
            rps = f"IF({wp}<0.01,{RP},{cp}/{wp})"; ras = f"IFERROR({ca}/{wa},0)"
            alloc = f"=({wa}-{wp})*({rps}-{RP})"
            sel = f"={wa}*({ras}-{rps})"
            row += [alloc, sel, None]
        put(A, f"C{rr}", [[row[0], row[1], row[2], f"=D{rr}+E{rr}", row[4], row[5], f"=G{rr}+H{rr}"]])
        A.Range(f"C{rr}").Borders(9).LineStyle = 1
    rc = r + 1 + n
    tP, tY = blkP + 1 + n, blkY + 1 + n
    put(A, f"C{rc}", [["Cash & non-equity", f"=((1-$K${tP})-(1-$L${tP}))*(0-$I${tP})", None, f"=D{rc}",
                       f"=((1-$K${tY})-(1-$L${tY}))*(0-$I${tY})", None, f"=G{rc}"]])
    put(A, f"C{rc+1}", [["Actual - holdings (trading, fees, cash)", None, None, f"=$J${tP+1}", None, None, f"=$J${tY+1}"]])
    A.Range(f"C{rc+1}:I{rc+1}").Font.Italic = True
    put(A, f"C{rc+2}", [["Total gap vs peers (actual)"] + [f"=SUM({c}{r+1}:{c}{rc+1})" for c in "DEFGHI"]])
    A.Range(f"C{rc+2}:I{rc+2}").Font.Bold = True; A.Range(f"C{rc+2}:I{rc+2}").Borders(8).LineStyle = 1
    A.Range(f"D{r+1}:I{rc+2}").NumberFormat = PP; A.Range(f"D{r+1}:I{rc+2}").HorizontalAlignment = -4108
    gap_cf(f"F{r+1}:F{rc+1}"); gap_cf(f"I{r+1}:I{rc+1}")
    return rc + 2

