def hbar_from_attr(cell, title, name_col_rows, vals_list, colors):
    co, ch = add_chart(cell, 57)
    for (nm, vr), col in zip(vals_list, colors):
        s = ch.SeriesCollection().NewSeries(); s.Name = nm
        s.Values = wb.Worksheets("Attribution").Range(vr); s.XValues = wb.Worksheets("Attribution").Range(name_col_rows)
        s.Format.Fill.ForeColor.RGB = col
    style(ch, title, legend=len(vals_list) > 1, fmt="0.0%")
    ch.Axes(1).ReversePlotOrder = True; ch.Axes(1).TickLabelPosition = -4134
    ch.ChartGroups(1).GapWidth = 60
    return ch

