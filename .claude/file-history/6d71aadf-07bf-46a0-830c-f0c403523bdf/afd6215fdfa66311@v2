def section(r, text):
    c = CS.Range(f"B{r}"); c.Value = text; c.Font.Bold = True; c.Font.Size = 13; c.Font.Color = NAVY
    rg = CS.Range(f"B{r}:X{r}"); rg.Borders(9).LineStyle = 1; rg.Borders(9).Weight = -4138; rg.Borders(9).Color = GOLD
def style(c, title, legend=True, pct_axis=True, fmt="0%"):
    c.HasTitle = True; c.ChartTitle.Text = title.upper()
    c.ChartTitle.Font.Name = "Arial"; c.ChartTitle.Font.Size = 11; c.ChartTitle.Font.Bold = True; c.ChartTitle.Font.Color = NAVY
    c.ChartArea.Format.Line.Visible = False
    c.ChartArea.Font.Name = "Arial"; c.ChartArea.Font.Size = 9; c.ChartArea.Font.Color = 0
    for ax_t in (1, 2):
        try:
            ax = c.Axes(ax_t)
            ax.Format.Line.Visible = True; ax.Format.Line.ForeColor.RGB = 0; ax.Format.Line.Weight = 0.75
            ax.TickLabels.Font.Color = 0; ax.TickLabels.Font.Name = "Arial"; ax.TickLabels.Font.Size = 9
        except Exception:
            pass
    try:
        c.Axes(2).HasMajorGridlines = True
        c.Axes(2).MajorGridlines.Format.Line.ForeColor.RGB = 0xE6E6E6
        if pct_axis: c.Axes(2).TickLabels.NumberFormat = fmt
    except Exception:
        pass
    c.HasLegend = legend
    if legend:
        c.Legend.Position = -4107; c.Legend.Font.Name = "Arial"; c.Legend.Font.Size = 9
def add_chart(cell, ctype, w=W, h=H):
    rg = CS.Range(cell)
    co = CS.ChartObjects().Add(rg.Left, rg.Top, w, h); ch = co.Chart; ch.ChartType = ctype
    while ch.SeriesCollection().Count: ch.SeriesCollection(1).Delete()
    return co, ch
def series(ch, name, vals, cats=None, color=None, line=False):
    s = ch.SeriesCollection().NewSeries(); s.Name = name; s.Values = CS.Range(vals) if "!" not in vals else wb.Application.Range(vals)
    if cats: s.XValues = CS.Range(cats) if "!" not in cats else wb.Application.Range(cats)
    if color is not None:
        if line:
            s.Format.Line.ForeColor.RGB = color; s.Format.Line.Weight = 2.0 if name == "AZTD" else 1.5
        else:
            s.Format.Fill.ForeColor.RGB = color
    return s
def ext(rng):  # reference on another sheet
