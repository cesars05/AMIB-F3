def bubble_slide(ykey,ylabel,title,sub):
    sl=new_slide("1Chart",title,sub,"LSEG Workspace; Quant Model (31-Aug-26)",keep_idx=(24,))
    ph=[p for p in sl.placeholders if p.placeholder_format.idx==24][0]
    cd=BubbleChartData(); groups={}
    for r in rows: groups.setdefault(r["sector"],[]).append(r)
    order=[]
    for sct,lst in groups.items():
        s=cd.add_series(sct)
        for r in lst: s.add_data_point(r["ytd"],r[ykey],max(r["peerw"],0.0015)*100)
        order.append((sct,lst))
    s=cd.add_series("AZTD top-5 holdings")
    for r in top5: s.add_data_point(r["ytd"],r[ykey],0.9)
    order.append(("AZTD top-5 holdings",top5))
    gf=ph.insert_chart(XL_CHART_TYPE.BUBBLE,cd); ch=gf.chart; style_chart(ch)
    gf.height=Emu(int(372*12700)); tbox(sl,41,478,886,10,"Bubble size = peers' average weight (AZTD top-5 holdings not to scale). Names held by 3+ peers and not by AZTD, in Materials, Energy, Financials, Utilities and Cons. Discretionary.",7,False,MGREY,True)
    ch.plots[0].bubble_scale=55
    va=ch.value_axis; ca=ch.category_axis
    va.minimum_scale=0; va.maximum_scale=1.1; va.has_major_gridlines=True; va.major_gridlines.format.line.color.rgb=RGBColor(0xE6,0xE6,0xE6)
    va.tick_labels.number_format="0.0"; va.tick_labels.number_format_is_linked=False; va.tick_labels.font.size=Pt(8)
    ca.tick_labels.number_format="0%"; ca.tick_labels.number_format_is_linked=False; ca.tick_labels.font.size=Pt(8); ca.has_major_gridlines=False
    va.has_title=True; va.axis_title.text_frame.text=ylabel; va.axis_title.text_frame.paragraphs[0].runs[0].font.size=Pt(8)
    ca.has_title=True; ca.axis_title.text_frame.text="YTD total return (Jan-Sep 2026)"; ca.axis_title.text_frame.paragraphs[0].runs[0].font.size=Pt(8)
    ca.tick_label_position=XL_TICK_LABEL_POSITION.LOW
    for si,(sct,lst) in enumerate(order):
        ser=ch.plots[0].series[si]; col=NAVY if sct.startswith("AZTD") else SCOL[sct]
        ser.format.fill.solid(); ser.format.fill.fore_color.rgb=col
        sf=ser._element.find(qn("c:spPr")).find(qn("a:solidFill"))
        al=etree.SubElement(sf[0],qn("a:alpha")); al.set("val","90000" if sct.startswith("AZTD") else "55000")
        ser.format.line.color.rgb=col
        for pi,r in enumerate(lst):
            dl=ser.points[pi].data_label; tf=dl.text_frame; tf.text=clean_name(r["name"])
            f=tf.paragraphs[0].runs[0].font; f.size=Pt(6.5); f.name="Arial"; f.bold=sct.startswith("AZTD")
            dl.position=XL_LABEL_POSITION.RIGHT
    return sl
