from pptx.enum.chart import XL_MARKER_STYLE
GICS=["Communication Services","Consumer Discretionary","Consumer Staples","Energy","Financials","Health Care","Industrials","Information Technology","Materials","Real Estate","Utilities"]
def short(s): return {"Communication Services":"Comm. Services","Consumer Discretionary":"Cons. Discretionary","Consumer Staples":"Cons. Staples","Information Technology":"Info. Technology","Asia Pacific ex-Japan":"APAC ex-Japan"}.get(s,s)
def find(rows,name): return [r for r in rows if r[0]==name][0]
def num(v): return isinstance(v,(int,float))

def fix_invert(ser):
    ser.invert_if_negative=False
    for d in ser._element.findall(qn("c:dPt")):
        if d.find(qn("c:invertIfNegative")) is None:
            e=etree.Element(qn("c:invertIfNegative")); e.set("val","0")
            d.find(qn("c:idx")).addnext(e)
def pad_axis(ch,vals,lo_pad=0.30,hi_pad=0.22):
    v=[x for x in vals if num(x)]
    lo=min(v+[0]); hi=max(v+[0]); span=(hi-lo) or 1
    va=ch.value_axis
    va.minimum_scale=lo-lo_pad*span if lo<0 else 0
    va.maximum_scale=hi+hi_pad*span if hi>0 else 0
def table_style(tb): pass

def table(sl,x,y,w,hdr,rows,col_w=None,row_h=16,font=8,bold_last=False,first_left=True,hdr_fill=NAVY):
    nr=len(rows)+1; nc=len(hdr)
    gf=sl.shapes.add_table(nr,nc,Emu(int(x*12700)),Emu(int(y*12700)),Emu(int(w*12700)),Emu(int(row_h*nr*12700)))
    tb=gf.table; tblPr=tb._tbl.tblPr
    for a in ("bandRow","firstRow"): tblPr.set(a,"0")
    sid=tblPr.find(qn("a:tableStyleId"))
    if sid is not None: sid.text="{5940675A-B579-460E-94D1-54222C63F5DA}"
    if col_w:
        tot=sum(col_w)
        for i,cw in enumerate(col_w): tb.columns[i].width=Emu(int(w*12700*cw/tot))
    for r in range(nr): tb.rows[r].height=Emu(int(row_h*12700))
    def cell(r,c,text,bold=False,color=BLACK,fill=None,align=PP_ALIGN.CENTER):
        ce=tb.cell(r,c); ce.margin_left=ce.margin_right=Emu(36000); ce.margin_top=ce.margin_bottom=Emu(12000)
        ce.vertical_anchor=MSO_ANCHOR.MIDDLE
        tf=ce.text_frame; tf.word_wrap=True; txt(tf,str(text),font,bold,color,align=align)
        tcPr=ce._tc.get_or_add_tcPr()
        for ch_ in list(tcPr): tcPr.remove(ch_)
        for tag in ("a:lnL","a:lnR","a:lnT","a:lnB"):
            ln=etree.SubElement(tcPr,qn(tag)); ln.set("w","6350" if tag=="a:lnB" else "0")
            if tag=="a:lnB":
                sf=etree.SubElement(ln,qn("a:solidFill")); clr=etree.SubElement(sf,qn("a:srgbClr")); clr.set("val","D9D9D9")
            else: etree.SubElement(ln,qn("a:noFill"))
        if fill is None: etree.SubElement(tcPr,qn("a:noFill"))
        else:
            sf=etree.SubElement(tcPr,qn("a:solidFill")); clr=etree.SubElement(sf,qn("a:srgbClr")); clr.set("val",str(fill))
    for c_,h in enumerate(hdr): cell(0,c_,h,True,WHITE,hdr_fill,PP_ALIGN.LEFT if (c_==0 and first_left) else PP_ALIGN.CENTER)
    for r_,row in enumerate(rows,1):
        last=(bold_last and r_==nr-1)
        for c_,v in enumerate(row):
            cell(r_,c_,v,bold=last,fill=RGBColor(0xEE,0xF2,0xFA) if last else None,align=PP_ALIGN.LEFT if (c_==0 and first_left) else PP_ALIGN.CENTER)
    return tb

def insight_box(sl,x,y,w,h,title,sub,bullets,size=10):
    tbox(sl,x,y,w,14,title,10,True); line(sl,x,y+16,w)
    if sub: tbox(sl,x,y+19,w,12,sub,7.5,False,MGREY,True)
    sh=sl.shapes.add_textbox(Emu(int(x*12700)),Emu(int((y+38)*12700)),Emu(int(w*12700)),Emu(int(h*12700)))
    tf=sh.text_frame; tf.word_wrap=True; tf.margin_left=tf.margin_right=tf.margin_top=tf.margin_bottom=Emu(0)
    first=True
    for b in bullets: rich(tf,b,size,first,7,True); first=False
    return sh

# ---- computed totals
def brin_totals(key):
    rows=D[key]
    sec=[r for r in rows if r[0] in GICS or r[0]=="Unclassified"]; cash=[r for r in rows if str(r[0]).startswith("Cash")]
    alloc=sum(r[1] for r in sec if num(r[1]))+(cash[0][1] if cash and num(cash[0][1]) else 0)
    sel=sum(r[2] for r in sec if num(r[2]))
    act=[r for r in rows if str(r[0]).startswith("Actual")][0][3]
    return alloc,sel,act,alloc+sel+act
