def run(parent,text,size,bold=False,color=None,italic=False):
    r=etree.SubElement(parent,qn("a:r")); rp=etree.SubElement(r,qn("a:rPr")); rp.set("lang","en-US"); rp.set("sz",sz(size))
    if bold: rp.set("b","1")
    if italic: rp.set("i","1")
    rp.set("dirty","0")
    if color:
        sf=etree.SubElement(rp,qn("a:solidFill")); c=etree.SubElement(sf,qn("a:srgbClr")); c.set("val",color)
    lt=etree.SubElement(rp,qn("a:latin")); lt.set("typeface","Arial"); cs=etree.SubElement(rp,qn("a:cs")); cs.set("typeface","Arial")
    t=etree.SubElement(r,qn("a:t")); t.text=text
def para(tb,algn="just",bullet=False,lnspc=14.5,before=3,after=0):
    p=etree.SubElement(tb,qn("a:p")); pPr=etree.SubElement(p,qn("a:pPr")); pPr.set("algn",algn)
    if bullet: pPr.set("marL","228600"); pPr.set("indent","-228600")
    ls=etree.SubElement(pPr,qn("a:lnSpc")); sp=etree.SubElement(ls,qn("a:spcPts")); sp.set("val",str(int(lnspc*100)))
    sb=etree.SubElement(pPr,qn("a:spcBef")); sp=etree.SubElement(sb,qn("a:spcPts")); sp.set("val",str(int(before*100)))
    if after:
        sa=etree.SubElement(pPr,qn("a:spcAft")); sp=etree.SubElement(sa,qn("a:spcPts")); sp.set("val",str(int(after*100)))
    if bullet:
        bf=etree.SubElement(pPr,qn("a:buFont")); bf.set("typeface","Arial"); bc=etree.SubElement(pPr,qn("a:buChar")); bc.set("char","•")
    else:
        etree.SubElement(pPr,qn("a:buNone"))
    return p

