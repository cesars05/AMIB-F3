def fix_invert(ser):
    ser.invert_if_negative=False
    for d in ser._element.findall(qn("c:dPt")):
        if d.find(qn("c:invertIfNegative")) is None:
            e=etree.Element(qn("c:invertIfNegative")); e.set("val","0"); d.find(qn("c:idx")).addnext(e)
def pad_axis(ch,vals,lo_pad=0.30,hi_pad=0.22):
    v=[x for x in vals if num(x)]; lo=min(v+[0]); hi=max(v+[0]); span=(hi-lo) or 1
    va=ch.value_axis; va.minimum_scale=lo-lo_pad*span if lo<0 else 0; va.maximum_scale=hi+hi_pad*span if hi>0 else 0
