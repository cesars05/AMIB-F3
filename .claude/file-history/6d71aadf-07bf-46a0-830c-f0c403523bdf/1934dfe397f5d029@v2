def setcell(ce,text,font=8,bold=False,color=BLACK,fill=None,align=PP_ALIGN.CENTER,line_b="D9D9D9",italic=False):
    ce.margin_left=ce.margin_right=Emu(40000); ce.margin_top=ce.margin_bottom=Emu(10000); ce.vertical_anchor=MSO_ANCHOR.MIDDLE
    tf=ce.text_frame; tf.word_wrap=True; txt(tf,str(text),font,bold,color,italic,align=align)
    tcPr=ce._tc.get_or_add_tcPr()
    for ch_ in list(tcPr): tcPr.remove(ch_)
    for tag in ("a:lnL","a:lnR","a:lnT","a:lnB"):
        ln=etree.SubElement(tcPr,qn(tag))
        if tag=="a:lnB" and line_b:
            ln.set("w","6350"); sf=etree.SubElement(ln,qn("a:solidFill")); c=etree.SubElement(sf,qn("a:srgbClr")); c.set("val",line_b)
        else: ln.set("w","0"); etree.SubElement(ln,qn("a:noFill"))
    if fill is None: etree.SubElement(tcPr,qn("a:noFill"))
    else: sf=etree.SubElement(tcPr,qn("a:solidFill")); c=etree.SubElement(sf,qn("a:srgbClr")); c.set("val",str(fill))
def table(sl,x,y,w,hdr,rows,col_w=None,row_h=16,font=8,bold_last=False,first_left=True,hdr_fill=NAVY,hdr_font=None,row_colors=None,hdr_h=None):
    nr=len(rows)+1; nc=len(hdr)
    gf=sl.shapes.add_table(nr,nc,Emu(int(x*12700)),Emu(int(y*12700)),Emu(int(w*12700)),Emu(int(row_h*nr*12700)))
    tb=gf.table; tblPr=tb._tbl.tblPr
    for a in ("bandRow","firstRow"): tblPr.set(a,"0")
    sid=tblPr.find(qn("a:tableStyleId"))
    if sid is not None: sid.text="{5940675A-B579-460E-94D1-54222C63F5DA}"
    if col_w:
        tot=sum(col_w)
        for i,cw in enumerate(col_w): tb.columns[i].width=Emu(int(w*12700*cw/tot))
    for r in range(nr): tb.rows[r].height=Emu(int((hdr_h if (r==0 and hdr_h) else row_h)*12700))
    for c_,h in enumerate(hdr): setcell(tb.cell(0,c_),h,hdr_font or font,True,WHITE,hdr_fill,PP_ALIGN.LEFT if (c_==0 and first_left) else PP_ALIGN.CENTER,None)
    for r_,row in enumerate(rows,1):
        last=(bold_last and r_==nr-1)
        for c_,v in enumerate(row):
            col=BLACK
            if row_colors and row_colors[r_-1]: col=row_colors[r_-1]
            setcell(tb.cell(r_,c_),v,font,last,col,"EEF2FA" if last else None,PP_ALIGN.LEFT if (c_==0 and first_left) else PP_ALIGN.CENTER)
    return tb
def bullets(sl,x,y,w,h,items,size=9,space=5,color=BLACK):
    """items: list of lists of (text, style) with style in {0 normal, 1 bold, 2 bold navy}"""
    sh=sl.shapes.add_textbox(Emu(int(x*12700)),Emu(int(y*12700)),Emu(int(w*12700)),Emu(int(h*12700)))
    tf=sh.text_frame; tf.word_wrap=True; tf.margin_left=tf.margin_right=tf.margin_top=tf.margin_bottom=Emu(0)
    for k,it in enumerate(items):
        p=tf.paragraphs[0] if k==0 else tf.add_paragraph()
        for t,st in it:
            r=p.add_run(); r.text=t; f=r.font; f.size=Pt(size); f.name="Arial"; f.bold=st>0; f.color.rgb=NAVYB if st==2 else color
        p.space_after=Pt(space); p.alignment=PP_ALIGN.JUSTIFY
        pPr=p._p.get_or_add_pPr(); pPr.set("marL","128016"); pPr.set("indent","-128016")
        bu=etree.SubElement(pPr,qn("a:buFont")); bu.set("typeface","Arial")
        bc=etree.SubElement(pPr,qn("a:buChar")); bc.set("char","•")
    return sh
