def clean_name(n,k=24):
    n=str(n)
    n=re.sub(r"(,? Inc\.?$|,? Inc\.?,|,? Corp\.?$|,? Ltd\.?$| PLC$| Plc$| S\.A\.?$| SA$| AG$| ASA$| N\.V\.$| NV$| SpA$| S\.p\.A\.$| SE$| Oyj$| AB$| A/S$| Corporation$| Holdings?$| Limited$| Co\.?,? Ltd\.?$| Co\.?$| Group$| CORPORATION$| CO\., LTD\.$| LTD\.$| LP$)","",n).strip(" ,.")
    n=re.sub(r"(,? Inc\.?$| Corp\.?$| Ltd\.?$| Holdings?$| Group$| Co$)","",n).strip(" ,.")
    if n.isupper() and len(n)>4: n=n.title()
    return n if len(n)<=k else n[:k-1].rstrip()+"."
def pc(v,d=0,sign=False):
    if not num(v): return "-"
    return (f"{{:+.{d}f}}%" if sign else f"{{:.{d}f}}%").format(v*100)
def ppx(v,d=1): return f"{v*100:+.{d}f}pp" if num(v) else "-"
def sc2(v): return f"{v:.2f}" if num(v) else "-"
def chart_tidy(ch):
