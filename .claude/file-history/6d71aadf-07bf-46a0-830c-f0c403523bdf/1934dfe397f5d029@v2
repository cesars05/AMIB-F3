    ch=add_chart(sl,XL_CHART_TYPE.BAR_CLUSTERED,cd,x,y,w,h); style_chart(ch,legend=legend and len(series)>1); axis_clean(ch,val_fmt=fmt)
    ch.category_axis.reverse_order=True; ch.value_axis.visible=False; ch.category_axis.tick_labels.font.size=Pt(cat_size)
