    if t is not None: chart.remove(t)
    atd=chart.find(qn("c:autoTitleDeleted"))
    if atd is None: atd=etree.Element(qn("c:autoTitleDeleted")); chart.insert(0,atd)
    atd.set("val","1")
def hbar(sl,x,y,w,h,cats,series,colors,fmt,gap=45,legend=True,per_point=None,lbl=7,lo=0.30,hi=0.22,cat_size=8):
    cd=CategoryChartData(); cd.categories=cats
