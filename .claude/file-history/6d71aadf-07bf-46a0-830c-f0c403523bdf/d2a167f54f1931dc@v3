def fmt_from(src, dst):
    src.Copy(); dst.PasteSpecial(-4122)

def bar(ws, rng, text=None):
    fmt_from(BAR, ws.Range(rng))
    if text is not None:
        ws.Range(rng).Cells(1, 1).Value = text

def put(ws, addr, rows):
    n = len(rows); m = max(len(r) for r in rows)
    rows = [list(r) + [None] * (m - len(r)) for r in rows]
    ws.Range(addr).GetResize(n, m).Value2 = tuple(tuple(r) for r in rows)

def get_sheet(name, after):
    for s in wb.Worksheets:
        if s.Name == name:
            app.DisplayAlerts = False; s.Delete(); app.DisplayAlerts = True
            break
    wb.Activate()
    ws = wb.Worksheets.Add(After=wb.Worksheets(after))
    ws.Name = name
    ws.Activate()
    ws.Cells.Font.Name = "Arial"; ws.Cells.Font.Size = 11
    app.ActiveWindow.DisplayGridlines = False
    ws.Columns("A").ColumnWidth = 3
    return ws

