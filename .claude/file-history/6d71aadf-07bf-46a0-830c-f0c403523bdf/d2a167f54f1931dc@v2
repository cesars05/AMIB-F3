    A.Range(f"D{r}:L{r}").WrapText = True; A.Rows(r).RowHeight = 30; A.Range(f"D{r}:L{r}").HorizontalAlignment = -4108
    cc, wc = ("P", "wP") if key == "P" else ("Y", "wY")
    ccol, wcol = (rngCP, rngWP) if key == "P" else (rngCY, rngWY)
    for i, s in enumerate(SECS):
        rr = r + 1 + i
        row = [s]
        for f in FUNDS:
            row.append(f'=SUMIFS({ccol},{rngF},"{f}",{rngS},$C{rr})')
        row += [f"=AVERAGE(E{rr}:H{rr})", f"=D{rr}-I{rr}",
                f'=SUMIFS({wcol},{rngF},"AZTD",{rngS},$C{rr})',
                '=(' + "+".join(f'SUMIFS({wcol},{rngF},"{p}",{rngS},$C{rr})' for p in PEERS) + f")/{len(PEERS)}"]
        put(A, f"C{rr}", [row])
    tr = r + 1 + len(SECS)
    put(A, f"C{tr}", [["Total (holdings-based)"] + [f"=SUM({c}{r+1}:{c}{tr-1})" for c in "DEFGHIJKL"]])
    A.Range(f"C{tr}:L{tr}").Font.Bold = True; A.Range(f"C{tr}:L{tr}").Borders(8).LineStyle = 1
    A.Range(f"D{r+1}:J{tr}").NumberFormat = PP; A.Range(f"K{r+1}:L{tr}").NumberFormat = PCT
    A.Range(f"D{r+1}:L{tr}").HorizontalAlignment = -4108
    for i in range(len(SECS)):
        A.Range(f"C{r+1+i}").Borders(9).LineStyle = 1; A.Range(f"C{r+1+i}").Borders(9).Weight = 1
    A.Range(f"C{tr+1}").Value = note
    A.Range(f"C{tr+1}").Font.Italic = True; A.Range(f"C{tr+1}").Font.Size = 9; A.Range(f"C{tr+1}").Font.Color = 0x7F7F7F
