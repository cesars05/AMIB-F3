        if str(ws.Range(f"{col}{r}").Value or "").strip().startswith(t): return r
W, H, GAP = 520, 300, 14
def new_chart(ws, x, y, ctype):
    co = ws.ChartObjects().Add(x, y, W, H); c = co.Chart; c.ChartType = ctype
    while c.SeriesCollection().Count: c.SeriesCollection(1).Delete()
    co.Placement = 3
    return co, c
def house(c, title, n, bar=False, single_labels=None, cat_low=False, pct="0%"):
    c.HasTitle = True; c.ChartTitle.Text = title
    f = c.ChartTitle.Format.TextFrame2.TextRange.Font; f.Name = "Arial"; f.Size = 12; f.Bold = True; f.Fill.ForeColor.RGB = 0
    c.ChartArea.Format.Fill.ForeColor.RGB = 0xFFFFFF; c.ChartArea.Format.Line.Visible = True
    c.ChartArea.Format.Line.ForeColor.RGB = bgr("D9D9D9"); c.ChartArea.Format.Line.Weight = 0.75
    c.PlotArea.Format.Fill.Visible = False; c.PlotArea.Format.Line.Visible = False; c.ChartArea.Font.Name = "Arial"
    c.HasLegend = n > 1
    if n > 1: c.Legend.Position = -4160; c.Legend.Font.Size = 9
    for t in (1, 2):
        try:
            ax = c.Axes(t); ax.HasMajorGridlines = False; ax.MajorTickMark = -4142; ax.TickLabels.Font.Size = 9; ax.TickLabels.Font.Name = "Arial"
            if t == 1: ax.Format.Line.Visible = True; ax.Format.Line.ForeColor.RGB = 0; ax.Format.Line.Weight = 0.75
            else: ax.Format.Line.Visible = False; ax.TickLabels.NumberFormat = pct
        except Exception: pass
    if bar:
        g = c.ChartGroups(1)
        if n == 1:
            g.GapWidth = 50
            s = c.SeriesCollection(1); s.HasDataLabels = True; dl = s.DataLabels(); dl.Font.Size = 8; dl.Position = 2
            dl.NumberFormat = single_labels or "+0.0%;-0.0%;0.0%"
            s.InvertIfNegative = True; s.InvertColor = SAL
            c.Axes(2).TickLabelPosition = -4142
        else:
            g.GapWidth = 80; g.Overlap = -27
    if c.ChartType == 57:
        c.Axes(1).ReversePlotOrder = True; c.Axes(1).Crosses = 2
        if cat_low: c.Axes(1).TickLabelPosition = -4134
def add(c, name, vals, cats, color, line=False, ws=None):
    s = c.SeriesCollection().NewSeries(); s.Name = name; s.Values = vals; s.XValues = cats
    if line:
        s.Format.Line.ForeColor.RGB = color; s.Format.Line.Weight = 2.25 if name == "AZTD" else 1.5; s.MarkerStyle = -4142
    else:
        s.Format.Fill.Solid(); s.Format.Fill.ForeColor.RGB = color; s.Format.Line.Visible = False
    return s
def pad_scale(c, vals):
    v = [x for x in vals if isinstance(x, (int, float))]
    if not v: return
    lo, hi = min(v + [0]), max(v + [0]); sp = (hi - lo) or 0.01
    ax = c.Axes(2); ax.MinimumScale = lo - 0.30 * sp if lo < 0 else 0; ax.MaximumScale = hi + 0.18 * sp if hi > 0 else 0
def section(ws, r, text, fill, line):
    rg = ws.Range(f"B{r}:X{r}"); rg.Interior.Color = fill; rg.Font.Bold = True; rg.Font.Size = 11; rg.Font.Color = 0xFFFFFF
    ws.Range(f"B{r}").Value = text
def grid(ws, top_row):
