CO = [
 dict(ric="COCO.OQ", group="Functional & Branded Beverages", peers=["CELH.OQ", "MNST.OQ", "KDP.OQ", "PRMB.N"],
  opinion="Interesting company, adequate for a deep dive (check tariff-refund quality of margins)",
  desc="Vita Coco is the leading branded coconut water in the US, sold mainly through grocery, club and mass retailers, and it also makes private label coconut water for retailers plus smaller brands (Runa energy drinks, Ever & Ever water). It does not own factories: it buys from suppliers in coconut-growing countries such as the Philippines, Thailand, Sri Lanka and Brazil and ships the product to its markets. The catalyst has been volume growth in the core brand and a very fast private label ramp, including new and regained business.",
  ctx="The company reported record Q2 2026 net sales of $216 million (+28%), with Vita Coco Coconut Water volume up 15% and Private Label volume up 78%, and net income of $49 million versus $23 million a year ago. It raised full year guidance to $790 to 805 million in net sales and $154 to 161 million in adjusted EBITDA. Quality of margin is the open question: the 49% gross margin (36% a year ago) includes about $15.6 million of tariff refunds after the Supreme Court struck down the IEEPA tariffs, worth roughly 700 basis points, and management itself expects product cost pressure to weigh on margins for the rest of the year. Private label growth of 90 to 100% in the US is lower margin and concentrated in large retailers, some of which also buy the branded product. The main risk is a margin reset once refunds and low freight fade, and new tariffs the administration has said it intends to impose."),
 dict(ric="UNFI.N", group="Food Distribution", peers=["PFGC.N", "SYY.N", "CHEF.OQ"],
  opinion="Attractive but open questions (low margin, high customer concentration)",
  desc="United Natural Foods is the largest wholesale distributor of natural and organic food in the US and also supplies conventional supermarkets, with a network of distribution centers and a retail arm of its own supermarkets. Whole Foods Market is its largest customer. It earns a thin margin per dollar of sales, so profit depends on warehouse efficiency and mix. The catalyst has been a multi-year cost and network optimization plan that is lifting EBITDA and cash flow while the balance sheet is deleveraged.",
  ctx="The company closed fiscal 2026 with net sales down 2.0% to $31.2 billion but adjusted EBITDA up 27% to $701 million, adjusted EPS of $2.65 (above the top of guidance) and record free cash flow of $323 million. Q4 sales fell 0.7% to $7.6 billion with adjusted EBITDA of $172 million. Net leverage fell to 2.2x and net debt is below $1.6 billion for the first time since fiscal 2018. Fiscal 2027 guidance calls for sales of $31.2 to 31.8 billion (about +1% at the midpoint), adjusted EBITDA of $730 to 780 million and adjusted EPS of $3.00 to 3.50. Natural products outperformed the market, while the conventional side is the weaker part of the mix. The main risk is dependence on a few large customers and on execution: with net margins near 0.3% a lost contract or a service problem moves earnings a lot, and leverage is still meaningful."),
 dict(ric="SENEA.OQ", group="Packaged & Shelf-Stable Foods", peers=["CAG.N", "BGS.N", "CPB.OQ"],
  opinion="Interesting company, adequate for a deep dive (watch margin after Green Giant)",
  desc="Seneca Foods is one of the largest US processors of canned vegetables, plus fruit and frozen vegetables, sold under Seneca, Libby's and Green Giant (canned under license, and now frozen after an acquisition) and as private label to supermarkets and to food service. It owns its plants and buys crops from farms under contract, so results depend on crop yields and commodity costs. The catalyst has been the March 2026 purchase of the Green Giant US frozen business from B&G Foods, which more than doubled its frozen business.",
  ctx="Net sales for the quarter ended June 27, 2026 (Q1 fiscal 2027) were $405.2 million versus $297.5 million a year earlier (+36%), driven by the Green Giant frozen acquisition, steady private label growth and timing of co-pack business. Profitability moved the other way: gross margin fell to 11.8% from 14.1%, and part of this is accounting, since the inventory acquired was written up to fair value and that non-cash step-up reverses through the income statement in March and Q1. The acquisition also produced a bargain purchase gain, so reported earnings are noisy and need to be cleaned. The main risk is integration and margin, as management has to show the acquired frozen plant in Yuma, Arizona earns a normal return, plus the usual exposure to weather, crop yields, steel and labor costs in a low growth category."),
 dict(ric="DAR.N", group="Renewable Fuels & Ingredients", peers=["ADM.N", "BG.N", "INGR.N", "NESTE.HE"],
  opinion="Could be a cyclical pick or higher risk, keep on watchlist (earnings tied to RIN and fuel policy)",
  desc="Darling Ingredients turns animal by-products (fat, bones, feathers, used cooking oil) into feed protein, fats, collagen and other ingredients through a global rendering network, and owns 50% of Diamond Green Diesel (DGD), a joint venture with Valero that converts those fats into renewable diesel and sustainable aviation fuel. It therefore behaves like a food by-products company plus a fuel margin business. The catalyst has been a rebound in renewable diesel margins after US biofuel blending mandates were set higher through 2027.",
  ctx="The company reported Q2 2026 net income of $387 million ($2.41 per share) against $12.7 million a year ago, on net sales of $1.7 billion, with combined adjusted EBITDA of $741.7 million versus $249.5 million. DGD sold 348.8 million gallons at $2.23 per gallon of EBITDA and sent Darling about $280 million in cash distributions, which it used to cut net debt by $223 million and repurchase $73 million of stock. Feed EBITDA rose about 77%, helped by tight global supply of fish meal and protein. For Q3 it guided core ingredients adjusted EBITDA of $325 to 340 million, which excludes roughly $18 million of tariff recovery that helped Q2. Management says margins should stay favorable through 2027. The main risk is that most of the upside comes from policy (RIN prices, blending mandates, tax credits) and feedstock cost, so earnings could swing back quickly, as they did in 2025."),
 dict(ric="VIAV.OQ", group="Network Test & Measurement", peers=["KEYS.N", "NTCT.OQ", "CIEN.N"],
  opinion="Attractive but open questions (AI test cycle is strong, check how much is Spirent M&A)",
  desc="Viavi makes the instruments and software that test networks: lab and production test for high-speed Ethernet in data centers, field test for fiber and wireless technicians, and assurance software for telecom operators (Network and Service Enablement, NSE). A second smaller unit, Optical Security and Performance, sells coatings and optical filters used in anti-counterfeiting and sensing. About half of NSE revenue now comes from the data center ecosystem and about 17% from aerospace and defense. The catalyst is AI data center build-outs and the October 2025 purchase of Spirent's high-speed Ethernet and other test businesses.",
  ctx="The company reported fiscal Q4 2026 (June) net revenue of $443.1 million, up 52.5% and above the top of its $427 to 437 million guidance, with non-GAAP operating margin of 24.0%. NSE revenue was $353.9 million (+69%), helped by the Spirent lines, and the core data center business excluding Spirent more than doubled, led by production test. Full year revenue was about $1.5 billion (+40%). Q1 fiscal 2027 is guided at $450 to 460 million, and management now sees reaching $500 million of quarterly revenue sooner than planned, possibly during calendar 2027. The Spirent integration is described as complete and ahead of schedule. The main risk is that a large part of growth is from acquisition and from a hyperscaler capex cycle that can pause,, and that expectations are now high after such a run."),
 dict(ric="DGII.OQ", group="IoT Connectivity", peers=["LTRX.OQ", "INSG.OQ", "CLFD.OQ"],
  opinion="Interesting company, adequate for a deep dive (ARR growth partly acquired)",
  desc="Digi International sells the hardware and software that connect machines to the internet: cellular routers, embedded modules, console servers and development boards (IoT Products and Services), and a growing set of recurring subscription solutions for remote monitoring, network management and cold-chain sensors (IoT Solutions, including Ventus and SmartSense). Customers are industrial, medical, transportation, retail and government users. The catalyst has been a mix shift toward annual recurring revenue (ARR) and acquisitions such as Particle and Jolt.",
  ctx="The company reported fiscal Q3 2026 (June) revenue of $138.7 million (+29%), adjusted EBITDA of $40.4 million (+47%, 29.1% margin) and ARR of $191 million (+52%). Products and Services revenue grew 25% to $100 million with ARR of $60 million (+100%), while Solutions revenue grew 41% to $39 million with ARR of $131 million (+36%). It raised full year guidance to revenue of $529 to 533 million (+23 to 24%) and at least 27% ARR growth. Management says the Ventus and SmartSense solutions and higher attach of software to hardware drove the quarter. The main risk is that part of the growth comes from acquisitions (Particle, Jolt), so organic growth is lower than the headline, and that hardware demand depends on customer inventory cycles and on supply chain and tariff costs."),
 dict(ric="7826.T", group="Precious Metals Refining (Japan)", peers=["UMI.BR", "JMAT.L", "5706.T", "5713.T"],
  opinion="Interesting company, adequate for a deep dive (earnings quality tied to metal prices)",
  desc="Furuya Metal is a Japanese refiner and processor of platinum group metals, with a leading niche position in iridium and ruthenium. It makes sputtering targets and other materials used in semiconductors and hard disk drives, iridium products used in industrial and hydrogen applications, and recycles precious metals from customers' scrap. Customers are mostly electronics and materials manufacturers. The catalyst has been demand for ruthenium and iridium from semiconductor and data center storage, combined with sharply higher metal prices and a weak yen.",
  ctx="Second quarter (Oct-Dec 2025) sales of the fiscal year ending June 2026 were 43.9 billion yen (+63.7%) with operating profit of 7.4 billion yen (+26.9%), and the company describes record sales of 100.1 billion yen and ordinary income of 24.6 billion yen for the year, with ROE of 22.4%. The market price of iridium rose more than 70% between the start of 2026 and mid-April, from about 163 to 278 dollars per gram. Part of the sales growth is direct sales of precious metals from raw material inventory to keep customers supplied (about 9.4 billion yen in the first half), which is lower quality revenue than product sales. The main risk is that profits are highly sensitive to metal prices and yen, so a reversal in iridium and ruthenium prices or a normalization of inventory sales could cut earnings quickly."),
 dict(ric="VU.PA", group="Retail Technology / Electronic Shelf Labels", peers=["PRICb.ST", "ZBRA.OQ", "VYX.N"],
  opinion="Attractive but open questions (order intake and Walmart concentration)",
  desc="Vusion (formerly SES-imagotag) is the world leader in electronic shelf labels, the small e-paper price tags that replace paper labels in stores and update prices from a central system. It sells the labels and the wireless infrastructure, and increasingly sells software services on top (VAS): cloud, computer vision, guided in-store tasks and retail media. Customers are large grocery and general merchandise chains, with Walmart the biggest by far. The catalyst has been the rollout of its EdgeSense solution across Walmart's stores in the US.",
  ctx="The company reported H1 2026 adjusted revenue of 839 million euros (+29% organic), adjusted EBITDA of 160 million euros (+48%, 19.1% margin) and adjusted EBIT of 96 million euros (+82%). It confirmed 2026 guidance of 15 to 20% adjusted revenue growth at constant rates, with value-added services growing about 40%, and it expects about 80 million dollars of tariff reimbursements for the year. Order intake is the weak point: H1 orders of 681 million euros fell 22%, and trailing twelve month orders of 1,511 million euros are down 15%, although Q2 orders were up 7% year over year and 16% versus Q1. Net cash fell 241 million euros as Walmart down payments reversed, with another 119 million euros expected in H2. It also announced an acquisition in retail media (90 banners, more than 1,600 brands). The main risk is dependence on Walmart's rollout schedule once EdgeSense is complete at year end, and whether services growth fills the gap."),
 dict(ric="AEIS.OQ", group="Power Conversion for Semis & Data Center", peers=["VICR.OQ", "MKSI.OQ", "2308.TW"],
  opinion="Interesting company, adequate for a deep dive (cycle exposure; large for a SMID screen)",
  desc="Advanced Energy designs precision power conversion systems that are built into other companies' machines. The largest markets are semiconductor equipment (power for etch and deposition tools), data center computing (power supplies for AI servers), industrial and medical equipment, and telecom and networking. Customers are equipment makers and server manufacturers, which makes the business tied to their capex cycles. The catalyst has been AI data center power demand, on top of a semiconductor equipment upcycle.",
  ctx="The company reported Q2 2026 revenue of $574 million (+30%, above the top of guidance), with record semiconductor revenue up 33% and data center computing revenue of $192 million (+35% year over year but down 1% from Q1, as customers worked through downstream supply chain constraints). Non-GAAP EPS was $2.74 and operating cash flow a record $86 million. It raised its 2026 revenue growth outlook to the low to mid 30% range and now expects data center revenue to grow at least 50% in 2026, after more than 100% in 2025. Q3 gross margin is guided at 41 to 41.5%, below Q2's 41.9%, because Q2 included one-time tariff refunds. The main risk is cyclicality: both large end markets (wafer fab equipment and AI servers) depend on customers' capex, and a pause in either would show up quickly in revenue."),
 dict(ric="6590.T", group="Semiconductor Wafer Processing Equipment", peers=["6146.T", "8035.T", "6323.T", "AMAT.OQ"],
  opinion="Interesting company, adequate for a deep dive (recent quarter missed consensus)",
  desc="Shibaura Mechatronics is a Japanese maker of equipment used in chip manufacturing (wet cleaning and etching tools for wafers and advanced packaging, and mounting equipment), flat panel display equipment, vacuum equipment, laser processing equipment and ticket vending machines. Customers are memory and logic chipmakers and packaging houses. The catalyst has been demand for advanced packaging and cleaning tools linked to AI and high bandwidth memory, with a high 17% operating margin.",
  ctx="For the fiscal year ended March 2026 the company reported net sales of 88.0 billion yen (+8.8%), operating income of 15.3 billion yen (17.3% margin, +8.0%) and net income of 11.2 billion yen (+8.2%). For the year to March 2027 it guides sales of 99.0 billion yen (+12.4%), operating income of 16.0 billion yen (+4.8%) and net income of 11.9 billion yen (+6.5%), meaning growth is expected to be faster in sales than in profit. The Q1 fiscal 2027 print (April to June 2026) was soft: sales of about 20.0 billion yen and operating income of 2.85 billion yen, with EPS of 29.5 yen versus a consensus near 37, although the company kept its full year forecast, which implies a heavily second-half weighted year. The main risk is lumpy equipment orders and delivery timing, with customer concentration and exposure to Asia (check the China share in the annual report) typical for a company of this size."),
 dict(ric="KLIC.OQ", group="Semiconductor Assembly & Packaging Equipment", peers=["BESI.AS", "0522.HK", "COHU.OQ"],
  opinion="Could be a cyclical pick or higher risk, keep on watchlist (verify China exposure vs EM limit)",
  desc="Kulicke and Soffa makes the machines that attach chips to their packages: wire bonders (the historical core), advanced packaging equipment such as thermocompression bonders (TCB) used to stack memory and connect AI chips, and a smaller electronics assembly business, plus parts and services. Customers are outsourced assembly and test companies and chipmakers, mostly in Asia. The catalyst is the upcycle in semiconductors and the growth of its Advanced Solutions unit.",
  ctx="The company reported fiscal Q3 2026 (June) revenue of $330.4 million, up 123% from a year ago and 36% from the prior quarter, with gross margin of 47.8% and non-GAAP EPS of $1.20. It guided Q4 revenue at about $375 million (+13.5% sequentially). Advanced Solutions, which includes fluxless TCB, set a record and management expects to beat the $100 million fiscal 2026 target and to reach $150 to 200 million in fiscal 2027. Memory was the laggard, at $34 million and only +8.8% sequentially. The main risk is that the surge is from a very low base in a highly cyclical business, and that revenue is concentrated in Asia, historically including a large share from China, which would need to be checked against the 30% emerging market limit of the screen."),
 dict(ric="YOU.N", group="Digital Identity & Verification", peers=["OKTA.OQ", "EFX.N", "TRU.N"],
  opinion="Attractive but open questions (strong cash flow, partnership liability payment in Q3)",
  desc="CLEAR sells a biometric identity membership. Consumers pay a yearly fee to skip identity checks at airports (CLEAR Plus, about 8 million paying members) and, through its enterprise platform CLEAR1, businesses in government, healthcare, workforce and consumer markets pay to verify people. It also offers TSA PreCheck enrollment and airport concierge services. The catalyst has been price increases, member growth and the build-out of the enterprise verification business.",
  ctx="The company reported Q2 2026 revenue of $277.8 million (+26.6%) and bookings of $295.9 million (+32.8%), with adjusted EBITDA margin of 36.4% and record quarterly free cash flow of $189 million. Total members grew 30% to 43.5 million and CLEAR Plus reached 8.3 million, after the standard price rose to $219 and eGates were deployed across more than 70% of its airport network. CLEAR1 signings and pipeline each rose more than 50% sequentially. Q3 revenue is guided at $284 to 287 million and bookings at $311 to 316 million; Q3 free cash flow will be negative because of a roughly $315 million payment of a partnership liability, but full year free cash flow guidance was raised to at least $480 million. The main risk is dependence on airports and on TSA and government relationships, and whether enterprise growth can offset a maturing consumer travel base after price increases."),
 dict(ric="MITK.OQ", group="Bank Fraud & Identity Software", peers=["ALKT.OQ", "QTWO.N", "TRU.N"],
  opinion="Interesting company, adequate for a deep dive (lumpy license revenue)",
  desc="Mitek sells software that lets banks and fintechs verify identity and detect fraud from a phone camera: mobile check deposit (its original business, licensed to most large US banks), identity document verification with selfie matching, and Check Fraud Defender, a consortium network that flags fraudulent checks. Revenue mixes software licenses, recognized up front, with recurring SaaS. The catalyst has been the rise in check and identity fraud and the migration of revenue to SaaS.",
  ctx="The company reported fiscal Q3 2026 (June) revenue of $54.0 million (+18%), SaaS revenue of $26.2 million (+36%), fraud and identity SaaS revenue of $24.8 million (+37%) and adjusted EBITDA margin near 38%. Check Fraud Defender annual contract value grew 73%, and a top five US bank finished its pilot and joined the network. Full year revenue guidance was raised to $195 to 200 million, fraud and identity revenue to $105 to 109 million and adjusted EBITDA margin to 32 to 34%. The Q4 guidance of $42 to 47 million, well below Q3, shows how lumpy revenue is because license sales are recognized when delivered. Management says mobile deposit growth offsets falling check verification volumes. The main risk is that a few large banks account for much of revenue and timing of their renewals can swing a quarter."),
 dict(ric="OOMA.N", group="Cloud Communications (UCaaS)", peers=["EGHT.OQ", "RNG.N", "ZM.OQ"],
  opinion="Attractive but open questions (small cap, growth now includes M&A)",
  desc="Ooma sells cloud phone service and related tools to small and medium businesses (Ooma Office, plus a business video and AI receptionist features) and to households (Ooma residential lines). Its fastest growing product is AirDial, a wireless replacement for the old copper phone lines (POTS) used for elevators, alarms and fire panels, sold through more than 40 resale partners. The catalyst has been the telecom carriers retiring copper lines, which forces customers to replace them.",
  ctx="The company reported fiscal Q2 2027 (July) revenue of $83.2 million (+25%), with subscription and services revenue of $75.6 million versus $61.1 million, business subscription and services revenue up 38% and AirDial revenue up 75%. Non-GAAP EPS was $0.35 (+58%) and adjusted EBITDA a record $12.4 million, 15% of revenue against 10% six quarters ago. It raised fiscal 2027 guidance to revenue of $332.0 to 333.5 million, non-GAAP EPS of $1.35 to 1.38 and adjusted EBITDA of $47.5 to 48.3 million, with business subscription revenue growing about 32%. It won a large hospital system customer. The main risk is that part of the growth comes from an acquisition and that the SMB phone market is competitive, with much larger players such as RingCentral and Zoom, so organic growth and margins need to hold."),
