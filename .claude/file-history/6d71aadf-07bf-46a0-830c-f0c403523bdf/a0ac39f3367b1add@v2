    fx = f'=IFERROR(TAKE(SORT(FILTER({tbl},{cond}),{sort_cols},{orders}),{n}),"")'
    R(lambda: setattr(MS.Range(f"C{r+1}"), "Formula2", fx))
    fmt_block(r, n)
    return r + n + 2
