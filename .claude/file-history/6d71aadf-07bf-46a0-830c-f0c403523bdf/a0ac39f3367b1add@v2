def fmt_block(r, n):
    MS.Range(f"F{r+1}:I{r+n}").NumberFormat = "0.00"; MS.Range(f"J{r+1}:J{r+n}").NumberFormat = "0"
    MS.Range(f"K{r+1}:K{r+n}").NumberFormat = "0.00%"; MS.Range(f"L{r+1}:M{r+n}").NumberFormat = "0.0%"
    MS.Range(f"D{r+1}:M{r+n}").HorizontalAlignment = -4108; MS.Range(f"D{r+1}:E{r+n}").Font.Size = 9
    for i in range(n):
        MS.Range(f"C{r+1+i}:M{r+1+i}").Borders(9).LineStyle = 1; MS.Range(f"C{r+1+i}:M{r+1+i}").Borders(9).Color = 0xD9D9D9
    for cc in ("F", "G", "I"):
        fc = MS.Range(f"{cc}{r+1}:{cc}{r+n}").FormatConditions; fc.Delete()
        c1 = fc.Add(1, 7, "=0.7"); c1.Font.Bold = True
        c2 = fc.Add(1, 8, "=0.4"); c2.Font.Color = 0x0000FF
    for cc in ("L", "M"):
        fc = MS.Range(f"{cc}{r+1}:{cc}{r+n}").FormatConditions; fc.Delete()
        c2 = fc.Add(1, 6, "=0"); c2.Font.Color = 0x0000FF
def block(r, title, cond, n, wcol=PW, sort_cols="{4,9}", orders="{-1,-1}", labs=LABS):
