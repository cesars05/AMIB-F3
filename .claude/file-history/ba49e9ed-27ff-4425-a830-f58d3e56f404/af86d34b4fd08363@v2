def new_slide(title, subtitle, source):
    s = prs.slides.add_slide(LAY_GEN)
    ph(s, 0).text = title
    if subtitle is not None: ph(s, 1).text = subtitle
    else: remove_shape(ph(s, 1))
    b = ph(s, 13)
    if b is not None: remove_shape(b)
    ph(s, 14).text = source
    return s


def divider(t1, t2):
    s = prs.slides.add_slide(LAY_TITLE)
    ph(s, 11).text = t1; ph(s, 12).text = t2
    return s


def strip_pictures(slide):
    for sh in list(slide.shapes):
        if sh.shape_type in (13,) or sh.has_table if hasattr(sh, 'has_table') else False:
            remove_shape(sh)


def by_name(slide, name):
    return [s for s in slide.shapes if s.name == name][0]


def body_ppr(level=0):
    """Paragraph props used in the Investment Call / takeaways placeholders."""
    if level == 0:
        return ppr_xml(marL=228600, indent=-228600, algn='just', bullet=BULLET, lnSpc=16, spcBef=6)
    if level == 1:
        return ppr_xml(marL=685800, indent=-228600, algn='just', bullet='o', lnSpc=14, spcBef=3)
    return ppr_xml(marL=228600, indent=-228600, algn='just', lnSpc=16, spcBef=6)  # header (no bullet)


def BP(rich, level=0, size=None):
    return make_para(rich, ppr=body_ppr(level), size=size)


def HP(text, size=None):
    return make_para([(text, dict(b=True))], ppr=body_ppr(2), size=size)


