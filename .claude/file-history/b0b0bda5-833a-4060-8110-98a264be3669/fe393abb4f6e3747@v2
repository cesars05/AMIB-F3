"""Build the archetype gallery (one slide per layout recipe) with ILLUSTRATIVE data.

    python gallery.py aztlan out/gallery_aztlan.pptx
    python gallery.py femsa  out/gallery_femsa.pptx

Use it as (1) a visual catalogue to pick layouts from and (2) a regression test for house.py:
render with render.ps1 and inspect every PNG after changing house.py.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from house import Deck  # noqa: E402

SYSTEM = sys.argv[1] if len(sys.argv) > 1 else "aztlan"
OUT = sys.argv[2] if len(sys.argv) > 2 else f"gallery_{SYSTEM}.pptx"
SRC = "Illustrative data - layout gallery"
TEMPLATE = sys.argv[3] if len(sys.argv) > 3 else None
LAYOUT = sys.argv[4] if len(sys.argv) > 4 else "General"
if SYSTEM == "brand":  # example client-brand swap (Halliburton red) on the Aztlan grid
