    SYSTEM = make_brand_system("aztlan", primary="#8B1318", primary_dark="#630E12", tint1="#B96A73",
                               tint2="#EAD2D2", accent="#CC0000", name="brand")

d = Deck(SYSTEM, template=TEMPLATE, layout=LAYOUT, footer_left="Equity Research · Illustrative" if (SYSTEM == "aztlan" and not TEMPLATE) else None)
S = d.S
C = S["content"]
X0, X1 = C["x0"], C["x1"]
W = X1 - X0

# 1 Cover -----------------------------------------------------------------
d.cover("Layout Gallery: Slide Archetypes", subtitle="House style · native shapes & charts",
        date="October 2026", team=["Analyst A", "Analyst B", "Analyst C"] if d.S["name"] == "femsa" else None)

