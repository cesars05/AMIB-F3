                         color=color, round_=0.5)

    def metric_oval(self, s, cx, y, text, w=0.75, h=0.28, size=9):
        return self.rect(s, cx - w / 2, y, w, h, fill="#FFFFFF", line=self.S["primary"], line_w=1.0, text=text,
                         size=size, bold=True, shape=MSO_SHAPE.OVAL, inset=0.01)

    def num_circle(self, s, x, y, n, d=0.36, fill=None, size=12):
