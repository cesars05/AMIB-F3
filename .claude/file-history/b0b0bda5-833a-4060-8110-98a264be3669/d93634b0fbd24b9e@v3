def rgb(h):
    return RGBColor.from_string(h.lstrip("#").upper())


def _lerp_hex(a, b, t):
    a, b = a.lstrip("#"), b.lstrip("#")
    ca = [int(a[i:i + 2], 16) for i in (0, 2, 4)]
    cb = [int(b[i:i + 2], 16) for i in (0, 2, 4)]
    return "#" + "".join(f"{round(x + (y - x) * t):02X}" for x, y in zip(ca, cb))


def _lum(h):
    h = h.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


_MARK = re.compile(r"(\*\*.+?\*\*|\^\^.+?\^\^|!!.+?!!|__.+?__)")


def _strip_style(shape):
    st = shape._element.find(qn("p:style"))
    if st is not None:
        shape._element.remove(st)


def _set_bullet(p, char, level, size_pt):
    pPr = p._p.get_or_add_pPr()
    for tag in ("a:buNone", "a:buChar", "a:buAutoNum", "a:buFont", "a:buSzPct"):
        for el in pPr.findall(qn(tag)):
            pPr.remove(el)
    mar = 0.17 + 0.2 * level
    pPr.set("marL", str(int(Inches(mar))))
    pPr.set("indent", str(-int(Inches(0.16))))
    bf = etree.SubElement(pPr, qn("a:buFont"))
    bf.set("typeface", "Arial")
    bc = etree.SubElement(pPr, qn("a:buChar"))
    bc.set("char", char)


def _no_bullet(p):
    pPr = p._p.get_or_add_pPr()
    if pPr.find(qn("a:buNone")) is None:
        etree.SubElement(pPr, qn("a:buNone"))


class Deck:
    """A deck in one style system. Methods draw components on a given slide."""

    def __init__(self, system="aztlan", template=None, layout="General", logo=None, footer_left=None,
                 page_numbers=True):
        self.S = SYSTEMS[system] if isinstance(system, str) else system
        self.template_layout = None
        if template:
            self.prs = Presentation(template)
            sld = self.prs.slides._sldIdLst
            for sid in list(sld):
                self.prs.part.drop_rel(sid.rId)
                sld.remove(sid)
            self.template_layout = self.find_layout(layout)
            self.cover_layout = self._find_cover_layout()
        else:
            self.prs = Presentation()
            self.prs.slide_width, self.prs.slide_height = Inches(13.333), Inches(7.5)
            self.cover_layout = None
        self.blank = self._blank_layout()
        self.logo = logo
        self.footer_left = footer_left
        self.page_numbers = page_numbers
        self.n = 0

    # ---------------------------------------------------------------- layouts (template mode)
    @staticmethod
    def _title_top(layout):
        for ph in layout.placeholders:
            t = str(ph.placeholder_format.type)
            if "TITLE" in t and "SUB" not in t and "CENTER" not in t and ph.top is not None:
                return ph.top / 914400
        return None

    def find_layout(self, spec):
        """Layout by index, or by name. Duplicate names (two 'Section Header' in M&A FEMSA) resolve to
        the one whose title sits in the content-slide title zone (top < 1.0 in)."""
        lays = list(self.prs.slide_layouts)
        if isinstance(spec, int):
            return lays[spec]
        cands = [l for l in lays if l.name == spec]
        if not cands:
            return None
        top_ok = [l for l in cands if (self._title_top(l) or 9) < 1.0]
        return (top_ok or cands)[0]

    def _find_cover_layout(self):
        for l in self.prs.slide_layouts:
            if l.name.lower().startswith("title"):
                return l
        return None

    # ---------------------------------------------------------------- slides
    def _blank_layout(self):
        for l in self.prs.slide_layouts:
            if l.name.lower() in ("blank", "en blanco", "default", "closing slide"):
                return l
        return self.prs.slide_layouts[len(self.prs.slide_layouts) - 1 if len(self.prs.slide_layouts) < 7 else 6]

    def _new(self, layout=None):
        s = self.prs.slides.add_slide(layout or self.blank)
        self.n += 1
        return s

    def content_slide(self, title, subtitle=None, source=None, layout=None):
        """Standard frame: title, so-what subtitle, rule, logo, source, page number."""
        S = self.S
        est = len(title) * S["title"]["size"] * (0.54 if S["title"]["bold"] else 0.47) / 72
        if est > S["title"]["w"]:
            print(f"WARNING slide {self.n + 1}: title ~{est:.1f}in wide > {S['title']['w']}in -> will wrap; shorten it: {title!r}")
        lay = (self.find_layout(layout) if layout is not None else self.template_layout) if self.template_layout else None
        if lay is not None:  # template mode: fill the real placeholders, draw whatever has no placeholder
            s = self._new(lay)
            sub_done = src_done = False
            for ph in list(s.placeholders):
                t = str(ph.placeholder_format.type)
                top = (ph.top or 0) / 914400
                if "TITLE" in t and "SUB" not in t:
                    ph.text_frame.text = title
                elif subtitle and not sub_done and ("SUBTITLE" in t or ("BODY" in t and 0.8 <= top <= 1.35)):
                    ph.text_frame.text = subtitle
                    sub_done = True
                elif source and not src_done and ("FOOTER" in t or "BODY" in t) and top > 6.5:
                    ph.text_frame.text = source
                    src_done = True
                else:
                    ph._element.getparent().remove(ph._element)
            if subtitle and not sub_done:
                U = S["subtitle"]
                self.text(s, U["x"], U["y"], U["w"], U["h"], subtitle, size=U["size"], italic=U["italic"],
                          color=U["color"], anchor="top", inset=0)
            if source and not src_done:
                self.source(s, source)
        else:
            s = self._new()
            T = S["title"]
            self.text(s, T["x"], T["y"], T["w"], T["h"], title, size=T["size"], bold=T["bold"],
                      color=T["color"], anchor="bottom", wrap=False, inset=0)
            if subtitle:
                U = S["subtitle"]
                self.text(s, U["x"], U["y"], U["w"], U["h"], subtitle, size=U["size"], italic=U["italic"],
                          color=U["color"], anchor="top", inset=0)
            if S["rule"]:
                R = S["rule"]
                self.line(s, R["x0"], R["y"], R["x1"], R["y"], color=R["color"], width=R["w"])
            if S["logo"] and self.logo:
                L = S["logo"]
                s.shapes.add_picture(self.logo, Inches(L["x"]), Inches(L["y"]), height=Inches(L["h"]))
            if source:
                self.source(s, source)
        if self.page_numbers:
            P = S["page"]
            self.text(s, P["x"], P["y"], P["w"], P["h"], str(self.n), size=P["size"], color=P["color"],
                      align="right", inset=0)
        if S.get("footer_left") and self.footer_left:
            F = S["footer_left"]
            self.text(s, F["x"], F["y"], F["w"], 0.45, self.footer_left, size=F["size"], color=F["color"], inset=0)
        return s

    def source(self, s, text):
        Sx = self.S["source"]
        self.text(s, Sx["x"], Sx["y"], Sx["w"], Sx["h"], text, size=Sx["size"], italic=Sx["italic"],
                  align=Sx["align"], color=Sx["color"], inset=0)

    def cover(self, title, subtitle=None, date=None, team=None, kicker=None, image=None, logo=None):
        """Cover: full brand field (or full-bleed image) + title 40 + subtitle/date 24 + team names (FEMSA)."""
        S = self.S
        if self.cover_layout is not None and not image:
            return self._template_cover(title, [subtitle, date], team)
        s = self._new()
        if image:
            s.shapes.add_picture(image, 0, 0, self.prs.slide_width, self.prs.slide_height)
        else:
            self.rect(s, 0, 0, 13.333, 7.5, fill=S["cover_bg"])
        fg = "#FFFFFF" if S["cover_bg"] != "#FFFFFF" or image else "#000000"
        if logo:
            s.shapes.add_picture(logo, Inches(0.62), Inches(0.7), height=Inches(0.8))
        y = 2.6
        if kicker:
            self.text(s, 0.62, y - 0.4, 9, 0.35, kicker.upper(), size=14, color=fg)
        self.text(s, 0.62, y, 9.5, 1.3, title, size=40, bold=(S["name"] == "femsa"), color=fg, anchor="bottom")
        if subtitle:
            self.text(s, 0.62, y + 1.35, 9.5, 0.5, subtitle, size=24, italic=(S["name"] == "femsa"), color=fg)
        if date:
            self.text(s, 0.62, y + 1.9, 9.5, 0.45, date, size=18 if subtitle else 24, color=fg)
        if team:
            self.text(s, 0.62, 5.6, 6, 1.4, "\n".join(team), size=11, italic=True, color=fg, anchor="bottom")
        return s

    def _template_cover(self, title, lines, team=None):
        """Use the template's own cover art (AZTD 'Title', FEMSA 'Title Slide Logo')."""
        s = self._new(self.cover_layout)
        texts = [t for t in [title] + list(lines) if t]
        bodies = sorted(s.placeholders, key=lambda ph: ph.top or 0)
        if bodies and len(texts) > len(bodies):  # e.g. subtitle + date into the template's 2nd box
            texts = texts[:len(bodies) - 1] + ["\n".join(texts[len(bodies) - 1:])]
        for ph, t in zip(bodies, texts):
            ph.text_frame.text = t
        for ph in bodies[len(texts):]:
            ph._element.getparent().remove(ph._element)
        if len(bodies) < len(texts):  # template without (enough) placeholders -> draw the rest
            bold = self.S["name"] == "femsa"
            y = 2.6
            for k, t in enumerate(texts[len(bodies):]):
                first = (k == 0 and not bodies)
                self.text(s, 0.62, y, 9.5, 1.0 if first else 0.5, t, size=40 if first else 24, bold=bold and first,
                          italic=(not first and bold), color="#FFFFFF", anchor="bottom" if first else "top")
                y += 1.05 if first else 0.55
        if team:
            self.text(s, 0.62, 5.6, 6, 1.4, "\n".join(team), size=11, italic=True, color="#FFFFFF", anchor="bottom")
        return s

    def closing(self, line=None):
        """Closing slide = cover art with logo (+ optional one line)."""
        if self.cover_layout is not None:
            return self._template_cover(line or "", [])
        s = self._new()
        self.rect(s, 0, 0, 13.333, 7.5, fill=self.S["cover_bg"] if self.S["cover_bg"] != "#FFFFFF" else self.S["primary"])
        if line:
            self.text(s, 0.9, 3.0, 11, 0.9, line, size=40, color="#FFFFFF", anchor="bottom")
        return s

    def divider(self, title, subtitle=None, number=None):
        S = self.S
        if self.cover_layout is not None:
            return self._template_cover(f"{number}  {title}" if number else title, [subtitle])
        s = self._new()
        self.rect(s, 0, 0, 13.333, 7.5, fill=S["cover_bg"] if S["cover_bg"] != "#FFFFFF" else S["primary"])
        t = f"{number}  {title}" if number else title
        self.text(s, 0.9, 3.0, 11, 0.9, t, size=40, color="#FFFFFF", anchor="bottom")
        if subtitle:
            self.text(s, 0.9, 3.95, 11, 0.5, subtitle, size=24, color="#FFFFFF")
        return s

    def agenda(self, items, title="Agenda", active=None, roman=True):
        """FEMSA roman pills + grey bars (measured: pill w0.622, bar x1.679 w10.99 h0.38, step 0.573)."""
        s = self.content_slide(title)
        S = self.S
        nums = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"]
        y = 1.55
        for i, it in enumerate(items):
            on = active is None or active == i
            self.rect(s, 0.731, y, 0.622, 0.38, fill=S["primary"] if on else S["grey3"], text=nums[i] if roman else str(i + 1),
                      size=14, bold=True, color="#FFFFFF", align="center", round_=0.12)
            self.rect(s, 1.679, y, 10.99, 0.38, fill=S["grey1"], text=it, size=14, italic=True,
                      color="#000000" if on else S["grey5"], align="left", inset=0.12)
            y += 0.573
        return s

    def save(self, path):
        for sl in self.prs.slides:
            for sh in sl.shapes:
                if getattr(sh, "has_chart", False) and sh.has_chart:
                    self._no_invert(sh.chart)
        self.prs.save(path)
        return path

    # ---------------------------------------------------------------- text & shapes
    def _fmt_runs(self, p, text, size, bold, italic, color):
        S = self.S
        for part in _MARK.split(text):
            if not part:
                continue
            r = p.add_run()
            b, c = bold, color
            if part.startswith("**") and part.endswith("**"):
                part, b = part[2:-2], True
            elif part.startswith("^^") and part.endswith("^^"):
                part, b, c = part[2:-2], True, S["primary"]
            elif part.startswith("!!") and part.endswith("!!"):
                part, b, c = part[2:-2], True, S["neg"]
            elif part.startswith("__") and part.endswith("__"):
                part, b, c = part[2:-2], True, S["accent"]
            r.text = part
            f = r.font
            f.name, f.size, f.bold, f.italic = S["font"], Pt(size), b, italic
            f.color.rgb = rgb(c)

    def fill_tf(self, tf, text, size=12, bold=False, italic=False, color="#000000", align="left",
                anchor="top", wrap=True, inset=0.06, spacing=None, line_spacing=None):
        """text: str or list[str]. Lines starting with '- ' / '  - ' become bullets (•, then –).
        Inline markup: **bold**, ^^bold primary^^, !!bold negative!!, __bold accent__."""
        lines = text if isinstance(text, list) else str(text).split("\n")
        tf.word_wrap = wrap
        tf.auto_size = None
        for side in ("left", "right"):
            setattr(tf, f"margin_{side}", Inches(inset))
        tf.margin_top = tf.margin_bottom = Inches(min(inset, 0.04))
        tf.vertical_anchor = {"top": MSO_ANCHOR.TOP, "middle": MSO_ANCHOR.MIDDLE, "bottom": MSO_ANCHOR.BOTTOM}[anchor]
        al = {"left": PP_ALIGN.LEFT, "center": PP_ALIGN.CENTER, "right": PP_ALIGN.RIGHT, "justify": PP_ALIGN.JUSTIFY}[align]
        for i, ln in enumerate(lines):
            p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
            p.alignment = al
            m = re.match(r"^(\s*)- (.*)$", ln)
            if m:
                lvl = len(m.group(1)) // 2
                self._fmt_runs(p, m.group(2), size - (1 if lvl else 0), bold, italic, color)
                _set_bullet(p, "•" if lvl == 0 else "–", lvl, size)
                p.space_before = Pt(spacing if spacing is not None else (4 if lvl == 0 else 2))
            else:
                self._fmt_runs(p, ln, size, bold, italic, color)
                if spacing is not None:
                    p.space_before = Pt(spacing)
                elif i > 0:
                    p.space_before = Pt(8)  # section labels ("Catalysts") breathe
            if line_spacing:
                p.line_spacing = line_spacing
        return tf

    def text(self, s, x, y, w, h, text, **kw):
        tb = s.shapes.add_textbox(Inches(x), Inches(y), Inches(w), Inches(h))
        self.fill_tf(tb.text_frame, text, **kw)
        return tb

    def rect(self, s, x, y, w, h, fill=None, line=None, line_w=0.75, dash=None, text=None, round_=None,
             shape=None, size=12, bold=False, italic=False, color="#000000", align="center", anchor="middle",
             inset=0.06, rotation=0, shadow=False, vert=None):
        st = shape or (MSO_SHAPE.ROUNDED_RECTANGLE if round_ else MSO_SHAPE.RECTANGLE)
        sh = s.shapes.add_shape(st, Inches(x), Inches(y), Inches(w), Inches(h))
        _strip_style(sh)
        if round_ is not None and st == MSO_SHAPE.ROUNDED_RECTANGLE:
            sh.adjustments[0] = round_
        if fill:
            sh.fill.solid()
            sh.fill.fore_color.rgb = rgb(fill)
        else:
            sh.fill.background()
        if line:
            sh.line.color.rgb = rgb(line)
            sh.line.width = Pt(line_w)
            if dash:
                sh.line.dash_style = {"dash": MSO_LINE_DASH_STYLE.DASH, "sysDash": MSO_LINE_DASH_STYLE.SQUARE_DOT,
                                      "dot": MSO_LINE_DASH_STYLE.ROUND_DOT, "lgDash": MSO_LINE_DASH_STYLE.LONG_DASH}[dash]
        else:
            sh.line.fill.background()
        if rotation:
            sh.rotation = rotation
        if shadow:
            self._soft_shadow(sh)
        if text is not None:
            self.fill_tf(sh.text_frame, text, size=size, bold=bold, italic=italic, color=color, align=align,
                         anchor=anchor, inset=inset)
            if vert:
                sh.text_frame._txBody.find(qn("a:bodyPr")).set("vert", vert)
        return sh

    def _soft_shadow(self, sh):
        spPr = sh._element.spPr
        eff = etree.SubElement(spPr, qn("a:effectLst"))
        sd = etree.SubElement(eff, qn("a:outerShdw"), blurRad="38100", dist="19050", dir="5400000", algn="t",
                              rotWithShape="0")
        c = etree.SubElement(sd, qn("a:srgbClr"), val="000000")
        etree.SubElement(c, qn("a:alpha"), val="25000")

    def line(self, s, x0, y0, x1, y1, color="#000000", width=1.0, dash=None, arrow=False):
        c = s.shapes.add_connector(MSO_CONNECTOR.STRAIGHT, Inches(x0), Inches(y0), Inches(x1), Inches(y1))
        _strip_style(c)
        c.line.color.rgb = rgb(color)
        c.line.width = Pt(width)
        if dash:
            c.line.dash_style = {"dash": MSO_LINE_DASH_STYLE.DASH, "sysDash": MSO_LINE_DASH_STYLE.SQUARE_DOT,
                                 "dot": MSO_LINE_DASH_STYLE.ROUND_DOT}[dash]
        if arrow:
            ln = c.line._get_or_add_ln()
            etree.SubElement(ln, qn("a:tailEnd"), type="triangle", w="med", len="med")
        return c

    # ---------------------------------------------------------------- components (shapes-components.md)
    def block_header(self, s, x, y, w, title, unit=None):
        """Aztlan chart header: 16 bold #404040 + 1pt black rule + 12 italic unit line. Returns y where the exhibit starts."""
        S = self.S
        if S["name"] in ("ib_navy", "ms_clean"):
            self.header_bar(s, x, y, w, title)
            if unit:
                self.text(s, x, y + 0.36, w, 0.24, unit, size=9, italic=True, color=S["grey7"], inset=0.02)
                return y + 0.62
            return y + 0.42
        self.text(s, x, y, w, 0.347, title, size=16 if S["name"] != "femsa" else 12, bold=True,
                  color=S["header_text"], anchor="bottom", inset=0)
        self.line(s, x, y + 0.389, x + w, y + 0.389, color="#000000" if S["name"] != "femsa" else S["grey5"], width=1.0)
        if unit:
            self.text(s, x, y + 0.431, w, 0.25, unit, size=12 if S["name"] != "femsa" else 10, italic=True, inset=0)
            return y + 0.722
        return y + 0.45

    def header_bar(self, s, x, y, w, text, fill=None, h=0.32, size=11):
        return self.rect(s, x, y, w, h, fill=fill or self.S["primary"], text=text, size=size, bold=True, color="#FFFFFF")

    def label_block(self, s, x, y, w, h, text, fill=None, size=11, color="#FFFFFF"):
        return self.rect(s, x, y, w, h, fill=fill or self.S["primary"], text=text, size=size, bold=True, color=color)

    def bullet_box(self, s, x, y, w, h, bullets, size=11, line=None, fill=None, title=None, dash=None):
        sh = self.rect(s, x, y, w, h, fill=fill, line=line or self.S["grey3"], line_w=0.75, dash=dash)
        body = ([f"**{title}**"] if title else []) + [b if b.lstrip().startswith("- ") else f"- {b}" for b in bullets]
        self.fill_tf(sh.text_frame, body, size=size, anchor="top", inset=0.08)
        return sh

    def card(self, s, x, y, w, h, title, bullets, size=11, fill=None, outline=True):
        S = self.S
        self.rect(s, x, y, w, h, fill=fill or S["grey1"], line=S["grey3"] if outline else None)
        self.text(s, x + 0.1, y + 0.1, w - 0.2, 0.35, title, size=12, bold=True, align="center", anchor="bottom")
        self.line(s, x + 0.15, y + 0.5, x + w - 0.15, y + 0.5, color=S["grey5"], width=0.75)
        self.text(s, x + 0.08, y + 0.58, w - 0.16, h - 0.65, [f"- {b}" for b in bullets], size=size)

    def kpi_tile(self, s, x, y, w, h, number, label, fill=None, num_color=None, label_color=None, num_size=32):
        S = self.S
        fill = fill or S["grey1"]
        dark = fill not in (S["grey1"], "#FFFFFF", S["tint2"], "#E8EAED")
        self.rect(s, x, y, w, h, fill=fill)
        nc = num_color or ("#FFFFFF" if dark else S["primary"])
        lc = label_color or ("#FFFFFF" if dark else S["primary"])
        self.text(s, x, y + h * 0.18, w, h * 0.45, number, size=num_size, bold=True, color=nc, align="center", anchor="bottom")
        self.text(s, x + 0.1, y + h * 0.63, w - 0.2, h * 0.32, label, size=12, color=lc, align="center", anchor="top")

    def banner(self, s, text, y=None, x=None, w=None, fill="#D9D2CA", size=12, h=0.42, color="#000000"):
        """BofA taupe takeaway banner (GS variant: fill='#D6E8F7', line navy)."""
        C = self.S["content"]
        x = C["x0"] if x is None else x
        w = (C["x1"] - C["x0"]) if w is None else w
        y = C["y0"] if y is None else y
