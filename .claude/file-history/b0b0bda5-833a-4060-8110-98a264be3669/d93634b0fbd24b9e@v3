                         color="#FFFFFF", shape=MSO_SHAPE.OVAL, inset=0)

    def arrow_tag(self, s, x, y, w, h, text, fill=None, size=11):
        """Barclays/Jazz horizontal tag (homePlate)."""
        sh = self.rect(s, x, y, w, h, fill=fill or self.S["primary"], text=text, size=size, bold=True,
                       color="#FFFFFF", shape=MSO_SHAPE.PENTAGON, align="left", inset=0.1)
        return sh

    def phase_pentagon(self, s, x, y, w, h, text, fill=None, size=11):
        """BofA down-pointing pentagon label. Built as a 'down arrow callout'-like pentagon via
        a rotated homePlate whose text is counter-rotated by vert='horz'."""
        fill = fill or self.S["primary_dark"]
        tip = min(0.35, h * 0.25)
        self.rect(s, x, y, w, h - tip, fill=fill)
        tri = s.shapes.add_shape(MSO_SHAPE.ISOSCELES_TRIANGLE, Inches(x), Inches(y + h - tip - 0.01), Inches(w), Inches(tip + 0.01))
        _strip_style(tri)
        tri.rotation = 180
        tri.fill.solid()
        tri.fill.fore_color.rgb = rgb(fill)
        tri.line.fill.background()
        self.text(s, x, y, w, h - tip, text, size=size, bold=True, color="#FFFFFF", align="center", anchor="middle")

    def chevron_row(self, s, x, y, w_total, labels, h=0.6, fills=None, size=14, first_pentagon=False, gap=-0.1):
        n = len(labels)
        w = (w_total - gap * (n - 1)) / n
        out = []
        for i, lab in enumerate(labels):
            st = MSO_SHAPE.PENTAGON if (i == 0 and first_pentagon) else MSO_SHAPE.CHEVRON
            f = fills[i] if fills else self.S["accent"] if self.S["name"] == "femsa" else self.S["primary"]
            out.append(self.rect(s, x + i * (w + gap), y, w, h, fill=f, text=lab, size=size, bold=True,
                                 color="#FFFFFF", shape=st, inset=0.25))
        return out, w

    def side_tab(self, s, x, y, w, h, text, fill=None, size=9):
        return self.rect(s, x, y, w, h, fill=fill or self.S["primary"], text=text, size=size, bold=True,
                         color="#FFFFFF", vert="vert270", inset=0.02)

    def callout(self, s, x, y, w, h, text, to=None, size=9, fill="#FFFFFF", line=None, pointer=False):
        S = self.S
        if pointer:
            sh = self.rect(s, x, y, w, h, fill="#FFF2B3", line="#404040", line_w=0.5, text=text, size=size,
                           shape=MSO_SHAPE.RECTANGULAR_CALLOUT)
            if to:  # aim the wedge
                sh.adjustments[0] = (to[0] - (x + w / 2)) / w
                sh.adjustments[1] = (to[1] - (y + h / 2)) / h
            return sh
        sh = self.rect(s, x, y, w, h, fill=fill, line=line or S["grey5"], line_w=0.5, text=text, size=size)
        if to:
            ax = min(max(to[0], x), x + w)
            ay = y + h if to[1] > y + h else (y if to[1] < y else y + h / 2)
            self.line(s, ax, ay, to[0], to[1], color=S["grey5"], width=0.75)
        return sh

    def operator(self, s, cx, cy, op="+", d=0.32):
        shp = {"+": MSO_SHAPE.MATH_PLUS, "-": MSO_SHAPE.MATH_MINUS, "=": MSO_SHAPE.MATH_EQUAL, "x": MSO_SHAPE.MATH_MULTIPLY}[op]
        self.rect(s, cx - d / 2, cy - d / 2, d, d, fill=self.S["grey5"], shape=MSO_SHAPE.OVAL)
        self.rect(s, cx - d * 0.35, cy - d * 0.35, d * 0.7, d * 0.7, fill="#FFFFFF", shape=shp)

    def legend_items(self, s, x, y, items, size=9, sq=0.16, step=0.24):
        for i, (label, color) in enumerate(items):
            self.rect(s, x, y + i * step + 0.03, sq, sq, fill=color)
            self.text(s, x + sq + 0.06, y + i * step - 0.02, 2.5, 0.24, label, size=size, italic=True, inset=0)

    def numbered_rows(self, s, rows, x=None, y=1.55, w=None, row_h=0.75, step=1.36, size=12):
        """Jazz/Netflix measured recipe: '#N' black rect -> navy right arrow label -> grey rounded box."""
        C = self.S["content"]
        x = C["x0"] if x is None else x
        w = (C["x1"] - C["x0"]) if w is None else w
        k = w / 9.083  # measured on a 9.083-in wide row (0.417 -> 9.5)
        for i, (label, body) in enumerate(rows):
            yy = y + i * step
            self.rect(s, x + 2.503 * k, yy, 6.58 * k, row_h, fill="#CCD1D7", text=body, size=size, align="left",
                      inset=0.1 + 0.6 * k, round_=0.25)
            self.rect(s, x, yy, 0.67 * k, row_h, fill="#000000", text=f"#{i + 1}", size=size, color="#FFFFFF")
            self.rect(s, x + 0.67 * k, yy, 2.42 * k, row_h, fill=self.S["primary"], text=label, size=size,
                      color="#FFFFFF", shape=MSO_SHAPE.RIGHT_ARROW, inset=0.1)

    # ---------------------------------------------------------------- tables
    def table(self, s, x, y, w, rows, col_w=None, row_h=0.30, size=10, header_rows=1, header_fill=None,
              zebra=False, bold_rows=(), band_rows=(), band_fill=None, highlight_cols=(), first_col_align="left",
              num_align="right", font_color="#000000", rule_color="#000000", highlight_fill=None, text_cols=(0,)):
        """House table: header fill primary + white bold; thin rules top/bottom/under header; numbers right."""
        S = self.S
        nr, nc = len(rows), len(rows[0])
        gf = s.shapes.add_table(nr, nc, Inches(x), Inches(y), Inches(w), Inches(row_h * nr))
        tbl = gf.table
        tblPr = tbl._tbl.tblPr
        for attr in ("firstRow", "bandRow"):
            tblPr.set(attr, "0")
        sid = tblPr.find(qn("a:tableStyleId"))
        if sid is None:
            sid = etree.SubElement(tblPr, qn("a:tableStyleId"))
        sid.text = "{2D5ABB26-0587-4C30-8999-92F81FD0307C}"  # No Style, No Grid
        col_w = col_w or [w / nc] * nc
        for j, cw in enumerate(col_w):
            tbl.columns[j].width = Inches(cw)
        for i in range(nr):
            tbl.rows[i].height = Inches(row_h)
            for j in range(nc):
                c = tbl.cell(i, j)
                c.margin_left = c.margin_right = Inches(0.05)
                c.margin_top = c.margin_bottom = Inches(0.01)
                c.vertical_anchor = MSO_ANCHOR.MIDDLE
                hdr = i < header_rows
                fill = None
                if hdr:
                    fill = header_fill or S["primary"]
                elif i in band_rows:
                    fill = band_fill or S["grey1"]
                elif j in highlight_cols:
                    fill = highlight_fill or S["tint2"]
                elif zebra and (i - header_rows) % 2 == 1:
                    fill = S["grey1"]
                if fill:
                    c.fill.solid()
                    c.fill.fore_color.rgb = rgb(fill)
                else:
                    c.fill.background()
                if j in text_cols:
                    al = first_col_align
                else:
                    al = "center" if hdr else num_align
                self.fill_tf(c.text_frame, str(rows[i][j]), size=size, bold=hdr or i in bold_rows,
                             color="#FFFFFF" if hdr else font_color, align=al, inset=0.04)
                self._cell_borders(c, top=(i == 0), bottom=(i == header_rows - 1 or i == nr - 1 or i in bold_rows),
                                   color=rule_color)
        return gf

    @staticmethod
    def _cell_borders(c, top=False, bottom=False, color="#000000", w_pt=0.75):
        tcPr = c._tc.get_or_add_tcPr()
        for tag, on in (("a:lnL", False), ("a:lnR", False), ("a:lnT", top), ("a:lnB", bottom)):
            for el in tcPr.findall(qn(tag)):
                tcPr.remove(el)
            ln = etree.Element(qn(tag), w=str(int(Pt(w_pt))) if on else "0")
            if on:
                sf = etree.SubElement(ln, qn("a:solidFill"))
                etree.SubElement(sf, qn("a:srgbClr"), val=color.lstrip("#"))
            else:
                etree.SubElement(ln, qn("a:noFill"))
            tcPr.insert(0, ln) if False else tcPr.append(ln)
        # schema order: lnL lnR lnT lnB ... fill  -> move fills after borders
        for f in [e for e in tcPr if etree.QName(e).localname in ("solidFill", "noFill")]:
            tcPr.remove(f)
            tcPr.append(f)

    def heatmap_table(self, s, x, y, w, row_labels, col_labels, values, fmt="{:.1f}", corner="", base=None,
                      lo="#F8696B", mid="#FFEB84", hi="#63BE7B", row_h=0.30, size=10, higher_is_better=True):
        """Sensitivity grid with red->yellow->green fills; base=(i,j) gets a dashed box."""
        flat = [v for r in values for v in r]
        vmin, vmax = min(flat), max(flat)
        rows = [[corner] + col_labels] + [[rl] + [fmt.format(v) for v in r] for rl, r in zip(row_labels, values)]
        gf = self.table(s, x, y, w, rows, row_h=row_h, size=size, num_align="center", first_col_align="center",
                        rule_color=self.S["grey5"])
        tbl = gf.table
        for i, r in enumerate(values):
            for j, v in enumerate(r):
                t = 0.5 if vmax == vmin else (v - vmin) / (vmax - vmin)
                if not higher_is_better:
                    t = 1 - t
                col = _lerp_hex(lo, mid, t * 2) if t < 0.5 else _lerp_hex(mid, hi, (t - 0.5) * 2)
                c = tbl.cell(i + 1, j + 1)
                c.fill.solid()
                c.fill.fore_color.rgb = rgb(col)
        if base:
            cw = w / (len(col_labels) + 1)
            self.dashed_box(s, x + cw * (base[1] + 1) + 0.02, y + row_h * (base[0] + 1) + 0.02, cw - 0.04, row_h - 0.04,
                            color="#000000", width=1.25)
        return gf

    # ---------------------------------------------------------------- charts: shared styling
    def _chart(self, s, kind, x, y, w, h, categories, series: dict, number_format=None):
        cd = CategoryChartData()
        cd.categories = categories
        for name, vals in series.items():
            cd.add_series(name, vals, number_format=number_format)
        gf = s.shapes.add_chart(kind, Inches(x), Inches(y), Inches(w), Inches(h), cd)
        ch = gf.chart
        ch.has_title = False
        ch.font.name = self.S["font"]
        ch.font.size = Pt(9)
        ch.font.color.rgb = rgb("#000000")
        cs = ch._chartSpace
        atd = cs.find(f"{{{C_NS}}}chart/{{{C_NS}}}autoTitleDeleted")
        if atd is not None:
            atd.set("val", "1")
        self._no_fill_chart(ch)
        return gf, ch

    @staticmethod
    def _no_fill_chart(ch):
        cs = ch._chartSpace
        for parent in (cs, cs.find(f"{{{C_NS}}}chart/{{{C_NS}}}plotArea")):
            spPr = parent.find(f"{{{C_NS}}}spPr")
            if spPr is None:
                spPr = etree.SubElement(parent, f"{{{C_NS}}}spPr")
                if parent is cs:  # spPr must precede txPr / externalData in chartSpace
                    for sib in ("txPr", "externalData", "printSettings", "userShapes"):
                        e = cs.find(f"{{{C_NS}}}{sib}")
                        if e is not None:
                            e.addprevious(spPr)
                            break
            for e in list(spPr):
                spPr.remove(e)
            etree.SubElement(spPr, f"{{{A_NS}}}noFill")
            ln = etree.SubElement(spPr, f"{{{A_NS}}}ln")
            etree.SubElement(ln, f"{{{A_NS}}}noFill")

    @staticmethod
    def _plot_layout(ch, fx, fy, fw, fh):
        """Manual INNER plot-area layout as fractions of the chart frame (makes overlays exact)."""
        pa = ch._chartSpace.find(f"{{{C_NS}}}chart/{{{C_NS}}}plotArea")
        lay = pa.find(f"{{{C_NS}}}layout")
        if lay is None:
            lay = etree.Element(f"{{{C_NS}}}layout")
            pa.insert(0, lay)
        for e in list(lay):
            lay.remove(e)
        ml = etree.SubElement(lay, f"{{{C_NS}}}manualLayout")
        for tag, val in (("layoutTarget", "inner"), ("xMode", "edge"), ("yMode", "edge"),
                         ("x", fx), ("y", fy), ("w", fw), ("h", fh)):
            etree.SubElement(ml, f"{{{C_NS}}}{tag}", val=str(val))

    def _axis_style(self, ch, show_values=False, cat_size=9, val_fmt=None, gridlines=False, vmin=None, vmax=None,
                    cat_line=True, label_low=False):
        S = self.S
        try:
            ca = ch.category_axis
            ca.has_major_gridlines = False
            ca.tick_labels.font.size = Pt(cat_size)
            ca.tick_labels.font.name = S["font"]
            ca.format.line.color.rgb = rgb("#7F7F7F" if cat_line else "#FFFFFF")
            ca.format.line.width = Pt(0.75)
            from pptx.enum.chart import XL_TICK_MARK
            ca.major_tick_mark = XL_TICK_MARK.NONE
            if label_low:
                ca.tick_label_position = XL_TICK_LABEL_POSITION.LOW
        except Exception:
            pass
        va = ch.value_axis
        va.has_major_gridlines = gridlines
        if gridlines:
            va.major_gridlines.format.line.color.rgb = rgb("#E6E6E6")
            va.major_gridlines.format.line.width = Pt(0.5)
        if vmin is not None:
            va.minimum_scale = vmin
        if vmax is not None:
            va.maximum_scale = vmax
        if val_fmt:
            va.tick_labels.number_format = val_fmt
            va.tick_labels.number_format_is_linked = False
        va.tick_labels.font.size = Pt(9)
        va.visible = show_values
        if show_values:
            va.format.line.fill.background()
            from pptx.enum.chart import XL_TICK_MARK
            va.major_tick_mark = XL_TICK_MARK.NONE

    def _legend(self, ch, show, pos="bottom", hide=()):
        ch.has_legend = show
        if show:
            ch.legend.position = {"bottom": XL_LEGEND_POSITION.BOTTOM, "top": XL_LEGEND_POSITION.TOP,
                                  "right": XL_LEGEND_POSITION.RIGHT}[pos]
            ch.legend.include_in_layout = False
            ch.legend.font.size = Pt(9)
            ch.legend.font.name = self.S["font"]
            leg = ch._chartSpace.find(f"{{{C_NS}}}chart/{{{C_NS}}}legend")
            for idx in hide:
                le = etree.Element(f"{{{C_NS}}}legendEntry")
                etree.SubElement(le, f"{{{C_NS}}}idx", val=str(idx))
                etree.SubElement(le, f"{{{C_NS}}}delete", val="1")
                leg.find(f"{{{C_NS}}}legendPos").addnext(le)

    @staticmethod
    def _fill(fmt, color):
        if color is None:
            fmt.fill.background()
        else:
            fmt.fill.solid()
            fmt.fill.fore_color.rgb = rgb(color)
        fmt.line.fill.background()

    def _labels(self, series, size=9, bold=False, color="#000000", pos=None, fmt=None):
        dl = series.data_labels
        dl.show_value = True
        dl.font.size = Pt(size)
        dl.font.bold = bold
        dl.font.name = self.S["font"]
        dl.font.color.rgb = rgb(color)
        if fmt:
            dl.number_format = fmt
            dl.number_format_is_linked = False
        if pos is not None:
            dl.position = pos
        return dl

    def _custom_label(self, point, text, size=9, bold=True, color="#000000", pos=None):
        dl = point.data_label
        tf = dl.text_frame
        tf.text = text
        r = tf.paragraphs[0].runs[0]
        r.font.size, r.font.bold, r.font.name = Pt(size), bold, self.S["font"]
        r.font.color.rgb = rgb(color)
        if pos is not None:
            dl.position = pos
        return dl

    @staticmethod
    def _no_invert(ch):
        """PowerPoint draws negative bars hollow unless every series AND data point says invertIfNegative=0."""
        for ser in ch._chartSpace.iter(f"{{{C_NS}}}ser"):
            parent_tag = etree.QName(ser.getparent()).localname
            if parent_tag not in ("barChart", "bar3DChart"):
                continue
            inv = ser.find(f"{{{C_NS}}}invertIfNegative")
            if inv is None:
                inv = etree.Element(f"{{{C_NS}}}invertIfNegative")
                anchor = ser.find(f"{{{C_NS}}}spPr")
                if anchor is None:
                    anchor = ser.find(f"{{{C_NS}}}tx")
                anchor.addnext(inv)
            inv.set("val", "0")
            for dpt in ser.findall(f"{{{C_NS}}}dPt"):
                if dpt.find(f"{{{C_NS}}}invertIfNegative") is None:
                    e = etree.Element(f"{{{C_NS}}}invertIfNegative", val="0")
                    dpt.find(f"{{{C_NS}}}idx").addnext(e)

    @staticmethod
    def _plot_box(x, y, w, h, fx, fy, fw, fh):
        return x + w * fx, y + h * fy, w * fw, h * fh

    # ---------------------------------------------------------------- chart recipes (charts.md §3)
    def stacked_columns(self, s, x, y, w, h, categories, series: dict, colors=None, totals=True, fmt='#,##0',
                        total_fmt="{:,.0f}", forecast_from=None, forecast_label="Forecast", cagr=None,
                        legend=True, label_size=9, inside_labels=True, gap=80, vmax=None):
        """Stacked columns, totals bold on top, optional forecast zone (#F2F2F2) and CAGR bubble+arrow."""
        S = self.S
        colors = colors or S["series"]
        n = len(categories)
        tot = [sum(v[i] for v in series.values()) for i in range(n)]
        data = dict(series)
        if totals:
            data["_total"] = [0] * n
        fx, fy, fw, fh = 0.02, 0.12 if (cagr or forecast_from is not None) else 0.06, 0.96, 0.74 if legend else 0.82
        if forecast_from is not None:  # zone behind the chart (added first -> sits behind)
            px, py, pw, ph = self._plot_box(x, y, w, h, fx, fy, fw, fh)
            zx = px + pw * forecast_from / n
            self.rect(s, zx, y + 0.02, px + pw - zx, py + ph - y - 0.02, fill=S["grey1"])
            self.text(s, zx, y + 0.02, px + pw - zx, 0.22, forecast_label, size=9, italic=True, color=S["grey5"],
                      align="center", inset=0)
        gf, ch = self._chart(s, XL_CHART_TYPE.COLUMN_STACKED, x, y, w, h, categories, data)
        plot = ch.plots[0]
        plot.gap_width, plot.overlap = gap, 100
        vmax = vmax or max(tot) * (1.30 if cagr else 1.12)
        self._axis_style(ch, vmin=0, vmax=vmax)
        self._plot_layout(ch, fx, fy, fw, fh)
        for i, ser in enumerate(plot.series):
            if ser.name == "_total":
                self._fill(ser.format, None)
                for k, p in enumerate(ser.points):
                    self._custom_label(p, total_fmt.format(tot[k]), size=label_size + 1, bold=True,
                                       pos=XL_LABEL_POSITION.INSIDE_BASE)
                continue
            col = colors[i % len(colors)]
            self._fill(ser.format, col)
            if forecast_from is not None:
                for k in range(forecast_from, n):
                    p = ser.points[k]
                    self._fill(p.format, _lerp_hex(col, "#FFFFFF", 0.45))
            if inside_labels:
                dark = col.upper() not in ("#F5C400", "#F2F2F2", "#D9D9D9", "#EAD2D2", "#C2D7F6", "#A9D2FB")
                self._labels(ser, size=label_size, color="#FFFFFF" if dark else "#000000", fmt=fmt,
                             pos=XL_LABEL_POSITION.CENTER)
        self._legend(ch, legend and len(series) > 1, hide=[len(series)] if totals else ())
        if cagr:
            i0, i1 = cagr
            px, py, pw, ph = self._plot_box(x, y, w, h, fx, fy, fw, fh)
            cx = lambda i: px + pw * (i + 0.5) / n
            ty = lambda i: py + ph * (1 - tot[i] / vmax) - 0.28
            self.line(s, cx(i0), ty(i0) - 0.05, cx(i1), ty(i1) - 0.05, color=S["grey5"], width=1.0, arrow=True)
            yrs = i1 - i0
            g = (tot[i1] / tot[i0]) ** (1 / yrs) - 1 if tot[i0] > 0 and yrs > 0 else 0
            mx = (cx(i0) + cx(i1)) / 2
            my = (ty(i0) + ty(i1)) / 2 - 0.30
            self.rect(s, mx - 0.6, my - 0.14, 1.2, 0.3, fill="#FFFFFF", line=S["grey5"], line_w=0.75,
                      text=f"CAGR: {g * 100:.1f}%", size=9, bold=True, shape=MSO_SHAPE.OVAL, inset=0)
        return gf

    def bar_chart(self, s, x, y, w, h, categories, values, horizontal=False, color=None, highlight=(),
                  highlight_color=None, fmt='#,##0.0', label_size=10, gap=60, target=None, target_label=None,
                  sort=None, cat_size=9, vmin=None, vmax=None, series_name="Series"):
        """Single-series bars, colour per point (subject highlighted), optional dashed target line."""
        S = self.S
        cats, vals = list(categories), list(values)
        hl = set(cats[i] for i in highlight)
        if sort:
            pairs = sorted(zip(cats, vals), key=lambda t: t[1], reverse=(sort == "desc"))
            cats, vals = [p[0] for p in pairs], [p[1] for p in pairs]
        if horizontal:  # bar charts draw bottom-up: reverse so the first item is on top
            cats, vals = cats[::-1], vals[::-1]
        kind = XL_CHART_TYPE.BAR_CLUSTERED if horizontal else XL_CHART_TYPE.COLUMN_CLUSTERED
        gf, ch = self._chart(s, kind, x, y, w, h, cats, {series_name: vals})
        ch.plots[0].gap_width = gap
        lo = min(0, min(vals)) if vmin is None else vmin
        hi = max(vals) * 1.15 if vmax is None else vmax
        if target is not None:
            hi = max(hi, target * 1.15)
        self._axis_style(ch, vmin=lo, vmax=hi, cat_size=cat_size)
        fx, fy, fw, fh = (0.22, 0.02, 0.70, 0.96) if horizontal else (0.02, 0.08, 0.96, 0.80)
        self._plot_layout(ch, fx, fy, fw, fh)
        ser = ch.plots[0].series[0]
        base = color or S["primary"]
        self._fill(ser.format, base)
        for k, c in enumerate(cats):
            if c in hl:
                self._fill(ser.points[k].format, highlight_color or S["accent"])
        self._labels(ser, size=label_size, fmt=fmt, pos=XL_LABEL_POSITION.OUTSIDE_END)
        self._legend(ch, False)
        if target is not None:
            px, py, pw, ph = self._plot_box(x, y, w, h, fx, fy, fw, fh)
            if horizontal:
                tx = px + pw * (target - lo) / (hi - lo)
                self.line(s, tx, py, tx, py + ph, color=S["dash_red"], width=1.25, dash="dash")
                if target_label:
                    self.text(s, tx - 0.8, py - 0.25, 1.6, 0.22, target_label, size=9, italic=True,
                              color=S["dash_red"], align="center", inset=0)
            else:
                ty = py + ph * (1 - (target - lo) / (hi - lo))
                self.line(s, px, ty, px + pw, ty, color=S["dash_red"], width=1.25, dash="dash")
                if target_label:
                    self.text(s, px, ty - 0.26, 2.0, 0.22, target_label, size=9, italic=True,
                              color=S["dash_red"], align="left", inset=0)
        return gf

    def paired_bars(self, s, x, y, w, h, categories, subject: tuple, peers: tuple, fmt='0.0"%"', label_size=9):
        """AZTD s5: horizontal subject (gold) vs peers (navy), gap 60 / overlap -15, values outEnd."""
        S = self.S
        cats = list(categories)[::-1]
        data = {subject[0]: list(subject[1])[::-1], peers[0]: list(peers[1])[::-1]}
        # series order: peers first so the subject sits on top inside each category
        gf, ch = self._chart(s, XL_CHART_TYPE.BAR_CLUSTERED, x, y, w, h, cats,
                             {peers[0]: data[peers[0]], subject[0]: data[subject[0]]})
        plot = ch.plots[0]
        plot.gap_width, plot.overlap = 60, -15
        allv = data[subject[0]] + data[peers[0]]
        self._axis_style(ch, vmin=min(0, min(allv)), vmax=max(allv) * 1.18, cat_size=10)
        self._plot_layout(ch, 0.22, 0.01, 0.70, 0.88)
        pser, sser = plot.series
        self._fill(pser.format, S["primary"])
        self._fill(sser.format, S["accent"])
        self._labels(pser, size=label_size, fmt=fmt, pos=XL_LABEL_POSITION.OUTSIDE_END)
        self._labels(sser, size=label_size, fmt=fmt, pos=XL_LABEL_POSITION.OUTSIDE_END, bold=True)
        self._legend(ch, True)
        return gf

    def diverging_bars(self, s, x, y, w, h, categories, values, fmt='+0.0"pp";-0.0"pp";0.0"pp"', sort="asc",
                       pos_color=None, neg_color=None, label_size=10):
        """AZTD gap chart: sorted, negatives steel, positives navy, labels with sign, cat labels at the left."""
        S = self.S
        pairs = list(zip(categories, values))
        if sort:
            pairs.sort(key=lambda t: t[1], reverse=(sort == "desc"))
        pairs = pairs[::-1]  # first item on top
        cats, vals = [p[0] for p in pairs], [p[1] for p in pairs]
        gf, ch = self._chart(s, XL_CHART_TYPE.BAR_CLUSTERED, x, y, w, h, cats, {"Gap": vals})
        ch.plots[0].gap_width = 60
        span = max(abs(min(vals)), abs(max(vals)))
        lo = min(vals) - span * 0.35 if min(vals) < 0 else 0
        hi = max(vals) + span * 0.35 if max(vals) > 0 else 0
        self._axis_style(ch, vmin=lo, vmax=hi, cat_size=10, label_low=True)
        self._plot_layout(ch, 0.25, 0.01, 0.73, 0.98)
        ser = ch.plots[0].series[0]
        ser.invert_if_negative = False
        for k, v in enumerate(vals):
            self._fill(ser.points[k].format, (neg_color or S["tint1"]) if v < 0 else (pos_color or S["primary"]))
        self._labels(ser, size=label_size, fmt=fmt, pos=XL_LABEL_POSITION.OUTSIDE_END)
        self._legend(ch, False)
        return gf

    def line_chart(self, s, x, y, w, h, categories, series: dict, colors=None, widths=None, subject=None,
                   end_labels=True, end_fmt="{:,.0f}", val_fmt="#,##0", legend=False, gridlines=True,
                   vmin=None, vmax=None, dashed=(), cat_size=9, tick_skip=None):
        """Lines with value axis + light gridlines; subject thick in accent, peers thin; end labels in series colour."""
        S = self.S
        colors = colors or S["series"]
        gf, ch = self._chart(s, XL_CHART_TYPE.LINE, x, y, w, h, categories, series)
        allv = [v for vs in series.values() for v in vs if v is not None]
        lo = vmin if vmin is not None else math.floor(min(allv) * 0.95)
        hi = vmax if vmax is not None else math.ceil(max(allv) * 1.05)
        self._axis_style(ch, show_values=True, gridlines=gridlines, val_fmt=val_fmt, vmin=lo, vmax=hi, cat_size=cat_size)
        if tick_skip:
            ca = ch._chartSpace.find(f".//{{{C_NS}}}catAx")
            for tag in ("tickLblSkip", "tickMarkSkip"):
                etree.SubElement(ca, f"{{{C_NS}}}{tag}", val=str(tick_skip))
        self._plot_layout(ch, 0.07, 0.04, 0.78 if end_labels else 0.90, 0.80 if legend else 0.86)
        for i, ser in enumerate(ch.plots[0].series):
            name = ser.name
            col = (S["accent"] if name == subject else colors[i % len(colors)])
            wd = (widths or {}).get(name, 2.5 if name == subject else 1.5)
            ser.format.line.color.rgb = rgb(col)
            ser.format.line.width = Pt(wd)
            if name in dashed:
                ser.format.line.dash_style = MSO_LINE_DASH_STYLE.DASH
            ser.smooth = False
            from pptx.enum.chart import XL_MARKER_STYLE
            ser.marker.style = XL_MARKER_STYLE.NONE
            if end_labels:
                vals = series[name]
                k = max(i for i, v in enumerate(vals) if v is not None)
                self._custom_label(ser.points[k], f"{name} {end_fmt.format(vals[k])}", size=9, bold=True, color=col,
                                   pos=XL_LABEL_POSITION.RIGHT)
        self._legend(ch, legend)
        return gf

    def waterfall(self, s, x, y, w, h, steps, fmt="{:,.0f}", colors=None, label_size=9, gap=50, logos=None):
        """steps: [(label, value, 'total'|'delta')]. Base invisible + up (pos) + down (neg) + total (primary)."""
        S = self.S
        colors = colors or {"total": S["primary"], "up": S["pos"], "down": S["neg"]}
        cats, base, up, down, totl, labs = [], [], [], [], [], []
        run = 0
        for lab, v, kind in steps:
            cats.append(lab)
            if kind == "total":
                run = v
                base.append(0); up.append(0); down.append(0); totl.append(v); labs.append(fmt.format(v))
            elif v >= 0:
                base.append(run); up.append(v); down.append(0); totl.append(0); labs.append("+" + fmt.format(v))
                run += v
            else:
                run += v
                base.append(run); up.append(0); down.append(-v); totl.append(0); labs.append("(" + fmt.format(-v) + ")")
        data = {"_base": base, "Increase": up, "Decrease": down, "Total": totl, "_lab": [0] * len(cats)}
        gf, ch = self._chart(s, XL_CHART_TYPE.COLUMN_STACKED, x, y, w, h, cats, data)
        plot = ch.plots[0]
        plot.gap_width, plot.overlap = gap, 100
        tops = [b + u + d + t for b, u, d, t in zip(base, up, down, totl)]
        vmax = max(tops) * 1.15
        self._axis_style(ch, vmin=0, vmax=vmax, cat_size=9)
        fx, fy, fw, fh = 0.02, 0.10 if logos else 0.04, 0.96, 0.78 if logos else 0.84
        self._plot_layout(ch, fx, fy, fw, fh)
        sb, su, sd, st, sl = plot.series
        self._fill(sb.format, None)
        self._fill(su.format, colors["up"])
        self._fill(sd.format, colors["down"])
        self._fill(st.format, colors["total"])
        self._fill(sl.format, None)
        for k, p in enumerate(sl.points):
            self._custom_label(p, labs[k], size=label_size, bold=steps[k][2] == "total",
                               pos=XL_LABEL_POSITION.INSIDE_BASE)
        self._legend(ch, False)
        if logos:  # images above each bar (ALLOC s20)
            px, py, pw, ph = self._plot_box(x, y, w, h, fx, fy, fw, fh)
            n = len(cats)
            for k, path in enumerate(logos):
                if path:
                    top = py + ph * (1 - tops[k] / vmax)
                    s.shapes.add_picture(path, Inches(px + pw * (k + 0.5) / n - 0.25), Inches(top - 0.62), height=Inches(0.32))
        return gf

    def football_field(self, s, x, y, w, h, rows, ref_lines=(), axis=None, fmt="${:,.2f}", label_size=9,
                       groups=None, bar_h_gap=60, colors=None, axis_fmt='"$"#,##0'):
        """Horizontal football field (Barclays p15).
        rows: [(label, low, high, color_key)] color_key in {'main','alt','ref'} or a hex.
        ref_lines: [(value, label, color)] vertical dashed lines (e.g. unaffected price, offer).
        groups: [(group label, first_row, last_row, fill)] -> rotated side tabs at the left."""
        S = self.S
        palette = {"main": S["primary"], "alt": S["tint1"], "ref": S["grey3"], **(colors or {})}
        lows = [r[1] for r in rows]
        highs = [r[2] for r in rows]
        lo, hi = axis or (math.floor(min(lows + [v for v, *_ in ref_lines]) * 0.9),
                          math.ceil(max(highs + [v for v, *_ in ref_lines]) * 1.08))
        cats = [r[0] for r in rows][::-1]
        off = [r[1] - lo for r in rows][::-1]
        rng = [r[2] - r[1] for r in rows][::-1]
        tab_w = 0.32 if groups else 0
        x_chart = x + tab_w
        w_chart = w - tab_w
        gf, ch = self._chart(s, XL_CHART_TYPE.BAR_STACKED, x_chart, y, w_chart, h, cats,
                             {"_off": off, "Range": rng, "_hi": [0] * len(cats)})
        plot = ch.plots[0]
        plot.gap_width, plot.overlap = bar_h_gap, 100
        # axis shows absolute values: shift by lo through the number format is not possible -> use 0..(hi-lo)
        self._axis_style(ch, show_values=False, vmin=0, vmax=hi - lo, cat_size=10)
        fx, fy, fw, fh = 0.36, 0.08, 0.60, 0.80
        self._plot_layout(ch, fx, fy, fw, fh)
        so, sr, shi = plot.series
        self._fill(so.format, None)
        self._fill(shi.format, None)
        cols = [r[3] for r in rows][::-1]
        for k, p in enumerate(sr.points):
            ck = cols[k]
            self._fill(p.format, palette.get(ck, ck))
        lows_r, highs_r = lows[::-1], highs[::-1]
        for k in range(len(cats)):
            self._custom_label(so.points[k], fmt.format(lows_r[k]), size=label_size, bold=False,
                               pos=XL_LABEL_POSITION.INSIDE_END)
            self._custom_label(shi.points[k], fmt.format(highs_r[k]), size=label_size, bold=False,
                               pos=XL_LABEL_POSITION.INSIDE_BASE)
        self._legend(ch, False)
        px, py, pw, ph = self._plot_box(x_chart, y, w_chart, h, fx, fy, fw, fh)
        X = lambda v: px + pw * (v - lo) / (hi - lo)
        # own axis (absolute values) under the plot
        nt = 5
        step = (hi - lo) / nt
        self.line(s, px, py + ph, px + pw, py + ph, color=S["grey5"], width=0.75)
        for t in range(nt + 1):
            v = lo + t * step
            self.text(s, X(v) - 0.45, py + ph + 0.03, 0.9, 0.2, fmt.format(v).replace(".00", ""), size=8,
                      align="center", color=S["grey7"], inset=0)
        for v, lab, colr in ref_lines:
            self.line(s, X(v), py - 0.05, X(v), py + ph, color=colr or S["dash_red"], width=1.25, dash="dash")
            self.rect(s, X(v) - 0.75, py - 0.33, 1.5, 0.26, fill="#FFFFFF", line=colr or S["dash_red"], line_w=0.75,
                      dash="dash", text=f"{lab}: {fmt.format(v)}", size=8, bold=True, color=colr or S["dash_red"], inset=0)
        if groups:
            n = len(rows)
            for g_label, a, b, fill in groups:
                gy = py + ph * a / n
                gh = ph * (b - a + 1) / n
                self.side_tab(s, x, gy + 0.02, tab_w - 0.04, gh - 0.04, g_label, fill=fill or S["primary"])
                if a > 0:
                    self.line(s, x, gy, px + pw, gy, color=S["grey3"], width=0.75, dash="dash")
        return gf

    def tornado(self, s, x, y, w, h, rows, base_value, fmt="${:,.2f}", label_size=9):
        """rows: [(driver label, delta_down (neg), delta_up (pos))] -> BofA/Jefferies tornado around base."""
        S = self.S
        rows = rows[::-1]
        cats = [r[0] for r in rows]
        dn = [r[1] for r in rows]
        up = [r[2] for r in rows]
        gf, ch = self._chart(s, XL_CHART_TYPE.BAR_CLUSTERED, x, y, w, h, cats, {"Downside": dn, "Upside": up})
        plot = ch.plots[0]
        plot.gap_width, plot.overlap = 45, 100
        span = max(max(abs(v) for v in dn), max(abs(v) for v in up)) * 1.45
        self._axis_style(ch, vmin=-span, vmax=span, cat_size=10, label_low=True, cat_line=False)
        fx, fy, fw, fh = 0.30, 0.03, 0.68, 0.94
        self._plot_layout(ch, fx, fy, fw, fh)
        sd, su = plot.series
        self._fill(sd.format, S["tint1"])
        self._fill(su.format, S["primary"])
        for ser, sign in ((sd, -1), (su, 1)):
            for k, p in enumerate(ser.points):
                v = (dn if sign < 0 else up)[k]
                txt = "" if v == 0 else (f"({fmt.format(abs(v))})" if v < 0 else fmt.format(v))
                self._custom_label(p, txt or " ", size=label_size, bold=True, pos=XL_LABEL_POSITION.OUTSIDE_END)
        self._legend(ch, False)
        px, py, pw, ph = self._plot_box(x, y, w, h, fx, fy, fw, fh)
        cx = px + pw / 2
        self.line(s, cx, py - 0.1, cx, py + ph, color=S["grey5"], width=1.0, dash="dash")
        self.text(s, cx - 1.0, py - 0.34, 2.0, 0.24, f"Base: {fmt.format(base_value)}", size=9, bold=True,
                  align="center", inset=0)
        return gf

    def donut(self, s, x, y, d, labels, values, center_text=None, center_label=None, colors=None, hole=60,
              show_pct=True, legend=True):
        S = self.S
        colors = colors or S["series"]
        gf, ch = self._chart(s, XL_CHART_TYPE.DOUGHNUT, x, y, d, d, labels, {"Mix": values})
        dc = ch._chartSpace.find(f".//{{{C_NS}}}doughnutChart")
        hs = dc.find(f"{{{C_NS}}}holeSize")
        if hs is None:
            hs = etree.SubElement(dc, f"{{{C_NS}}}holeSize")
        hs.set("val", str(hole))
        ser = ch.plots[0].series[0]
        tot = sum(values)
        for k, p in enumerate(ser.points):
            self._fill(p.format, colors[k % len(colors)])
            p.format.line.color.rgb = rgb("#FFFFFF")
            p.format.line.width = Pt(1.5)
            if show_pct:
                col = colors[k % len(colors)]
                light = col.upper() in ("#F5C400", "#EAD2D2", "#C2D7F6", "#A9D2FB", "#D9D9D9", "#9DAAC0", "#A6A6A6")
                self._custom_label(p, f"{values[k] / tot * 100:.0f}%", size=9, bold=True,
                                   color="#000000" if light else "#FFFFFF")
        self._plot_layout(ch, 0.08, 0.08 if not legend else 0.04, 0.84, 0.84 if not legend else 0.74)
        self._legend(ch, legend)
        if center_text:
            cy = y + d * (0.04 + 0.37) if legend else y + d / 2
            self.text(s, x, cy - 0.32, d, 0.4, center_text, size=20, bold=True, color=S["primary"], align="center",
                      anchor="bottom", inset=0)
            if center_label:
                self.text(s, x + d * 0.25, cy + 0.08, d * 0.5, 0.3, center_label, size=9, align="center", inset=0)
        return gf

    # ================================================================ structural diagrams
    # "Explain the structure with shapes" recipes (user favourites): KLA s7 process chain, ALLOC s3 share
    # structure, ALLOC s4 nested circles, ALLOC s14 price range, ALLOC s8 cylinder bridge, ALLOC s16
    # conclusion bar with soft tail. Measurements in references/structural-diagrams.md.

    def progression(self, n, start=None, end=None):
        """n fills from neutral grey to the primary colour (ALLOC s16 chevrons grey -> rose -> wine)."""
        a, b = start or "#808080", end or self.S["primary"]
        if n == 1:
            return [b]
        return [_lerp_hex(a, b, i / (n - 1)) for i in range(n)]

    def _alpha(self, sh, alpha):
        """alpha 0-1 on the solid fill of a shape (KLA uses 80% -> 50% for the focus steps)."""
        sf = sh.fill._xPr.find(qn("a:solidFill"))
        clr = sf[0]
        for e in clr.findall(qn("a:alpha")):
            clr.remove(e)
        etree.SubElement(clr, qn("a:alpha"), val=str(int(alpha * 100000)))

    def process_chain(self, s, x, y, w, steps, h=0.773, gap=0.075, focus=None, focus_label=None,
                      focus_color=None, feedback=(), size=11, row2=None, row_gap=0.32, input_w=None):
        """KLA s7 'value chain' (measured): homePlate steps h0.773, 2.25pt outlines.
        steps: list of (label, kind[, image]) kind in input|neutral|focus|end.
          input  = white fill + primary outline + black bold 14 (+ optional picture inside, right)
          neutral= grey #A6A6A6 fill, #7F7F7F outline, white bold
          focus  = primary fill with alpha 80% -> 50% along the run, primary outline, white bold
          end    = tint/second hue fill
        focus=(i0, i1): red dashed bracket around those steps + bold italic label above (focus_label).
        feedback=[(from_idx, to_idx)]: elbow lines under the chain back to an earlier step (arrow).
        row2: optional second row [(label, kind[, image]), ...] aligned under the first two columns.
        Returns dict of step boxes {i: (x, y, w, h)}."""
        S = self.S
        fc = focus_color or S["primary"]
        n = len(steps)
        iw = input_w or (w / n) * 1.35
        sw = (w - iw - gap * (n - 1)) / (n - 1) if steps[0][1] == "input" else (w - gap * (n - 1)) / n
        nf = sum(1 for st in steps if st[1] == "focus")
        boxes, k, cx = {}, 0, x
        for i, st in enumerate(steps):
            label, kind = st[0], st[1]
            img = st[2] if len(st) > 2 else None
            bw = iw if kind == "input" else sw
            boxes[i] = self._chain_step(s, cx, y, bw, h, label, kind, img, fc, size,
                                        alpha=0.8 - 0.3 * (k / max(nf - 1, 1)) if kind == "focus" else None)
            if kind == "focus":
                k += 1
            cx += bw + gap
        if row2:
            yy = y + h + row_gap
            cx = x
            for j, st in enumerate(row2):
                bw = iw if st[1] == "input" else sw
                boxes[f"r2_{j}"] = self._chain_step(s, cx, yy, bw, h, st[0], st[1], st[2] if len(st) > 2 else None,
                                                    fc, size)
                cx += bw + gap
        if focus:
            i0, i1 = focus
            fx0 = boxes[i0][0] - 0.075
            fx1 = boxes[i1][0] + boxes[i1][2] + 0.075
            self.rect(s, fx0, y - 0.13, fx1 - fx0, h + 0.23, line=S["dash_red"], line_w=2.25, dash="dash")
            if focus_label:
                self.text(s, fx0, y - 0.45, fx1 - fx0, 0.32, focus_label, size=14, bold=True, italic=True,
                          color=S["primary_dark"], align="center", inset=0)
        for depth, (a, b) in enumerate(feedback):
            ax = boxes[a][0] + boxes[a][2] * 0.45
            bx = boxes[b][0] + boxes[b][2] * 0.45 if not isinstance(b, str) else boxes[b][0] + boxes[b][2]
            yb = y + h + 0.24 + 0.12 * depth
            col = S["primary_dark"]
            self.line(s, ax, y + h, ax, yb, color=col, width=2.0)
            if isinstance(b, str):  # into the right side of a row-2 box
                by = boxes[b][1] + boxes[b][3] / 2
                self.line(s, ax, yb, ax, by, color=col, width=2.0)
                self.line(s, ax, by, bx, by, color=col, width=2.0, arrow=True)
            else:
                self.line(s, ax, yb, bx, yb, color=col, width=2.0)
                self.line(s, bx, yb, bx, y + h, color=col, width=2.0, arrow=True)
        return boxes

    def _chain_step(self, s, x, y, w, h, label, kind, img, fc, size, alpha=None):
        S = self.S
        if kind == "input":
            sh = self.rect(s, x, y, w, h, fill="#FFFFFF", line=fc, line_w=2.25, text=label, size=size + 2, bold=True,
                           shape=MSO_SHAPE.PENTAGON, align="left", inset=0.15)
            if img:
                s.shapes.add_picture(img, Inches(x + w * 0.52), Inches(y + 0.1), height=Inches(h - 0.2))
        elif kind == "neutral":
            sh = self.rect(s, x, y, w, h, fill="#A6A6A6", line="#7F7F7F", line_w=2.25, text=label, size=size + 1,
                           bold=True, color="#FFFFFF", shape=MSO_SHAPE.PENTAGON, align="left", inset=0.12)
        elif kind == "end":
            sh = self.rect(s, x, y, w, h, fill=S["tint1"], line=S["tint1"], line_w=2.25, text=label, size=size,
                           bold=True, color="#FFFFFF", shape=MSO_SHAPE.PENTAGON, align="left", inset=0.12)
        else:  # focus
            sh = self.rect(s, x, y, w, h, fill=fc, line=fc, line_w=2.25, text=label, size=size, bold=True,
                           color="#FFFFFF", shape=MSO_SHAPE.PENTAGON, align="left", inset=0.12)
            if alpha is not None:
                self._alpha(sh, alpha)
        sh.adjustments[0] = 0.44435
        return (x, y, w, h)

    def detail_card(self, s, x, y, w, title, body, h_body=1.1, image=None, image_side="left", size=12):
        """KLA s7 bottom: grey header bar (white bold 14) + outlined box with bold-lead text (+ round image)."""
        S = self.S
        self.rect(s, x, y, w, 0.4, fill="#7F7F7F", line="#000000", line_w=1.5, text=title, size=14, bold=True,
                  color="#FFFFFF")
        self.rect(s, x, y + 0.488, w, h_body, fill="#FFFFFF", line="#000000", line_w=1.5, text=body, size=size,
                  align="justify", anchor="middle", inset=0.1)
        if image:
            d = h_body
            ix = x - d - 0.2 if image_side == "left" else x + w + 0.2
            pic = s.shapes.add_picture(image, Inches(ix), Inches(y + 0.488), Inches(d), Inches(d))
            pic.auto_shape_type = MSO_SHAPE.OVAL
            pic.line.color.rgb = rgb(S["primary"])
            pic.line.width = Pt(2.25)

    def struct_box(self, s, x, y, w, h, title, value=None, fill=None, line="#1F2937", size=14, note=None):
        """ALLOC s3 share-structure node: filled rect, bold title 14 + value 12 (white text on dark fills)."""
        fill = fill or self.S["tint2"]
        dark = _lum(fill) < 0.55
        txt = [f"**{title}**"] + ([value] if value else [])
        if value and h < 0.6:
            size = min(size, 12)
        self.rect(s, x, y, w, h, fill=fill, line=line, line_w=1.0, text=txt, size=size,
                  color="#FFFFFF" if dark else "#000000")
        if note:
            self.text(s, x, y + h + 0.03, w, 0.7, note, size=10, bold=True, italic=True, inset=0.02)
        return (x, y, w, h)

    def connect(self, s, a, b, color="#000000", width=1.0, arrow=True):
        """Straight arrow from bottom-centre of box a to top-centre of box b (boxes are (x,y,w,h))."""
        ax, ay = a[0] + a[2] / 2, a[1] + a[3]
        bx, by = b[0] + b[2] / 2, b[1]
        if abs(ax - bx) < 0.02:
            self.line(s, ax, ay, bx, by, color=color, width=width, arrow=arrow)
        else:  # elbow: down, across, down
            my = (ay + by) / 2
            self.line(s, ax, ay, ax, my, color=color, width=width)
            self.line(s, ax, my, bx, my, color=color, width=width)
            self.line(s, bx, my, bx, by, color=color, width=width, arrow=arrow)

    def nested_circles(self, s, x, y, d, rings, callouts=None, text_x=None, text_w=None, line_color=None):
        """ALLOC s4 bubble-in-bubble (shares of a whole), circles bottom-aligned.
        rings: [(title, [lines], fill or None, scale)] outermost first; scale = diameter / d.
        callouts: [(title, bullets)] one per ring -> leader line with a dot from the ring edge to a text
        block at the right (bold 14 title + 11 pt bullets)."""
        S = self.S
        lc = line_color or S["primary"]
        n = len(rings)
        centres = []
        for i, (title, lines, fill, sc) in enumerate(rings):
            dd = d * sc
            cx, cy = x + d / 2, y + d - dd / 2
            centres.append((cx, cy, dd))
            sh = self.rect(s, cx - dd / 2, cy - dd / 2, dd, dd, fill=fill, line=lc if fill is None else None,
                           line_w=1.0, shape=MSO_SHAPE.OVAL)
            dark = fill is not None and _lum(fill) < 0.55
            # label sits in the part of the ring not covered by the next ring
            nxt = rings[i + 1][3] * d if i + 1 < n else 0
            free_top = cy - dd / 2
            free_h = dd - nxt
            ty = free_top + free_h * 0.18
            self.text(s, cx - dd * 0.42, ty, dd * 0.84, max(free_h * 0.62, 0.5),
                      [f"**{title}**"] + list(lines), size=12, color="#FFFFFF" if dark else "#000000",
                      align="center", anchor="top", inset=0.02)
        if callouts:
            tx = text_x if text_x is not None else x + d + 1.2
            tw = text_w or (S["content"]["x1"] - tx)
            nb = len(callouts)
            band = d / nb
            for i, (title, bullets) in enumerate(callouts):
                cx, cy, dd = centres[i]
                ly = y + band * i + 0.25
                # point on the ring's right edge at height ly (clamped)
                dy = max(min(ly - cy, dd / 2 * 0.95), -dd / 2 * 0.95)
                ex = cx + math.sqrt(max((dd / 2) ** 2 - dy ** 2, 0))
                ey = cy + dy
                self.line(s, ex, ey, tx - 0.15, ey, color=lc, width=1.25)
                self.rect(s, ex - 0.04, ey - 0.04, 0.08, 0.08, fill=lc, shape=MSO_SHAPE.OVAL)
                self.text(s, tx, ey - 0.22, tw, band, [f"**{title}**"] + [f"- {b}" for b in bullets], size=11,
                          align="justify", inset=0)

    def price_range(self, s, x, y, w, lo, hi, marks, band=None, callout=None, fmt="${:,.1f}"):
        """ALLOC s14 number line: arrowed axis lo..hi, value tags above ticks, band label below.
        marks: [(value, style)] style in {'dark','primary'}; band: (v0, v1, text); callout: (value, text)."""
        S = self.S
        X = lambda v: x + w * (v - lo) / (hi - lo)
        self.line(s, x + w, y, x - 0.05, y, color="#000000", width=1.5, arrow=True)
        last_x, level = -9, 0
        for v, style in sorted(marks):
            fill = S["primary_dark"] if style == "dark" else S["primary"]
            level = level + 1 if X(v) - last_x < 0.9 else 0
            last_x = X(v)
            ty = y - 0.5 - 0.36 * level
            self.line(s, X(v), ty + 0.28, X(v), y + 0.12, color="#000000", width=1.0 if level else 1.25)
            self.rect(s, X(v) - 0.42, ty, 0.84, 0.28, fill=fill, text=fmt.format(v), size=10, color="#FFFFFF",
                      round_=0.2, shadow=True, inset=0.02)
        if band:
            v0, v1, txt = band
            self.line(s, X(v0), y + 0.36, X(v1), y + 0.36, color="#000000", width=1.0, dash="dash")
            self.rect(s, (X(v0) + X(v1)) / 2 - 1.15, y + 0.18, 2.3, 0.4, fill=S["primary_dark"], text=txt, size=10,
                      color="#FFFFFF", shadow=True, inset=0.03)
        if callout:
            v, txt = callout
            self.callout(s, X(v) - 2.0, y - 1.35, 1.1, 0.26, txt, to=(X(v) - 0.3, y - 0.6), pointer=True, size=9)

    def _cyl_slice(self, s, x, y, w, h_left, h_right, fill, face_fill, cap=0.22, line=None):
        """Truncated cone (side view) as custGeom: body + lighter front ellipse (ALLOC s8)."""
        H = h_left
        top_r = (h_left - h_right) / 2
        emu = lambda v: int(v * 914400)
        W, Hh = emu(w), emu(H)
        cr = emu(cap)
        sh = s.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(x), Inches(y), Inches(w), Inches(H))
        _strip_style(sh)
        spPr = sh._element.spPr
        prst = spPr.find(qn("a:prstGeom"))
        cg = etree.Element(qn("a:custGeom"))
        for t in ("avLst", "gdLst", "ahLst", "cxnLst"):
            etree.SubElement(cg, qn(f"a:{t}"))
        etree.SubElement(cg, qn("a:rect"), l="0", t="0", r="r", b="b")
        pl = etree.SubElement(cg, qn("a:pathLst"))
        p = etree.SubElement(pl, qn("a:path"), w=str(W), h=str(Hh))
        t2, b2 = emu(top_r), emu(top_r + h_right)
        mv = etree.SubElement(p, qn("a:moveTo")); etree.SubElement(mv, qn("a:pt"), x=str(cr), y="0")
        ln = etree.SubElement(p, qn("a:lnTo")); etree.SubElement(ln, qn("a:pt"), x=str(W - cr // 2), y=str(t2))
        etree.SubElement(p, qn("a:arcTo"), wR=str(cr // 2), hR=str((b2 - t2) // 2), stAng=str(-90 * 60000), swAng=str(180 * 60000))
        ln = etree.SubElement(p, qn("a:lnTo")); etree.SubElement(ln, qn("a:pt"), x=str(cr), y=str(Hh))
        etree.SubElement(p, qn("a:arcTo"), wR=str(cr), hR=str(Hh // 2), stAng=str(90 * 60000), swAng=str(180 * 60000))
        etree.SubElement(p, qn("a:close"))
        spPr.replace(prst, cg)
        sh.fill.solid(); sh.fill.fore_color.rgb = rgb(fill)
        if line:
            sh.line.color.rgb = rgb(line); sh.line.width = Pt(0.75)
        else:
            sh.line.fill.background()
        face = self.rect(s, x, y, cap * 2, H, fill=face_fill, shape=MSO_SHAPE.OVAL)
        return sh

    def cylinder_bridge(self, s, x, y, w, h, stages, operators=None, bracket=None, size=12):
        """ALLOC s8: shrinking grey slices ending in a brand slice, numbered circles, operator circles
        between slices, optional bracket + pill under some slices. Use at most once per deck.
        stages: [(top_title, top_value, bottom_title, bottom_value)] (bottom may be None);
                the last stage is highlighted. operators: list of symbols between stages ('-', '+', '=', '≈').
        bracket: (i0, i1, value_text, caption)."""
        S = self.S
        n = len(stages)
        sw = w / n
        cap = 0.22
        greys = [_lerp_hex("#E6E6E6", "#9E9E9E", i / max(n - 2, 1)) for i in range(n - 1)] + [S["primary"]]
        heights = [h * (1 - 0.45 * i / max(n - 1, 1)) for i in range(n + 1)]
        for i, st in enumerate(stages):
            sx = x + i * sw
            hl, hr = heights[i], heights[i + 1]
            sy = y + (h - hl) / 2
            last = i == n - 1
            fill = greys[i]
            self._cyl_slice(s, sx, sy, sw + cap, hl, hr, fill=fill,
                            face_fill=_lerp_hex(fill, "#FFFFFF", 0.35 if not last else 0.45))
            tc = "#FFFFFF" if last else "#000000"
            cc = self.num_circle(s, sx + sw / 2 + cap / 2 - 0.17, sy + hl * 0.08, i + 1, d=0.34,
                                 fill=S["primary_dark"] if not last else "#FFFFFF", size=12)
            if last:  # brand-coloured number on the white circle
                for r in cc.text_frame.paragraphs[0].runs:
                    r.font.color.rgb = rgb(S["primary"])
            top_t, top_v, bot_t, bot_v = (list(st) + [None, None])[:4]
            ty = sy + hl * 0.24
            inner_w = sw - 0.1
            self.text(s, sx + cap + 0.02, ty, inner_w - cap, hl * 0.28,
                      [f"**{top_t}**"] + ([f"__{top_v}__" if False else top_v] if top_v else []),
                      size=size if hl > 3 else size - 1, color=tc, align="center", anchor="middle", inset=0)
            if bot_t:
                self.line(s, sx + cap + 0.15, sy + hl * 0.55, sx + sw - 0.1, sy + hl * 0.55, color=tc, width=0.75)
                self.text(s, sx + cap + 0.02, sy + hl * 0.58, inner_w - cap, hl * 0.28,
                          [f"**{bot_t}**"] + ([bot_v] if bot_v else []), size=size if hl > 3 else size - 1,
                          color=tc, align="center", anchor="middle", inset=0)
        if operators:
            for i, op in enumerate(operators):
                if not op:
                    continue
                cx = x + (i + 1) * sw + cap * 0.6
                cy = y + h / 2
                self.rect(s, cx - 0.16, cy - 0.16, 0.32, 0.32, fill="#404040", text=op, size=12, bold=True,
                          color="#FFFFFF", shape=MSO_SHAPE.OVAL, inset=0)
        if bracket:
            i0, i1, val, cap_txt = bracket
            bx0, bx1 = x + i0 * sw + cap + 0.15, x + (i1 + 1) * sw - 0.1
            by = y + (h + heights[i1 + 1]) / 2 + 0.25
            self.line(s, bx0, by - 0.25, bx0, by, color=S["primary_dark"], width=1.25)
            self.line(s, bx1, by - 0.25, bx1, by, color=S["primary_dark"], width=1.25)
            self.line(s, bx0, by, bx1, by, color=S["primary_dark"], width=1.25)
            mx = (bx0 + bx1) / 2
            self.rect(s, mx - 0.85, by - 0.17, 1.7, 0.36, fill=S["tint1"], line=S["primary_dark"], text=val, size=11,
                      bold=True, color="#FFFFFF", shape=MSO_SHAPE.OVAL, inset=0)
            self.text(s, mx - 1.2, by + 0.22, 2.4, 0.4, f"**{cap_txt}**", size=10, align="center", inset=0)

    def tail_bar(self, s, x, y, w, text, h=0.45, fill="#7F7F7F", tail_h=0.22, tail_fill=None, size=14):
        """ALLOC s16 'Conclusiones' bar: solid bar + a wide, flat, soft triangle beneath that acts as a
        big arrow into the content below. Also used narrow over a box (ALLOC s15 'Excess Cash')."""
        tf = tail_fill or _lerp_hex(fill, "#FFFFFF", 0.62)
        tri = s.shapes.add_shape(MSO_SHAPE.ISOSCELES_TRIANGLE, Inches(x), Inches(y + h - 0.01), Inches(w),
                                 Inches(tail_h))
        _strip_style(tri)
        tri.rotation = 180
        tri.fill.solid(); tri.fill.fore_color.rgb = rgb(tf)
        tri.line.fill.background()
        self.rect(s, x, y, w, h, fill=fill, line="#1F2937", line_w=1.0, text=text, size=size, bold=True,
                  color="#FFFFFF")
        return y + h + tail_h

    def boxed_columns(self, s, x, y, w, items, h=1.9, gap=0.35, size=12):
        """ALLOC s16 boxes under the chevrons: light-grey boxes with bold titles + values (centred)."""
        n = len(items)
        bw = (w - gap * (n - 1)) / n
        for i, lines in enumerate(items):
            self.rect(s, x + i * (bw + gap), y, bw, h, fill=self.S["grey1"], line="#1F2937", line_w=1.0,
                      text=lines, size=size, anchor="middle")
        return bw

    def bullet_columns(self, s, x, y, w, cols, h=1.2, size=11, sep=True):
        """ALLOC s16 bottom: n bullet columns separated by thin vertical rules."""
        n = len(cols)
        cw = w / n
        for i, b in enumerate(cols):
            self.text(s, x + i * cw + 0.1, y, cw - 0.2, h, [f"- {t}" for t in (b if isinstance(b, list) else [b])],
                      size=size, align="justify")
            if sep and i > 0:
                self.line(s, x + i * cw, y, x + i * cw, y + h, color="#7F7F7F", width=0.75)

    # ================================================================ think-cell library
    def tc_slots(self, key):
        """Print the text slots (reading order) of a think-cell library slide, e.g. 'tc:13'."""
        import tclib
        return tclib.slots(key)

    def import_elements(self, s, key, box=None, texts=None, recolor=True):
        """Paste a think-cell library diagram into slide s, recoloured to this system (see tclib.py)."""
        import tclib
        return tclib.import_elements(s, key, self.S, box=box, texts=texts, recolor=recolor)
