def make_brand_system(base="aztlan", primary=None, primary_dark=None, tint1=None, tint2=None, accent=None,
                      font=None, name="brand", title_in_brand_color=None):
    """Swap brand tokens on top of a measured grid (style-systems.md §D)."""
    s = copy.deepcopy(SYSTEMS[base])
    s["name"] = name
    for k, v in dict(primary=primary, primary_dark=primary_dark, tint1=tint1, tint2=tint2, accent=accent).items():
        if v:
            s[k] = v
    if font:
        s["font"] = font
    if primary:
        s["rule_color"] = primary_dark or primary
        if s["rule"]:
            s["rule"]["color"] = s["rule_color"]
        s["series"] = [s["primary"], s["tint1"], "#7F7F7F", s["tint2"], s["primary_dark"], "#A6A6A6"]
        s["cover_bg"] = s["primary_dark"]
        s["subtitle"]["color"] = s["primary_dark"] if base == "aztlan" else s["subtitle"]["color"]
    if title_in_brand_color or (title_in_brand_color is None and base == "femsa"):
        s["title"]["color"] = s["primary"]
    return s


