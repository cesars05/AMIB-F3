base = r"C:\Users\cesar\OneDrive\Documentos\Slide Construction\skill\slide-construction\scripts"


def patch(fn, pairs):
    p = base + "\\" + fn
    s = open(p, encoding="utf-8").read()
    for old, new in pairs:
        assert old in s, (fn, old[:70])
        s = s.replace(old, new)
    open(p, "w", encoding="utf-8").write(s)


