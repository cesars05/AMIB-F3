# ---- limpieza: sin guiones largos (— / –) ----
from docx import Document
dd = Document(OUT)
def clean(s):
    s = re.sub(r"(?<=\d)\s*–\s*(?=\d|[A-Za-z])", " a ", s)
    s = s.replace(" — ", ", ").replace("—", ", ").replace(" – ", ", ").replace("–", "-")
    return s
def walk(paras):
    for p_ in paras:
        for r_ in p_.runs:
            if r_.text and ("—" in r_.text or "–" in r_.text): r_.text = clean(r_.text)
walk(dd.paragraphs)
for t_ in dd.tables:
    for row_ in t_.rows:
        for c_ in row_.cells: walk(c_.paragraphs)
for sec in dd.sections:
    walk(sec.header.paragraphs); walk(sec.footer.paragraphs)
dd.save(OUT)
print("saved", OUT)
