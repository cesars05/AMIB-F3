    s2 = Series(Reference(FF, min_col=col_span, min_row=FT + 1, max_row=last), title="rango")
    s2.graphicalProperties.solidFill = VERDE_ENERGIA
    ch.series.append(s1); ch.series.append(s2); ch.set_categories(cats)
    ch.legend = None; ch.y_axis.number_format = nf; ch.y_axis.majorGridlines = None
    ch.x_axis.delete = False; ch.y_axis.delete = False; ch.x_axis.scaling.orientation = "maxMin"
    FF.add_chart(ch, anchor)
