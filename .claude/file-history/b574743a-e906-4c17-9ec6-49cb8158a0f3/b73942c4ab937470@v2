"""Utilidades de imagen: recorte circular de fotos, normalizacion de logos, placeholder de foto de equipo."""
from PIL import Image, ImageDraw, ImageOps, ImageFont
import os

def circle_crop(src, dst, size=600, center=(0.5, 0.4), zoom=1.0):
    """Recorta cuadrado centrado en 'center' (fracciones) y lo enmascara en circulo con fondo transparente (PNG)."""
    im = Image.open(src).convert("RGBA")
    w, h = im.size
    side = int(min(w, h) / zoom)
    cx, cy = int(center[0] * w), int(center[1] * h)
    x0 = max(0, min(w - side, cx - side // 2)); y0 = max(0, min(h - side, cy - side // 2))
    im = im.crop((x0, y0, x0 + side, y0 + side)).resize((size, size), Image.LANCZOS)
    mask = Image.new("L", (size, size), 0)
    ImageDraw.Draw(mask).ellipse((0, 0, size - 1, size - 1), fill=255)
    out = Image.new("RGBA", (size, size), (0, 0, 0, 0)); out.paste(im, (0, 0), mask)
    out.save(dst); return dst

def placeholder_circle(dst, label="Foto", size=600, fill="#DDEFE3", fg="#0B3D2E"):
    im = Image.new("RGBA", (size, size), (0, 0, 0, 0)); d = ImageDraw.Draw(im)
    d.ellipse((0, 0, size - 1, size - 1), fill=fill, outline=fg, width=6)
    try:
        f = ImageFont.truetype("arial.ttf", size // 7)
    except Exception:
        f = ImageFont.load_default()
    tw = d.textlength(label, font=f)
    d.text(((size - tw) / 2, size / 2 - size // 14), label, fill=fg, font=f)
    im.save(dst); return dst

def logo_on_white(src, dst, pad=0.08, maxw=1200):
    im = Image.open(src).convert("RGBA")
    bg = Image.new("RGBA", im.size, (255, 255, 255, 255)); bg.alpha_composite(im)
    im = bg.convert("RGB"); im = ImageOps.expand(im, border=int(max(im.size) * pad), fill="white")
    if im.width > maxw: im = im.resize((maxw, int(im.height * maxw / im.width)), Image.LANCZOS)
    im.save(dst); return dst
