# ---------- helpers ----------
def put(ws, ref, val, style=None, nf=None, bold=False, italic=False, align=None, wrap=False):
    c = ws[ref]; c.value = val
    if style == "in": input_font(c, bold)
    elif style == "link": link_font(c, bold)
    elif style == "hdr": header_style(c, align or "center")
    elif style == "sec": section_style(c)
    elif style == "title": title_style(c, 14)
    elif style == "note": note_style(c)
    elif style == "tot": calc_font(c, True); c.border = Border(top=THIN)
    else: calc_font(c, bold, italic)
    if nf: c.number_format = nf
    if align or wrap:
        c.alignment = Alignment(horizontal=align, vertical="center" if wrap else None, wrap_text=wrap)
    return c

