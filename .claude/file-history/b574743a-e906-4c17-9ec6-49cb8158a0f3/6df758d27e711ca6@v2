def autocrop(im):
    a = np.array(im.convert("RGBA")).astype(int)
    alpha = a[:, :, 3] > 10
    nonwhite = (a[:, :, :3].sum(axis=2) < 740)
    mask = alpha & nonwhite if alpha.any() else nonwhite
    if not mask.any(): mask = alpha
    ys, xs = np.where(mask)
    if len(xs) == 0: return im
    return im.crop((xs.min(), ys.min(), xs.max() + 1, ys.max() + 1))
def is_light(im):
    a = np.array(im.convert("RGBA")).astype(int); m = a[:, :, 3] > 10
    return bool(m.any()) and a[:, :, :3][m].mean() > 215
def tile_logo(src, dst, bg="#FFFFFF", w=700, h=240, pad=0.12):
    im = Image.open(src).convert("RGBA")
    if is_light(im): bg = "#0B3D2E"
    else: im = autocrop(im)
    bgc = tuple(int(bg[i:i+2], 16) for i in (1, 3, 5)) + (255,)
    canvas = Image.new("RGBA", (w, h), bgc)
    im.thumbnail((int(w * (1 - 2 * pad)), int(h * (1 - 2 * pad))), Image.LANCZOS)
    canvas.alpha_composite(im, ((w - im.width) // 2, (h - im.height) // 2))
    canvas.convert("RGB").save(dst); return dst
