def make_cover(dst):
    full = os.path.join(A, "portada", "aurex_cover_canva.jpg")
    mini = os.path.join(A, "portada", "aurex_cover_canva_miniatura_199x112.jpg")
    W, Hh = 3840, 2160
    if os.path.exists(full):
        bg = Image.open(full).convert("RGB").resize((W, Hh), Image.LANCZOS)
    else:
        bg = Image.open(mini).convert("RGB").resize((W, Hh), Image.BICUBIC).filter(ImageFilter.GaussianBlur(6))
    arr = np.array(bg).astype(np.float32)
    rng = np.random.default_rng(7)
    arr += rng.normal(0, 2.0, arr.shape)
    bg = Image.fromarray(np.clip(arr, 0, 255).astype(np.uint8)).convert("RGBA")
    if not os.path.exists(full):  # capa de lineas finas (solo si no hay imagen completa de Canva)
        ov = Image.new("RGBA", (W, Hh), (0, 0, 0, 0)); dr = ImageDraw.Draw(ov)
        xs = np.linspace(0, W, 700)
        for k in range(26):
            ph = k * 0.045
            for band, (yc, amp, col) in enumerate(((0.62, 0.20, (190, 230, 200)), (0.86, 0.12, (140, 200, 160)))):
                ys = Hh * (yc + 0.10 * np.sin(xs / W * 5.2 + ph + band) * 0.6 + amp * 0.35 * np.sin(xs / W * 2.4 + band * 1.7) - 0.28 * (xs / W - 0.45) * (xs / W > 0.45) * 0 + ph * 0.02 * (1 if band else -1))
                alpha = np.clip(((xs / W) - 0.30) / 0.45, 0, 1) * (150 - 3 * k)
                for i in range(len(xs) - 1):
                    a_ = int(max(alpha[i], 0))
                    if a_ < 6: continue
                    dr.line([(xs[i], ys[i]), (xs[i + 1], ys[i + 1])], fill=col + (a_,), width=3)
        bg = Image.alpha_composite(bg, ov)
    bg.convert("RGB").save(dst, quality=92)
    return dst
