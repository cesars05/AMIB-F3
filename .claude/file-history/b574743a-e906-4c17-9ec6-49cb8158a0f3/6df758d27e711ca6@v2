# ---- limpieza de guiones largos y marcadores ----
from pptx import Presentation
pr = Presentation(OUT)
def clean(t):
    t = re.sub(r"(?<=\d)\s*–\s*(?=\d)", " a ", t)
    return t.replace(" — ", ", ").replace("—", ", ").replace(" – ", ", ").replace("–", "-")
def walk_tf(tf):
    for p_ in tf.paragraphs:
        for r_ in p_.runs:
            if r_.text and ("—" in r_.text or "–" in r_.text): r_.text = clean(r_.text)
def walk(shapes):
    for sh in shapes:
        if sh.shape_type == 6: walk(sh.shapes)
        if sh.has_text_frame: walk_tf(sh.text_frame)
        if getattr(sh, "has_table", False) and sh.has_table:
            for row in sh.table.rows:
                for c in row.cells: walk_tf(c.text_frame)
for sl in pr.slides: walk(sl.shapes)
pr.save(OUT)
print("saved", OUT, "slides", len(pr.slides))
