 ("Escalón 3 · catch-up al GP", lambda col: f"=MIN(({col}{rc+1}-{col}{rc+4}-{col}{rc+5})*Hoja2_Distribucion!$C$10,{col}{rc+5}*Hoja2_Distribucion!$C$9/(1-Hoja2_Distribucion!$C$9))", NF_NUM1),
 ("Escalón 4 · remanente 80/20", lambda col: f"={col}{rc+1}-{col}{rc+4}-{col}{rc+5}-{col}{rc+6}", NF_NUM1),
