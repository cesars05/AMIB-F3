# ---------- 2b) Criterios de exclusion y elegibilidad FICAP ----------
X = wb.create_sheet("Criterios")
set_sheet(X, tab=LIMA, widths={"B": 26, "C": 24, "D": 24, "E": 24, "F": 24, "G": 24, "H": 24, "I": 22})
put(X, "B2", "Aurex Capital - Criterios de exclusión y elegibilidad por empresa", "title")
put(X, "B3", "Cada celda: Cumple / Condición (se verifica en data room antes de invertir) / No cumple. Fuente: dossiers de empresa en fuentes_investigacion/ y art. 192 LISR. Validar con abogado.", "note")
xh = ["Empresa", "(i) Ningún cliente\n>30% de ventas", "(ii) Directivos con\nexperiencia en energía", "(iii) Sin generación\nutility mayorista", "(iv) Sin dependencia\nde subsidios", "(v) Valuación\n≤ USD $100M", "FICAP: mexicana,\nno listada", "Dictamen"]
for i, h in enumerate(xh):
    c = X.cell(row=5, column=2 + i); c.value = h; header_style(c, "center" if i else "left")
X.row_dimensions[5].height = 42
for i, e in enumerate(empresas):
    r = 6 + i
    put(X, f"B{r}", f"=Hoja1_Portafolio!B{18+i}", "link", bold=True); X[f"B{r}"].alignment = Alignment(vertical="center")
    for j, v in enumerate(e["crit"]):
        c = X.cell(row=r, column=3 + j); c.value = v; calc_font(c)
        c.alignment = Alignment(wrap_text=True, vertical="center", horizontal="center")
        tag = v.split(":")[0].strip().lower()
        if tag.startswith("no cumple"): c.fill = PatternFill("solid", fgColor="F6D5D1")
        elif tag.startswith("condición") or tag.startswith("condicion"): c.fill = PatternFill("solid", fgColor="FBEFC5")
        elif tag.startswith("cumple"): c.fill = PatternFill("solid", fgColor=LIMA_SUAVE)
    X.row_dimensions[r].height = 78
put(X, f"B{6+n+1}", "Candidatas descartadas del pipeline original (D3): Verdigris Technologies (empresa de California; sin operación documentada en México; no elegible FICAP) · Solar Inc. y Energypro Mx (valor de $0.5–1M, demasiado pequeñas para tickets de $2M+).", "note")
