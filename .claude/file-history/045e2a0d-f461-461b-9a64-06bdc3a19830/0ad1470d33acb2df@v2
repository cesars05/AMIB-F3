function Set-CellWithBold {
    param($cell, [string]$text, [string[]]$boldPhrases, [int]$row)
    if ($text.Contains(':') -or $text.Contains([string][char]0x2014)) { Write-Output "WARNING row $row contains colon or em dash" }
    $cell.Value2 = $text
    $cell.Font.Bold = $false
    foreach ($phrase in $boldPhrases) {
        $idx = $text.IndexOf($phrase)
        if ($idx -ge 0) { $cell.Characters($idx + 1, $phrase.Length).Font.Bold = $true }
        else { Write-Output "WARNING row $row phrase not found -> '$phrase'" }
    }
}

