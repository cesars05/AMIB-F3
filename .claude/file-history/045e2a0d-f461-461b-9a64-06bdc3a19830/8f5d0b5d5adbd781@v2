function Set-CellWithBold {
    param($cell, [string]$text, [string[]]$boldPhrases)
    $cell.Value2 = $text
    $cell.Font.Bold = $false
    foreach ($phrase in $boldPhrases) {
        $idx = $text.IndexOf($phrase)
        if ($idx -ge 0) {
            $start = $idx + 1
            $len = $phrase.Length
            $cell.Characters($start, $len).Font.Bold = $true
        } else {
            Write-Output "WARNING: phrase not found -> '$phrase'"
        }
    }
}

