function Retry([scriptblock]$b) { for ($k=0; $k -lt 80; $k++) { try { $res = & $b; return ,$res } catch { Start-Sleep -Milliseconds 600 } }; throw "gave up: $b" }
function RangeOf($addr) { for ($k=0; $k -lt 80; $k++) { try { $x = $ws.Range($addr); return ,$x } catch { Start-Sleep -Milliseconds 600 } }; throw "gave up range $addr" }
function RGB($r,$g,$b) { return $r + 256*$g + 65536*$b }

$excel = [System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
$wb = Retry { $excel.Workbooks.Item(1) }
$ws = Retry { $wb.Sheets.Item("Peers") }
trap { try { $excel.ScreenUpdating = $true; $excel.Calculation = -4105 } catch {}; Write-Output "FAILED: $_"; break }

# Guard: only run if J4 is still Net Margin LTM (i.e., not already inserted)
$j4 = Retry { $ws.Cells.Item(4,10).Text }
if ($j4 -ne "Net Margin LTM") { Write-Output "Unexpected J4 header '$j4', aborting"; exit 1 }

Retry { $excel.Calculation = -4135 }
Retry { $excel.ScreenUpdating = $false }

# Expand outline so column insert behaves, then insert new column J
try { $ws.Outline.ShowLevels(0, 2) | Out-Null } catch {}
$colJ = RangeOf "J:J"
Retry { $colJ.EntireColumn.Insert(-4161, 0) } | Out-Null   # shift right, format from left

# After insert: inputs are U..AC; add EBITDA FY0 in AD
Retry { $ws.Cells.Item(4,10).Value2 = "EBITDA Margin" }
Retry { $ws.Cells.Item(4,30).Value2 = "EBITDA FY0" }
$h = RangeOf "AD4"
Retry { $h.Interior.Color = 6299648 }; Retry { $h.Font.Color = 16777215 }; Retry { $h.Font.Bold = $true }
Retry { $h.WrapText = $true }; Retry { $h.HorizontalAlignment = -4108 }; Retry { $h.VerticalAlignment = -4108 }

$P = 'Scale=6 Curn=USD'
$blocks = @(); $first = $null; $last = $null
for ($r = 6; $r -le 70; $r++) {
  $ric = Retry { $ws.Cells.Item($r,3).Text }
  $b = Retry { $ws.Cells.Item($r,2).Text }
  if ($ric -ne "") {
    if ($first -eq $null) { $first = $r }
    $last = $r
    $f1 = "=IFERROR(1*TR(`$C$r,""TR.F.EBITDA"",""Period=FY0 $P""),""n/a"")"
    $f2 = "=IFERROR(AD$r/U$r,""n/a"")"
    Retry { $ws.Cells.Item($r,30).Formula = $f1 }
    Retry { $ws.Cells.Item($r,10).Formula = $f2 }
  } elseif ($b -like "Peer average*") {
    $pf = $first + 1
    $fa = "=IFERROR(AVERAGE(J${pf}:J${last}),""n/a"")"
    Retry { $ws.Cells.Item($r,10).Formula = $fa }
    $blocks += @{ First = $first; Last = $last; Avg = $r }
    $first = $null; $last = $null
  }
}

Retry { $ws.Range("J6:J70").NumberFormat = "0.0%" }
Retry { $ws.Range("J6:J70").HorizontalAlignment = -4108 }
Retry { $ws.Range("AD6:AD70").NumberFormat = "#,##0" }
Retry { $ws.Columns.Item(10).ColumnWidth = 10.5 }
Retry { $ws.Columns.Item(30).ColumnWidth = 11 }

# Conditional formatting for new column (higher is better)
Retry { $ws.Activate() }
$green = RGB 198 239 206; $greenF = RGB 0 97 0
$red = RGB 255 199 206; $redF = RGB 156 0 6
foreach ($blk in $blocks) {
  $rng = RangeOf "J$($blk.First):J$($blk.Last)"
  Retry { $rng.FormatConditions.Delete() } | Out-Null
  Retry { $rng.Select() } | Out-Null
  $cell = "J$($blk.First)"; $avg = "J`$$($blk.Avg)"
  $fc1 = Retry { $rng.FormatConditions.Add(2, [Type]::Missing, "=AND(ISNUMBER($cell),ISNUMBER($avg),$cell>$avg)") }
  Retry { $fc1.Interior.Color = $green }; Retry { $fc1.Font.Color = $greenF }
  $fc2 = Retry { $rng.FormatConditions.Add(2, [Type]::Missing, "=AND(ISNUMBER($cell),ISNUMBER($avg),$cell<$avg)") }
  Retry { $fc2.Interior.Color = $red }; Retry { $fc2.Font.Color = $redF }
}

# Regroup inputs U..AD and collapse
try { $ws.Columns("T:AD").Ungroup() | Out-Null } catch {}
try { $ws.Columns("U:AD").Ungroup() | Out-Null } catch {}
Retry { $ws.Columns("U:AD").Group() } | Out-Null
try { $ws.Outline.ShowLevels(0, 1) | Out-Null } catch {}
Retry { $ws.Range("B2").Select() } | Out-Null

Retry { $excel.ScreenUpdating = $true }
Retry { $excel.Calculation = -4105 }
Write-Output ("Blocks: " + ($blocks | ForEach-Object { "$($_.First)-$($_.Last)/avg$($_.Avg)" }) -join ", ")
