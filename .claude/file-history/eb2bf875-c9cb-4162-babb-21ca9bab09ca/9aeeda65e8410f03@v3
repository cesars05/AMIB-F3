for($r=260;$r -le 275;$r++){
  $lab=""
  foreach($cc in 2,3,4){ $t=""; try{ $t=[string]$cm.Cells.Item($r,$cc).Text }catch{}; if($t.Trim() -ne ""){ $lab=$t; break } }
  $fl=""; try{ $fl=[string]$cm.Cells.Item($r,12).Formula }catch{}
  if($fl.Length -gt 120){ $fl=$fl.Substring(0,120)+"..." }
  if($lab.Trim() -ne "" -or $fl -ne ""){ Write-Output ("r"+([string]$r).PadRight(4)+$lab.PadRight(44)+" L="+$fl) }
