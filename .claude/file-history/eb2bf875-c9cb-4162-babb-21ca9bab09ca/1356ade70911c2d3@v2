$rows=@(57,58,59)
$tops=@(31,35,39)
$bots=@(33,37,41)
$fail=0
for($j=0;$j -lt 3;$j++){
  $r=$rows[$j]; $a=$tops[$j]; $b=$bots[$j]
  for($i=0;$i -lt 7;$i++){
    $S=$SCOL[$i]; $A=$ACOL[$i]
    $f="=+IFERROR(INDEX(Assumptions!"+$A+"`$"+$a+":"+$A+"`$"+$b+",Assumptions!`$F`$9)+Assumptions!`$F`$42,"+$Q+$Q+")"
    try { Try1 { $sm.Range($S+$r).Formula=$f } | Out-Null }
    catch { Write-Output ("  FALLO "+$S+$r+" -> "+$f+"   :: "+$_.Exception.Message); $fail++ }
  }
}
Write-Output ("  shock conectado a los margenes (fallos: "+$fail+")")

