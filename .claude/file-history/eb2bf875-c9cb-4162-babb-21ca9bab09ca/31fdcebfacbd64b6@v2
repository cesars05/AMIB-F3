# ============ A) CONSISTENCIA DE FORMULAS EN LA PROYECCION (L..Q) ============
function Norm($f,$colLetter){
  if($f -eq "" -or -not $f.StartsWith("=")){ return $f }
  $pat='(?<![A-Za-z0-9_$])'+$colLetter+'(\$?)(\d+)'
  return ($f -replace $pat, '@$1$2')
}
function AuditRows($sh,$nm,$r1,$r2){
  Write-Output ("### "+$nm+": filas con formula INCONSISTENTE entre FY2027 y FY2032 ###")
  $cols=@{12="L";13="M";14="N";15="O";16="P";17="Q"}
  $n=0
  for($r=$r1;$r -le $r2;$r++){
    $base=""; $baseCol=""
    $bad=@()
    foreach($c in 12,13,14,15,16,17){
      $f=""
      try{ $f=[string]$sh.Cells.Item($r,$c).Formula }catch{}
      if($f -eq ""){ continue }
      $nf=Norm $f $cols[$c]
      if($base -eq ""){ $base=$nf; $baseCol=$cols[$c]; continue }
      if($nf -ne $base){ $bad+=($cols[$c]) }
    }
    if($bad.Count -gt 0){
      $lab=""
      foreach($cc in 2,3,4){ $t=""; try{ $t=[string]$sh.Cells.Item($r,$cc).Text }catch{}; if($t.Trim() -ne ""){ $lab=$t; break } }
      if($lab.Length -gt 40){ $lab=$lab.Substring(0,40) }
      Write-Output ("  r"+([string]$r).PadRight(4)+$lab.PadRight(41)+" difieren: "+($bad -join ","))
      $n++
    }
  }
  if($n -eq 0){ Write-Output "  (ninguna)" }
  Write-Output ""
}
AuditRows $sm "SEGMENT MODEL" 10 235
AuditRows $cm "CONSOLIDATED MODEL" 10 380

# ============ B) CONSTANTES DURAS EN LA PROYECCION ============
function AuditHard($sh,$nm,$r1,$r2){
  Write-Output ("### "+$nm+": valores DUROS en columnas de proyeccion (L..Q) ###")
  $n=0
  for($r=$r1;$r -le $r2;$r++){
    $hard=@()
    $cols=@{12="L";13="M";14="N";15="O";16="P";17="Q"}
    foreach($c in 12,13,14,15,16,17){
      $f=""
      try{ $f=[string]$sh.Cells.Item($r,$c).Formula }catch{}
      if($f -eq ""){ continue }
      if(-not $f.StartsWith("=")){
        $v=$null; try{ $v=$sh.Cells.Item($r,$c).Value2 }catch{}
        if($v -ne $null -and $v -is [double] -and $v -ne 0){ $hard+=($cols[$c]+"="+[string]$v) }
      }
    }
    if($hard.Count -gt 0){
      $lab=""
      foreach($cc in 2,3,4){ $t=""; try{ $t=[string]$sh.Cells.Item($r,$cc).Text }catch{}; if($t.Trim() -ne ""){ $lab=$t; break } }
      if($lab.Length -gt 38){ $lab=$lab.Substring(0,38) }
      Write-Output ("  r"+([string]$r).PadRight(4)+$lab.PadRight(39)+" "+($hard -join "  "))
      $n++
    }
  }
  if($n -eq 0){ Write-Output "  (ninguno distinto de cero)" }
  Write-Output ""
}
AuditHard $cm "CONSOLIDATED MODEL" 10 380

