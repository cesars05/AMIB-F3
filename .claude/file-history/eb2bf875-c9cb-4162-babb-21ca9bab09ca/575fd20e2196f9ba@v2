# escenarios por segmento
$xl.Calculation=-4135
foreach($seg in "Water Management","Building Envelope","Housebuilding Products"){
  $as.Range("J74").Value2=$seg
  $xl.Calculation=-4105; $xl.CalculateFullRebuild()
  Write-Output ("  "+$seg.PadRight(24)+"  EBITDA vendido "+([string]$cm.Range("O367").Text).PadLeft(8)+"  ingreso neto "+([string]$cm.Range("O370").Text).PadLeft(9)+"  ganancia "+([string]$cm.Range("O372").Text).PadLeft(9)+"  div. especial "+([string]$cm.Range("O378").Text).PadLeft(9)+"  IRR "+([string]$er.Range("C54").Text).PadLeft(7)+"  DCF "+([string]$d.Range("E41").Text).PadLeft(8))
  $xl.Calculation=-4135
}
$as.Range("J74").ClearContents()
$xl.Calculation=-4105
$xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
$wb.Save()
