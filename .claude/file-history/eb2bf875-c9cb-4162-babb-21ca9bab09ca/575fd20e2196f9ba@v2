$netoDespImp=([double]$cm.Range("O370").Value2)-0.25*([double]$cm.Range("O372").Value2)
Write-Output ""
Write-Output "  === PRUEBA ANTI DOBLE-CONTEO ==="
Write-Output ("  efectivo total al inversionista, mantener = "+[string][math]::Round($mantenerTot,0))
