$ErrorActionPreference="Stop"
function T($sb){ for($k=0;$k -lt 40;$k++){ try{ return & $sb }catch{ Start-Sleep -Milliseconds 1200 } }; return "??" }
$xl=$null
for($t=0;$t -lt 30;$t++){ try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application"); break }catch{ Start-Sleep -Milliseconds 900 } }
$wb=$null; foreach($w in $xl.Workbooks){ if($w.Name -match "Alumasc"){ $wb=$w } }
$s=T { $wb.Worksheets.Item("Segment Beta") }
$xl.Calculation=-4135
T { $s.Range("C76:N110").Clear() }

$cand=@(
 @("KRX.I","BE - Kingspan Group (roofing+waterproofing div)"),
 @("SHI.L","BE - SIG plc (insulation/roofing distribution)"),
 @("ROCKb.CO","BE - Rockwool"),
 @("SGOB.PA","BE - Saint-Gobain"),
 @("EPWN.L","HP - Epwin Group (PVC roofline)"),
 @("TON.L","HP - Titon Holdings (ventilation)"),
 @("HWDN.L","HP - Howden Joinery"),
 @("TPK.L","HP - Travis Perkins"),
 @("GFTU.L","HP - Grafton Group"),
 @("WIE.VI","WM - Wienerberger (Pipelife piping)"),
 @("GEBN.S","WM - Geberit (drainage systems)"),
 @("GF.S","WM - Georg Fischer (piping systems)"),
 @("BREE.L","x - Breedon Group"),
 @("KLR.L","x - Keller Group")
)
$r=76
foreach($c in $cand){
  T { $s.Cells.Item($r,3).Value2=$c[0] }
  T { $s.Cells.Item($r,14).Value2=$c[1] }
  T { $s.Cells.Item($r,4).Formula=("=+TR(`$C"+$r+",D`$10,`"Null=BLANK`")") }
  T { $s.Cells.Item($r,5).Formula=("=+TR(`$C"+$r+",E`$10,`"Curn=#1 Scale=#2 Null=BLANK`",,`$D`$5,`$D`$6)") }
  T { $s.Cells.Item($r,7).Formula=("=+TR(`$C"+$r+",G`$10,`"Curn=#1 Scale=#2 Null=BLANK`",,`$D`$5,`$D`$6)") }
  T { $s.Cells.Item($r,8).Formula=("=+TR(`$C"+$r+",H`$10,`"Curn=#1 Scale=#2 Null=BLANK`",,`$D`$5,`$D`$6)") }
  T { $s.Cells.Item($r,9).Formula=("=+IFERROR(G"+$r+"/(E"+$r+"-H"+$r+"),0)") }
  T { $s.Cells.Item($r,10).Formula=("=+TR(`$C"+$r+",J`$10,`"Null=BLANK`")") }
  T { $s.Cells.Item($r,13).Formula=("=IFERROR(TR(`$C"+$r+",M`$10,`" Null=BLANK`",)*1%,`"`")") }
  T { $s.Cells.Item($r,11).Formula=("=+IFERROR(J"+$r+"/(1+(1-M"+$r+")*I"+$r+"),`"`")") }
  $r++
}
$xl.Calculation=-4105
T { $xl.CalculateFullRebuild() }
Start-Sleep -Seconds 40
T { $xl.Calculate() }
Start-Sleep -Seconds 20
Write-Output ("   "+"RIC".PadRight(10)+"Company".PadRight(30)+"MktCap".PadLeft(13)+"D/E".PadLeft(9)+"Beta".PadLeft(8)+"BetaU".PadLeft(8)+"Tax".PadLeft(9)+"   nota")
for($r=76;$r -le 89;$r++){
  $ric=[string](T { $s.Cells.Item($r,3).Text })
  $nm=[string](T { $s.Cells.Item($r,4).Text }); if($nm.Length -gt 29){ $nm=$nm.Substring(0,29) }
  $line="   "+$ric.PadRight(10)+$nm.PadRight(30)
  foreach($c in 5,9,10,11,13){
    $v=[string](T { $s.Cells.Item($r,$c).Text })
    if($v.Length -gt 9){ $v=$v.Substring(0,9) }
    $line+=$v.PadLeft(9)
  }
  Write-Output ($line+"   "+[string](T { $s.Cells.Item($r,14).Text }))
}
