if([string]$er.Range("C54").Text -ne "Gross Money Multiple (MoIC)"){ throw "ABORTO: ER C54 cambio" }
$shares=[double]$er.Range("D12").Value2
$pct=[double]$er.Range("D17").Value2
$entry=[double]$er.Range("D15").Value2
Write-Output ("acciones "+[string][math]::Round($shares,0)+"   participacion "+[string][math]::Round($pct*100,1)+"%   entrada "+[string]$entry+"p")
$xl.ScreenUpdating=$false

function Correr($esc,$venta,$anoSalida,$multSalida){
  $as.Range("F10").Value2=$esc
  if($venta){
    $as.Range("J74").Value2="Water Management"
    $as.Range("J75").Value2=[double]2029
    $as.Range("J76").Value2=[double]8.0
  } else { $as.Range("J74").ClearContents() }
  $er.Range("D21").Value2=[double]$anoSalida
  $er.Range("D32").Value2=[double]$multSalida
  $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
  $esp=0.0
  foreach($a in "E46","F46","G46","H46","I46","J46"){ $esp+=[double]$er.Range($a).Value2 }
  $divTot=[double]$er.Range("D52").Value2
  $ord=($divTot-$esp)/$pct/$shares*100
  $espPS=$esp/$pct/$shares*100
  $exPS=[double]$er.Range("D53").Value2/$pct/$shares*100
  $moic=[double]$er.Range("D54").Value2
  $irr=[double]$er.Range("D55").Value2
  return @($moic,$irr,$ord,$espPS,$exPS)
}

