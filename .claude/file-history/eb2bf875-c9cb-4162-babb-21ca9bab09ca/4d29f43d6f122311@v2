$ErrorActionPreference="Stop"
$wb=$null; $xl=$null
for($t=0;$t -lt 30;$t++){
  try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
    foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
  }catch{}
  if($wb -ne $null){ break }; Start-Sleep -Milliseconds 1000
}
if($wb -eq $null){ throw "ABORTO: libro no encontrado" }
$as=$wb.Worksheets.Item("Assumptions"); $er=$wb.Worksheets.Item("Expected Returns")
$cm=$wb.Worksheets.Item("Consolidated Model"); $d=$wb.Worksheets.Item("DCF")
# guardas del nuevo layout
if([string]$er.Range("C21").Text -ne "Exit Year (FY)"){ throw "ABORTO: C21 no es 'Exit Year (FY)'" }
if([string]$er.Range("C32").Text -ne "Exit EV / EBITDA"){ throw "ABORTO: C32 no es el multiplo de salida" }
if([string]$er.Range("C54").Text -ne "Gross Money Multiple (MoIC)"){ throw "ABORTO: C54 no es MoIC" }
if([string]$er.Range("C55").Text -ne "IRR"){ throw "ABORTO: C55 no es IRR" }
$acc=[double]$er.Range("D17").Value2
$sh=[double]$er.Range("D12").Value2
Write-Output ("entrada "+[string]$er.Range("D15").Text+"p   precio de mercado "+[string]$er.Range("D11").Text+"p   % adquirido "+[string]$er.Range("D17").Text+"   multiplo de entrada "+[string]$er.Range("D27").Text)
Write-Output ""

function Caso($id,$desc,$esc,$venta,$anoVenta,$multVenta,$anoSalida,$multSalida){
  $as.Range("F10").Value2=$esc
  if($venta){
    $as.Range("J74").Value2="Water Management"
    $as.Range("J75").Value2=[double]$anoVenta
    $as.Range("J76").Value2=[double]$multVenta
  } else { $as.Range("J74").ClearContents() }
  $er.Range("D21").Value2=[double]$anoSalida
  $er.Range("D32").Value2=[double]$multSalida
  $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
  $divPS=([double]$er.Range("D52").Value2)/$acc/$sh*100
  $exPS =([double]$er.Range("D53").Value2)/$acc/$sh*100
  $esp=0.0
  if($venta){ for($c=12;$c -le 17;$c++){ $esp+=[double]$cm.Cells.Item(378,$c).Value2 } }
  $espPS=$esp/$sh*100
  $ordPS=$divPS-$espPS
  Write-Output ("  "+$id+"  "+$desc.PadRight(32)+([string]$er.Range("D54").Text).PadLeft(7)+([string]$er.Range("D55").Text).PadLeft(8)+"   "+([string][math]::Round($espPS,0)+"p").PadLeft(7)+([string][math]::Round($ordPS,0)+"p").PadLeft(6)+([string][math]::Round($exPS,0)+"p").PadLeft(7)+([string][math]::Round($divPS+$exPS,0)+"p").PadLeft(8)+"   "+([string]$er.Range("D36").Text).PadLeft(8)+([string]$d.Range("E41").Text).PadLeft(9))
}

Write-Output "============================== LOS CINCO CASOS =============================="
Write-Output "  id  narrativa                          MOIC     IRR    especial  ord  salida   total    px sal.      DCF"
Caso "A" "Downside, 5.0x, 3 anos"          "A - Downside"        $false 0 0    2029 5.0
Caso "B" "Stagnation, 6.1x, 3 anos"        "B - Stagnation"      $false 0 0    2029 6.1
Caso "C" "Partial success, 6.5x, 3 anos"   "C - Partial Success" $false 0 0    2029 6.5
Caso "D" "Venta WM FY27, stub 8.0x, 1+5"   "C - Partial Success" $true  2027 7.9 2032 8.0
Caso "E" "Venta WM FY27, stub 9.0x, 1+5"   "C - Partial Success" $true  2027 7.9 2032 9.0

Write-Output ""
Write-Output "=== detalle de la venta en D/E (escenario C, WM vendida a fin de FY2027 a 7.9x) ==="
$as.Range("F10").Value2="C - Partial Success"
$as.Range("J74").Value2="Water Management"; $as.Range("J75").Value2=[double]2027; $as.Range("J76").Value2=[double]7.9
$xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
foreach($x in @(@(367,"EBITDA de WM vendido"),@(368,"Valor bruto (EV)"),@(370,"Ingreso neto"),@(371,"Valor en libros"),@(372,"Ganancia pre-impuesto"),@(378,"Dividendo especial"))){
  $r=[int]$x[0]; $v=""
  for($c=11;$c -le 17;$c++){ $v+=([string]$cm.Cells.Item($r,$c).Text).PadLeft(10) }
  Write-Output ("   "+([string]$x[1]).PadRight(24)+$v)
}
$espTot=0.0
for($c=12;$c -le 17;$c++){ $espTot+=[double]$cm.Cells.Item(378,$c).Value2 }
Write-Output ("   -> dividendo especial = "+[string][math]::Round($espTot,0)+" mil GBP = "+[string][math]::Round($espTot/$sh*100,1)+"p por accion, contra una entrada de "+[string]$er.Range("D15").Text+"p")
Write-Output ("   -> eso es "+[string][math]::Round($espTot/$sh*100/[double]$er.Range("D15").Value2*100,0)+"% del precio de entrada, de regreso en el ano 2")

# restaurar
$as.Range("F10").Value2="C - Partial Success"
$as.Range("J74").ClearContents()
$er.Range("D21").Value2=[double]2032
$er.Range("D32").Value2=[double]8.0
$xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
$wb.Save()
Write-Output ""
Write-Output ("RESTAURADO: escenario="+[string]$as.Range("F10").Text+"  venta='"+[string]$as.Range("J74").Text+"'  salida="+[string]$er.Range("D21").Text+"  mult="+[string]$er.Range("D32").Text)
$tot=0
foreach($nm in "Assumptions","Segment Model","Consolidated Model","DCF","EPV","SOTP","Summary","Expected Returns"){
  $s=$wb.Worksheets.Item($nm); $e=0
  try{ $e=[int]$s.UsedRange.SpecialCells(-4123,16).Count }catch{}
  if($e -gt 0){ Write-Output ("  ERRORES en "+$nm+": "+$e) }
  $tot+=$e
}
Write-Output ("  celdas con error: "+$tot)
