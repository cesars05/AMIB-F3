$ErrorActionPreference="Stop"
function T($sb){ for($k=0;$k -lt 20;$k++){ try{ return & $sb }catch{ Start-Sleep -Milliseconds 900 } }; return "??" }
$xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
$wb=$null; foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
$s=T { $wb.Worksheets.Item("SOTP") }
Write-Output "########## SOTP completo (col A..X, filas 1..113) ##########"
for($r=1;$r -le 113;$r++){
  $line=""
  for($c=1;$c -le 24;$c++){
    $t=[string](T { $s.Cells.Item($r,$c).Text })
    if($t.Trim() -ne ""){
      $col=""; $n=$c; while($n -gt 0){ $m=($n-1)%26; $col=[char](65+$m)+$col; $n=[math]::Floor(($n-1)/26) }
      if($t.Length -gt 26){ $t=$t.Substring(0,26) }
      $line+=("["+$col+"="+$t+"] ")
    }
  }
  if($line.Trim() -ne ""){ Write-Output ("r"+([string]$r).PadRight(4)+$line) }
}
