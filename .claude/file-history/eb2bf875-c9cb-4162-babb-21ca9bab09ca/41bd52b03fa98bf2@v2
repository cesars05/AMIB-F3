$shares=[double]$er.Range("D12").Value2
$pct=[double]$er.Range("D17").Value2
$entry=[double]$er.Range("D15").Value2
function Caso($esc,$venta,$anoSalida,$multSalida){
  $as.Range("F10").Value2=$esc
  if($venta){
    $as.Range("J74").Value2="Water Management"
    $as.Range("J75").Value2=[double]2029
    $as.Range("J76").Value2=[double]8.0
  } else { [void]$as.Range("J74").ClearContents() }
  $er.Range("D21").Value2=[double]$anoSalida
  $er.Range("D32").Value2=[double]$multSalida
  for($k=1;$k -le 4;$k++){ $xl.CalculateFullRebuild() }
  $esp=0.0
  foreach($a in "E46","F46","G46","H46","I46","J46"){ $esp+=[double]$er.Range($a).Value2 }
  $o=New-Object 'double[]' 5
  $o[0]=[double]$er.Range("D54").Value2
  $o[1]=[double]$er.Range("D55").Value2
  $o[2]=([double]$er.Range("D52").Value2-$esp)/$pct/$shares*100
  $o[3]=$esp/$pct/$shares*100
  $o[4]=[double]$er.Range("D53").Value2/$pct/$shares*100
  return ,$o
}
