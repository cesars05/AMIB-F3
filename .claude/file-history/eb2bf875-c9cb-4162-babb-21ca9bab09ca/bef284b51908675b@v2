function Hist($sh,$r,$lab){
  $v=""; $s=0.0; $n=0
  for($c=4;$c -le 11;$c++){
    $v+=([string]$sh.Cells.Item($r,$c).Text).PadLeft(9)
    if($c -ge 7){ $x=0.0; try{ $x=[double]$sh.Cells.Item($r,$c).Value2 }catch{}; if($x -ne 0){ $s+=$x; $n++ } }
  }
  $p=""
  if($n -gt 0){ $p=([string][math]::Round($s/$n*100,1)+"%") }
  Write-Output ("  "+$lab.PadRight(30)+$v+$p.PadLeft(10))
}
