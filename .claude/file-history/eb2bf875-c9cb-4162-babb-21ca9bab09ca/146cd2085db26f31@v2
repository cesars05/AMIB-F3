$ErrorActionPreference="Stop"
function T($sb){ for($k=0;$k -lt 20;$k++){ try{ return & $sb }catch{ $m=$_.Exception.Message; if($m -match "0x80010001|RPC_E_CALL|rejected|0x800AC472"){ Start-Sleep -Milliseconds 900 } else { throw } } }; throw "Excel ocupado" }
$xl=$null
for($t=0;$t -lt 30;$t++){ try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application"); break }catch{ Start-Sleep -Milliseconds 900 } }
$wb=$null; foreach($w in $xl.Workbooks){ if($w.Name -match "Alumasc"){ $wb=$w } }
$s=T { $wb.Worksheets.Item("Segment Beta") }
$xl.Calculation=-4135

$NAVY=5384228; $GREY=15921906; $WHITE=16777215; $LGREY=10921638

# ---- limpiar las filas que dejan de ser datos ----
foreach($r in 13,14,18,19,20,22,23,24,29){ T { $s.Range("C"+$r+":N"+$r).Clear() } }
T { $s.Range("L12").Clear() }

# ---- RICs por segmento ----
$rics=@{15="GENG.L";16="HILS.L";17="MSLH.L";21="ALUG.L";25="FAN.L";26="ECEL.L";27="GENG.L";28="FORT.L"}
foreach($r in $rics.Keys){ T { $s.Cells.Item($r,3).Value2=$rics[$r] } }
Write-Output "  RICs asignados"

# ---- encabezados de seccion ----
$secs=@{14="Water Management";20="Building Envelope";24="Housebuilding Products"}
foreach($r in $secs.Keys){
  T { $s.Cells.Item($r,4).Value2=$secs[$r] }
  T { $s.Range("C"+$r+":N"+$r).Font.Bold=$true }
  T { $s.Range("C"+$r+":N"+$r).Font.Color=$NAVY }
  T { $s.Range("C"+$r+":N"+$r).Font.Size=10 }
  T { $s.Range("C"+$r+":N"+$r).Font.Name="Arial" }
  T { $s.Rows.Item($r).RowHeight=20 }
}
Write-Output "  encabezados de seccion"

# ---- filas de mediana ----
$meds=@(@(18,15,17,"Median - Water Management"),@(22,21,21,"Alumasc Group beta (no listed comparable)"),@(29,25,28,"Median - Housebuilding Products"))
foreach($m in $meds){
  $r=$m[0]; $a=$m[1]; $b=$m[2]
  T { $s.Cells.Item($r,4).Value2=$m[3] }
  foreach($c in 9,10,11,13){
    $cl=[char](64+$c)
    T { $s.Cells.Item($r,$c).Formula=("=MEDIAN("+$cl+$a+":"+$cl+$b+")") }
  }
  T { $s.Cells.Item($r,12).Formula=("=+IFERROR(K"+$r+"*(1+(1-`$M`$12)*`$I`$12),"+[char]34+[char]34+")") }
  T { $s.Range("C"+$r+":N"+$r).Font.Bold=$true }
  T { $s.Range("C"+$r+":N"+$r).Font.Color=0 }
  T { $s.Range("C"+$r+":N"+$r).Font.Size=10 }
  T { $s.Range("C"+$r+":N"+$r).Font.Name="Arial" }
  T { $s.Range("C"+$r+":M"+$r).Interior.Color=$GREY }
  T { $s.Rows.Item($r).RowHeight=20 }
  # copiar formatos numericos de una fila de datos
  foreach($c in 9,10,11,12,13){ T { $s.Cells.Item($r,$c).NumberFormat=[string]$s.Cells.Item(15,$c).NumberFormat } }
}
Write-Output "  filas de mediana"

$xl.Calculation=-4105
$xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
$wb.Save()
Write-Output ""
Write-Output "=== tabla ==="
Write-Output ("   "+"RIC".PadRight(9)+"Company / Section".PadRight(42)+"D/E".PadLeft(9)+"Beta".PadLeft(8)+"BetaU".PadLeft(8)+"BetaRe".PadLeft(9)+"Tax".PadLeft(10))
for($r=12;$r -le 29;$r++){
  $ric=[string](T { $s.Cells.Item($r,3).Text }); $nm=[string](T { $s.Cells.Item($r,4).Text })
  if(($ric+$nm).Trim() -eq ""){ Write-Output ""; continue }
  if($nm.Length -gt 41){ $nm=$nm.Substring(0,41) }
  $line="   "+$ric.PadRight(9)+$nm.PadRight(42)
  foreach($c in 9,10,11,12,13){ $line+=([string](T { $s.Cells.Item($r,$c).Text })).PadLeft(9) }
  Write-Output ("r"+([string]$r).PadRight(3)+$line)
}
