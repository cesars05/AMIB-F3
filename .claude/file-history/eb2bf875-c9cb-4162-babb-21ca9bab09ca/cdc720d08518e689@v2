Write-Output ""
Write-Output ("ESTADO: venta J74='"+[string]$as.Range("J74").Text+"'   sweep J80='"+[string]$as.Range("J80").Text+"'")
Write-Output ""
Write-Output "########## SUMMARY con la columna nueva ##########"
Write-Output ("  "+"".PadRight(26)+"FY2025".PadLeft(10)+"FY2026".PadLeft(10)+"FY2032".PadLeft(10)+"CAGR/Avg".PadLeft(11))
for($i=38;$i -le 59;$i++){
  $l=Lab $su $i
  if($l -eq ""){ continue }
  Write-Output ("  "+$l.PadRight(26)+([string]$su.Cells.Item($i,4).Text).PadLeft(10)+([string]$su.Cells.Item($i,5).Text).PadLeft(10)+([string]$su.Cells.Item($i,11).Text).PadLeft(10)+([string]$su.Cells.Item($i,12).Text).PadLeft(11))
}
Write-Output ""
Write-Output "########## SEGMENT MODEL: muestra ##########"
foreach($i in 13,14,15,16,45,46,56,57,58,59,69,70,71,103,104,105){
  Write-Output ("  r"+([string]$i).PadRight(4)+(Lab $sm $i).PadRight(38)+" R="+([string]$sm.Cells.Item($i,18).Text).PadLeft(9)+"  S="+([string]$sm.Cells.Item($i,19).Text).PadLeft(9))
}
Write-Output ""
Write-Output "########## CONSOLIDATED: muestra ##########"
foreach($i in 13,15,22,28,30,41,43,53,56,79,81,88,91,94,97,104,106){
  Write-Output ("  r"+([string]$i).PadRight(4)+(Lab $cm $i).PadRight(38)+" R="+([string]$cm.Cells.Item($i,18).Text).PadLeft(9)+"  S="+([string]$cm.Cells.Item($i,19).Text).PadLeft(9))
}
$tot=0
foreach($nm in "Assumptions","Segment Model","Consolidated Model","DCF","EPV","SOTP","Summary","Expected Returns"){
  $s=$wb.Worksheets.Item($nm); $e=0
  try{ $e=[int]$s.UsedRange.SpecialCells(-4123,16).Count }catch{}
  if($e -gt 0){ Write-Output ("  ERRORES en "+$nm+": "+$e) }
  $tot+=$e
}
Write-Output ("")
Write-Output ("  celdas con error: "+$tot)
