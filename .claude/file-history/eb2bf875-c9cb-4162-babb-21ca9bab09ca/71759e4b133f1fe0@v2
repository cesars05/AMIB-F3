$ErrorActionPreference="Stop"
$wb=$null
for($t=0;$t -lt 30;$t++){ try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application"); if([int]$xl.Workbooks.Count -gt 0){ foreach($w in $xl.Workbooks){ if($w.Name -match "Alumasc"){ $wb=$w } } } }catch{}; if($wb -ne $null){break}; Start-Sleep -Milliseconds 800 }
function GetWs($n){ for($i=0;$i -lt 30;$i++){ try{ $x=$wb.Worksheets.Item($n); if($x -ne $null){ return $x } }catch{}; Start-Sleep -Milliseconds 700 }; throw ("no hoja "+$n) }
$wa=GetWs "Assumptions"; $sm=GetWs "Segment Model"; $cm=GetWs "Consolidated Model"
$dst=Join-Path "C:\Users\cesar\OneDrive\Desktop\Alumasc & Peers\Alumasc\Financials" ("BACKUP_PRE_REVERTSTRESS_"+(Get-Date -Format "yyyyMMdd_HHmmss")+"_"+$wb.Name)
$wb.SaveCopyAs($dst)
Write-Output ("Libro: "+$wb.Name+"   Backup: "+(Split-Path $dst -Leaf))

# ---- guards ----
if(([string]$cm.Cells.Item(277,3).Text) -notmatch "Debt Stressing"){ throw "r277 no es Debt Stressing" }
