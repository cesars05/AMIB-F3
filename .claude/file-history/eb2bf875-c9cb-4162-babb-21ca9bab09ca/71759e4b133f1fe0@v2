$cm.Rows("283:297").Delete()
Write-Output "  15 filas insertadas eliminadas"

# ---- 3. limpiar y restaurar las etiquetas originales ----
$cm.Range("D279:S282").Clear()
$cm.Range("C279:C282").Clear()
