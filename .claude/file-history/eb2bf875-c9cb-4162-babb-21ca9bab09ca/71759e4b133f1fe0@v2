# ---- 4. quitar el shock de los margenes por segmento ----
$segCols=@("K","L","M","N","O","P","Q")
$asmCols=@("E","F","G","H","I","J","K")
$segRows=@(57,58,59)
$topRows=@(31,35,39)
$botRows=@(33,37,41)
$Q2=[char]34
for($j=0;$j -lt 3;$j++){
  $targetRow=$segRows[$j]; $rTop=$topRows[$j]; $rBot=$botRows[$j]
  for($i=0;$i -lt 7;$i++){
    $colS=$segCols[$i]; $colA=$asmCols[$i]
    $f="=+IFERROR(INDEX(Assumptions!"+$colA+"`$"+$rTop+":"+$colA+"`$"+$rBot+",Assumptions!`$F`$9),"+$Q2+$Q2+")"
    $sm.Range($colS+$targetRow).Formula=$f
  }
}
Write-Output "  shock removido de los margenes"

# ---- 5. quitar la palanca de Assumptions ----
$wa.Range("C42:J42").Clear()
Write-Output "  palanca de Assumptions r42 eliminada"

$xl.Calculation=-4105
$xl.CalculateFullRebuild()
$xl.CalculateFullRebuild()
$xl.CalculateFullRebuild()

Write-Output ""
Write-Output "=== bloque como quedo ==="
for($r=276;$r -le 290;$r++){
  $lab=[string]$cm.Cells.Item($r,3).Text
  $v=""
  for($c=4;$c -le 19;$c++){ $t=[string]$cm.Cells.Item($r,$c).Text; if($t.Trim() -ne ""){ $v+=("["+[char](64+$c)+"="+$t+"] ") } }
  if(($lab+$v).Trim() -ne ""){ Write-Output ("r"+$r+"  "+$lab.PadRight(34)+$v) }
}
Write-Output ""
Write-Output ("  Assumptions r42: ["+[string]$wa.Cells.Item(42,3).Text+"]  F42=["+[string]$wa.Range("F42").Text+"]")
Write-Output ("  Segment K57 = "+[string]$sm.Range("K57").Formula)
$tot=0
foreach($ws in $wb.Worksheets){ if(@("Assumptions","Segment Model","Consolidated Model","DCF","EPV") -contains $ws.Name){ $bc=$null; try{ $bc=$ws.UsedRange.SpecialCells(-4123,16) }catch{ $bc=$null }; if($bc -ne $null){ $n=0; try{$n=[int]$bc.Count}catch{}; if($n -gt 0){ Write-Output ("  !! "+$ws.Name+" "+$n); $tot+=$n } } } }
Write-Output ("")
Write-Output ("  Errores: "+$tot)
Write-Output ("  Balance check: "+((11..17 | ForEach-Object { $i=$_; [string]$cm.Cells.Item(164,$i).Text }) -join " | "))
Write-Output ("  FY2026 revenue / EBIT: "+[string]$cm.Cells.Item(47,11).Text+"  "+[string]$cm.Cells.Item(56,11).Text)
