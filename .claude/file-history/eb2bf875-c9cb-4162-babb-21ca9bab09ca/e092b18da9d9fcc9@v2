# ---------- bloque por segmento ----------
#  off, EBITDA row, FCFF row, g row, WACC row, multiplo semilla, etiqueta
$blocks=@(
 @(0 ,13,23,12,16,10.84,"Median of 9 water / drainage peers"),
 @(20,33,43,32,36,11.43,"Median of 5 roofing / waterproofing peers"),
 @(40,53,63,52,56, 9.35,"Median of 6 housebuilding products peers"),
 @(60,73,83,72,76, 7.90,"Held at the model's own implied GGM multiple"))
foreach($b in $blocks){
  $o=$b[0]; $eb=$b[1]; $fc=$b[2]; $gr=$b[3]; $wa=$b[4]
  T { $s.Cells.Item(21+$o,12).Value2="Terminal Value Exit Multiple" }
  T { $s.Range("L"+(21+$o)).Font.Bold=$true }
  T { $s.Cells.Item(22+$o,12).Value2="Exit multiple (EV/EBITDA)" }
  T { $s.Cells.Item(22+$o,13).Value2=$b[5] }
  T { $s.Range("M"+(22+$o)).NumberFormat='0.00"x"' }
  T { $s.Range("M"+(22+$o)).Interior.Color=$CREAM }
  T { $s.Cells.Item(23+$o,12).Value2="Implied g at that multiple" }
  # g = (TV*w - FCFF) / (TV + FCFF)   con TV = EBITDA_T * multiplo
  $f="=+IFERROR((J"+$eb+"*M"+(22+$o)+"*M"+$wa+"-J"+$fc+")/(J"+$eb+"*M"+(22+$o)+"+J"+$fc+"),0)"
  T { $s.Cells.Item(23+$o,13).Formula=$f }
  T { $s.Range("M"+(23+$o)).NumberFormat="0.0%" }
  T { $s.Cells.Item(24+$o,12).Value2=$b[6] }
  T { $s.Range("L"+(24+$o)).Font.Italic=$true }
  T { $s.Range("L"+(24+$o)).Font.Size=9 }
  T { $s.Range("L"+(24+$o)).Font.Color=$LGREY }
}
