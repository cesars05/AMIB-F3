$ErrorActionPreference="Stop"
$wb=$null
for($t=0;$t -lt 30;$t++){
  try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
    foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
  }catch{}
  if($wb -ne $null){ break }; Start-Sleep -Milliseconds 1000
}
if($wb -eq $null){ throw "ABORTO: libro no encontrado" }
$as=$wb.Worksheets.Item("Assumptions"); $cm=$wb.Worksheets.Item("Consolidated Model")
$sm=$wb.Worksheets.Item("Segment Model"); $d=$wb.Worksheets.Item("DCF")
$er=$wb.Worksheets.Item("Expected Returns"); $so=$wb.Worksheets.Item("SOTP")
$L=@{12="L";13="M";14="N";15="O";16="P";17="Q"}

Write-Output "### 1) Consistencia de formulas en la proyeccion (R1C1, L..Q) ###"
foreach($pr in @(@($sm,"SM",10,237),@($cm,"CM",10,378))){
  $sh=$pr[0]; $nm=[string]$pr[1]; $n=0
  for($r=[int]$pr[2];$r -le [int]$pr[3];$r++){
    $base=""; $bad=@()
    foreach($c in 12,13,14,15,16,17){
      $f=""; try{ $f=[string]$sh.Cells.Item($r,$c).FormulaR1C1 }catch{}
      if($f -eq ""){ continue }
      if($base -eq ""){ $base=$f; continue }
      if($f -ne $base){ $bad+=([string]$L[$c]) }
    }
    if($bad.Count -gt 0){
      $lab=""
      foreach($cc in 2,3,4){ $t=""; try{ $t=[string]$sh.Cells.Item($r,$cc).Text }catch{}; if($t.Trim() -ne ""){ $lab=$t; break } }
      if($lab.Length -gt 40){ $lab=$lab.Substring(0,40) }
      Write-Output ("  "+$nm+" r"+([string]$r).PadRight(4)+$lab.PadRight(41)+" difieren: "+($bad -join ","))
      $n++
    }
  }
  Write-Output ("  -> "+$nm+": "+$n+" filas inconsistentes")
}
Write-Output ""
Write-Output "### 2) Multiplo de equilibrio para vender Water Management ###"
$dcfHold=[double]$d.Range("E41").Value2
Write-Output ("  DCF manteniendo todo = "+[string][math]::Round($dcfHold,1)+"p")
$xl.Calculation=-4135
$as.Range("J74").Value2="Water Management"; $as.Range("J75").Value2=2029
foreach($m in 4.0,5.0,5.5,6.0,6.5,7.0,7.9,9.0,10.0){
  $as.Range("J76").Value2=$m
  $xl.Calculation=-4105; $xl.CalculateFullRebuild()
  Write-Output ("  "+([string]$m+"x").PadLeft(6)+"   DCF "+([string]$d.Range("E41").Text).PadLeft(8)+"   IRR "+([string]$er.Range("C54").Text).PadLeft(7)+"   SOTP "+([string]$so.Range("D112").Text).PadLeft(8))
  $xl.Calculation=-4135
}
Write-Output ""
Write-Output "### 3) Ano de salida: cuando conviene vender WM a 7.9x ###"
$as.Range("J76").Value2=7.9
foreach($y in 2027,2028,2029,2030,2031){
  $as.Range("J75").Value2=$y
  $xl.Calculation=-4105; $xl.CalculateFullRebuild()
  Write-Output ("  ultimo ano completo FY"+[string]$y+"   DCF "+([string]$d.Range("E41").Text).PadLeft(8)+"   IRR "+([string]$er.Range("C54").Text).PadLeft(7)+"   div. especial "+([string]$cm.Range("Q378").Text).PadLeft(8)+([string]$cm.Range("P378").Text).PadLeft(8)+([string]$cm.Range("O378").Text).PadLeft(8)+([string]$cm.Range("N378").Text).PadLeft(8)+([string]$cm.Range("M378").Text).PadLeft(8))
  $xl.Calculation=-4135
}
$as.Range("J75").Value2=2029
$as.Range("J74").ClearContents()
$xl.Calculation=-4105
$xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
$wb.Save()
Write-Output ""
Write-Output "### 4) Estado final (modulo apagado) ###"
Write-Output ("  J74='"+[string]$as.Range("J74").Text+"'  J75="+[string]$as.Range("J75").Text+"  J76="+[string]$as.Range("J76").Text+"  J77="+[string]$as.Range("J77").Text)
Write-Output ("  DCF "+[string]$d.Range("E41").Text+" ("+[string]$d.Range("E42").Text+")   SOTP "+[string]$so.Range("D112").Text+"   EPV "+[string]$wb.Worksheets.Item("EPV").Range("E61").Text)
Write-Output ("  Expected Returns: MoIC "+[string]$er.Range("C53").Text+"   IRR "+[string]$er.Range("C54").Text)
$tot=0
foreach($nm in "Assumptions","Segment Model","Consolidated Model","DCF","EPV","SOTP","Summary","Expected Returns"){
  $s=$wb.Worksheets.Item($nm); $e=0
  try{ $e=[int]$s.UsedRange.SpecialCells(-4123,16).Count }catch{}
  if($e -gt 0){ Write-Output ("  ERRORES en "+$nm+": "+$e) }
  $tot+=$e
}
Write-Output ("  celdas con error: "+$tot)
Write-Output ("  libro guardado: "+[string]$wb.Name)
