$ErrorActionPreference="Stop"
$wb=$null
for($t=0;$t -lt 30;$t++){
  try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
    foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
  }catch{}
  if($wb -ne $null){ break }; Start-Sleep -Milliseconds 1000
}
if($wb -eq $null){ throw "ABORTO: libro no encontrado" }
$cm=$wb.Worksheets.Item("Consolidated Model")
$LT=@{4="D";5="E";6="F";7="G";8="H";9="I";10="J";11="K";12="L"}

Write-Output "=== CM r21 y r63 historico (D..K) ==="
foreach($r in 21,63,29,30,64,65,36,43,38){
  $lab=""
  foreach($cc in 2,3,4){ $t=""; try{ $t=[string]$cm.Cells.Item($r,$cc).Text }catch{}; if($t.Trim() -ne ""){ $lab=$t; break } }
  $v=""
  foreach($c in 4,5,6,7,8,9,10,11){ $v+=([string]$cm.Cells.Item($r,$c).Text).PadLeft(10) }
  Write-Output ("r"+([string]$r).PadRight(4)+$lab.PadRight(40)+$v)
}
Write-Output ""
Write-Output "=== CM r36/r43 formula L ==="
foreach($r in 36,38,43){ Write-Output ("  r"+$r+" L="+[string]$cm.Cells.Item($r,12).Formula+"    K="+[string]$cm.Cells.Item($r,11).Formula) }
Write-Output ""
Write-Output "=== CM: filas 375..382 vacias? ==="
for($r=375;$r -le 382;$r++){
  $s=""
  foreach($c in 2..19){ $t=""; try{ $t=[string]$cm.Cells.Item($r,$c).Text }catch{}; $s+=$t }
  Write-Output ("  r"+$r+" contenido='"+$s+"'")
}
Write-Output ""
Write-Output "=== DCF: r27, r28 vacias? y E30/E31/E32 formulas ==="
$d=$wb.Worksheets.Item("DCF")
for($r=27;$r -le 28;$r++){
  $s=""
  foreach($c in 2..12){ $t=""; try{ $t=[string]$d.Cells.Item($r,$c).Text }catch{}; $s+=$t }
  Write-Output ("  DCF r"+$r+" contenido='"+$s+"'")
}
foreach($a in "E30","E31","E32","E33","E34","E35","E36","E37","E39","E40","E41","E42","P13","P16","B4","C8"){
  Write-Output ("  DCF "+$a+" = '"+[string]$d.Range($a).Formula+"'   texto='"+[string]$d.Range($a).Text+"'")
}
Write-Output ""
Write-Output "=== EPV y SOTP: de donde leen ==="
$ep=$wb.Worksheets.Item("EPV"); $so=$wb.Worksheets.Item("SOTP")
$n=0
for($r=1;$r -le 65;$r++){ foreach($c in 2..12){ $f=""; try{ $f=[string]$ep.Cells.Item($r,$c).Formula }catch{}
  if($f -match "Segment Model|Consolidated"){ Write-Output ("  EPV r"+$r+"c"+$c+" "+$f); $n++ } }
  if($n -gt 24){ break } }
Write-Output "  ---"
$n=0
for($r=1;$r -le 113;$r++){ foreach($c in 2..12){ $f=""; try{ $f=[string]$so.Cells.Item($r,$c).Formula }catch{}
  if($f -match "Segment Model|Consolidated"){ Write-Output ("  SOTP r"+$r+"c"+$c+" "+$f); $n++ } }
  if($n -gt 24){ break } }
