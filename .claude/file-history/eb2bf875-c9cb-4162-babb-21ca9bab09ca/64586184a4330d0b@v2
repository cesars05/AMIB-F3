$ErrorActionPreference="Stop"
function T($sb){ for($k=0;$k -lt 40;$k++){ try{ return & $sb }catch{ Start-Sleep -Milliseconds 1200 } }; return "??" }
$xl=$null
for($t=0;$t -lt 30;$t++){ try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application"); break }catch{ Start-Sleep -Milliseconds 900 } }
$wb=$null; foreach($w in $xl.Workbooks){ if($w.Name -match "Alumasc"){ $wb=$w } }
$s=T { $wb.Worksheets.Item("Segment Beta") }

$datos=@(12,15,16,17,21,25,26,27,28)
$cols=@(4,5,6,7,8,10,13)
Write-Output "=== celdas hardcodeadas (sin formula TR) ==="
$mal=@()
foreach($r in $datos){
  foreach($c in $cols){
    $f=[string](T { $s.Cells.Item($r,$c).Formula })
    if($f -notmatch "TR\("){ $mal+=,@($r,$c); Write-Output ("   r"+$r+" col"+$c+"  = "+$f) }
  }
}
if($mal.Count -eq 0){ Write-Output "   ninguna" }

# plantillas tomadas de una fila sana
$tpl=@{}
foreach($c in $cols){
  foreach($r in $datos){
    $f=[string](T { $s.Cells.Item($r,$c).Formula })
    if($f -match "TR\("){ $tpl[$c]=$f -replace "\`$C$r","`$C{R}" -replace "^(.*)$",'$1'; break }
  }
}
Write-Output "`n=== plantillas ==="
foreach($c in $cols){ Write-Output ("   col "+$c+" -> "+$tpl[$c]) }

Write-Output "`n=== reparando ==="
foreach($p in $mal){
  $r=$p[0]; $c=$p[1]
  if($tpl.ContainsKey($c)){
    $f=$tpl[$c] -replace "\{R\}",[string]$r
    T { $s.Cells.Item($r,$c).Formula=$f }
    Write-Output ("   r"+$r+" col"+$c+" <- "+$f)
  }
}
T { $xl.CalculateFullRebuild() }
Start-Sleep -Seconds 25
T { $xl.Calculate() }
Start-Sleep -Seconds 10
Write-Output ""
Write-Output ("      "+"RIC".PadRight(9)+"Company".PadRight(28)+"MktCap".PadLeft(12)+"TotDebt".PadLeft(11)+"Cash".PadLeft(10)+"D/E".PadLeft(9)+"Beta".PadLeft(8)+"BetaU".PadLeft(8))
foreach($r in 12,15,16,17,18,21,22,25,26,27,28,29){
  $ric=[string](T { $s.Cells.Item($r,3).Text }); $nm=[string](T { $s.Cells.Item($r,4).Text })
  if($nm.Length -gt 27){ $nm=$nm.Substring(0,27) }
  $line="   "+$ric.PadRight(9)+$nm.PadRight(28)
  foreach($c in 5,7,8,9,10,11){ $line+=([string](T { $s.Cells.Item($r,$c).Text })).PadLeft(11) }
  Write-Output ("r"+([string]$r).PadRight(3)+$line)
}
Write-Output ""
for($r=34;$r -le 37;$r++){
  $line=([string](T { $s.Cells.Item($r,4).Text })).PadRight(40)
  foreach($c in 5,6,7){ $line+=([string](T { $s.Cells.Item($r,$c).Text })).PadLeft(14) }
  Write-Output ("r"+([string]$r).PadRight(3)+" "+$line)
}
$e=0; try{ $e=[int]$s.UsedRange.SpecialCells(-4123,16).Count }catch{}
Write-Output ("`n  errores: "+$e)
T { $wb.Save() }
Write-Output "guardado"
