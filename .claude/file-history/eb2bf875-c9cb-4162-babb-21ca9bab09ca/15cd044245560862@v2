$ErrorActionPreference="Stop"
$wb=$null
for($t=0;$t -lt 30;$t++){
  try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
    foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
  }catch{}
  if($wb -ne $null){ break }; Start-Sleep -Milliseconds 1000
}
if($wb -eq $null){ throw "ABORTO: libro no encontrado" }
$er=$wb.Worksheets.Item("Expected Returns")
Write-Output ("usedRange = "+[string]$er.UsedRange.Address())
Write-Output ""
Write-Output "fila | etiqueta (col B)                                | C          | formula de C"
for($r=1;$r -le 60;$r++){
  $lab=[string]$er.Cells.Item($r,2).Text
  $cv=[string]$er.Cells.Item($r,3).Text
  $cf=[string]$er.Cells.Item($r,3).Formula
  $otras=""
  foreach($c in 4,5,6,7,8,9){ $t=[string]$er.Cells.Item($r,$c).Text; if($t.Trim() -ne ""){ $otras+=$t.PadLeft(11) } }
  if(($lab+$cv+$otras).Trim() -ne ""){
    if($lab.Length -gt 46){ $lab=$lab.Substring(0,46) }
    if($cf.Length -gt 60){ $cf=$cf.Substring(0,60) }
    Write-Output ("r"+([string]$r).PadRight(4)+$lab.PadRight(48)+$cv.PadLeft(11)+"  "+$cf)
    if($otras -ne ""){ Write-Output ("      D..I:"+$otras) }
  }
}
