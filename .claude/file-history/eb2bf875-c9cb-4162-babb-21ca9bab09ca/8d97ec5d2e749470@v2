$ErrorActionPreference="Stop"
$wb=$null
for($t=0;$t -lt 30;$t++){
  try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
    foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
  }catch{}
  if($wb -ne $null){ break }; Start-Sleep -Milliseconds 1000
}
if($wb -eq $null){ throw "ABORTO: libro no encontrado" }
Write-Output ("LIBRO: "+[string]$wb.Name)
$as=$wb.Worksheets.Item("Assumptions")
$cm=$wb.Worksheets.Item("Consolidated Model")
$sm=$wb.Worksheets.Item("Segment Model")
$d =$wb.Worksheets.Item("DCF")
$orig=[string]$as.Range("J74").Text
Write-Output ("Segment to Divest antes = '"+$orig+"'   Year Exit = "+[string]$as.Range("J75").Text)
if($orig.Trim() -eq ""){ throw "ABORTO: el modulo esta apagado" }

# filas a capturar: etiqueta corta + fila
$rows=@()
$rows+=,@("P&L  Revenue",13)
$rows+=,@("P&L  Adj. EBITDA",53)
$rows+=,@("P&L  Statutory EBIT",22)
$rows+=,@("P&L  Profit before tax",28)
$rows+=,@("P&L  Profit for the year",32)
$rows+=,@("P&L  Basic EPS (p)",41)
$rows+=,@("BS   Cash at bank",126)
$rows+=,@("BS   Total current assets",132)
$rows+=,@("BS   Total non-current assets",139)
$rows+=,@("BS   TOTAL ASSETS",140)
$rows+=,@("BS   TOTAL LIABILITIES",157)
$rows+=,@("BS   TOTAL EQUITY",165)
$rows+=,@("BS   CHECK (debe ser 0)",168)
$rows+=,@("CF   Cash gen. by operating",184)
$rows+=,@("CF   Net cash from operating",187)
$rows+=,@("CF   Net cash investing",195)
$rows+=,@("CF   Net cash financing",206)
$rows+=,@("CF   Net change in cash",209)
$rows+=,@("CF   CHECK caja (debe ser 0)",215)
$rows+=,@("DEU  Total Debt",253)
$rows+=,@("DEU  Net Debt incl leases",257)

function Snap(){
  $h=@{}
  foreach($x in $rows){
    $r=[int]$x[1]
    $v=@()
    for($c=13;$c -le 17;$c++){   # M=FY2028 .. Q=FY2032
      $t=""
      try{ $t=[string]$cm.Cells.Item($r,$c).Text }catch{}
      $v+=$t
    }
    $h[$r]=$v
  }
  return $h
}
$antes=Snap
$pAntes=[string]$d.Range("E41").Text

try{
  $as.Range("J74").ClearContents()
  $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
  $desp=Snap
  $pDesp=[string]$d.Range("E41").Text
  $wmRev=@()
  for($c=13;$c -le 17;$c++){ $wmRev+=[string]$sm.Cells.Item(13,$c).Text }
}
finally{
  $as.Range("J74").Value2=$orig
  $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
  Write-Output ("restaurado: Segment to Divest = '"+[string]$as.Range("J74").Text+"'")
}
Write-Output ""
Write-Output ("Ingresos de Water Management con el modulo APAGADO (referencia):  "+($wmRev -join " | "))
Write-Output ""
Write-Output ("            "+"".PadRight(30)+"  FY2028     FY2029     FY2030     FY2031     FY2032")
foreach($x in $rows){
  $r=[int]$x[1]; $nm=[string]$x[0]
  $a=$antes[$r]; $b=$desp[$r]
  $la="  CON VENTA "+$nm.PadRight(30)
  $lb="  SIN VENTA "+$nm.PadRight(30)
  for($i=0;$i -lt 5;$i++){ $la+=([string]$a[$i]).PadLeft(11); $lb+=([string]$b[$i]).PadLeft(11) }
  Write-Output $la
  Write-Output $lb
  Write-Output ""
}
Write-Output ("  DCF precio implicito:  CON venta "+$pAntes+"   SIN venta "+$pDesp)

