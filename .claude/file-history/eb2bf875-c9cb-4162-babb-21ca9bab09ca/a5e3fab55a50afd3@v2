$ErrorActionPreference="Stop"
$wb=$null; $xl=$null
for($t=0;$t -lt 30;$t++){
  try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
    foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
  }catch{}
  if($wb -ne $null){ break }; Start-Sleep -Milliseconds 1000
}
if($wb -eq $null){ throw "ABORTO: libro no encontrado" }
foreach($s in $wb.Worksheets){ if([string]$s.Name -eq "Scenarios Summary"){ throw "ABORTO: 'Scenarios Summary' ya existe" } }
$vs=$wb.Worksheets.Item("Valuation Summary")
$xl.DisplayAlerts=$false
$xl.ScreenUpdating=$false

# copiar la hoja para heredar tipografia, anchos, colores y tema
$vs.Copy([System.Reflection.Missing]::Value,$vs)
$ns=$wb.Worksheets.Item($vs.Index+1)
$ns.Name="Scenarios Summary"
Write-Output ("hoja creada: '"+[string]$ns.Name+"' en posicion "+[string]$ns.Index)

# borrar graficos heredados y el cuerpo, conservando el bloque de encabezado r1..r8
try{ $n=$ns.ChartObjects().Count; for($k=$n;$k -ge 1;$k--){ $ns.ChartObjects().Item($k).Delete() }; Write-Output ("  graficos eliminados: "+$n) }catch{ Write-Output "  sin graficos" }
$ns.Range("C10:N100").Clear() | Out-Null
$ns.Range("C2").Value2="Alumasc Group PLC - Scenarios Summary"

