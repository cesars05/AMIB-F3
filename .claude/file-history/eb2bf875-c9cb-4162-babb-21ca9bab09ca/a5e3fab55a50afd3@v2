Write-Output ""
for($i=10;$i -le 35;$i++){
  $lab=[string]$ns.Cells.Item($i,3).Text
  $v=""
  foreach($c in 4,5,6,7,8,9){ $v+=([string]$ns.Cells.Item($i,$c).Text).PadLeft(20) }
  if(($lab+$v).Trim() -ne ""){
    if($lab.Length -gt 52){ $lab=$lab.Substring(0,52) }
    Write-Output ("r"+([string]$i).PadRight(4)+$lab.PadRight(53)+$v)
  }
}
