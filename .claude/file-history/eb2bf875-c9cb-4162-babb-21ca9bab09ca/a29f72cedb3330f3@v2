Foto "SWEEP = Off + venta de WM  (solo sale el producto de la venta)"

$xl.Calculation=-4135; $as.Range("J80").Value2="On"; $xl.Calculation=-4105; $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
Foto "SWEEP = On + venta de WM"

$xl.Calculation=-4135; $as.Range("J74").ClearContents(); $as.Range("J80").Value2="On"; $xl.Calculation=-4105; $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
$wb.Save()
Write-Output ""
Write-Output ("RESTAURADO: J74='"+[string]$as.Range("J74").Text+"'  J80='"+[string]$as.Range("J80").Text+"'  IRR "+[string]$er.Cells.Item($MAP["irr"],3).Text+"  DCF "+[string]$d.Range("E41").Text)
$tot=0
foreach($nm in "Assumptions","Segment Model","Consolidated Model","DCF","EPV","SOTP","Summary","Expected Returns"){
  $s=$wb.Worksheets.Item($nm); $e=0
  try{ $e=[int]$s.UsedRange.SpecialCells(-4123,16).Count }catch{}
  if($e -gt 0){ Write-Output ("  ERRORES en "+$nm+": "+$e) }
  $tot+=$e
}
Write-Output ("  celdas con error: "+$tot)
