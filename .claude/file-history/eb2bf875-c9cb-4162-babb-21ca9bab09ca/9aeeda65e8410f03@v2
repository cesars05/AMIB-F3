$ErrorActionPreference="Stop"
$wb=$null
for($t=0;$t -lt 30;$t++){
  try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
    foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
  }catch{}
  if($wb -ne $null){ break }; Start-Sleep -Milliseconds 1000
}
if($wb -eq $null){ throw "ABORTO: libro no encontrado" }
$as=$wb.Worksheets.Item("Assumptions")
$cm=$wb.Worksheets.Item("Consolidated Model")
$sm=$wb.Worksheets.Item("Segment Model")
Write-Output ("LIBRO: "+[string]$wb.Name+"   modulo de venta: '"+[string]$as.Range("J74").Text+"'")
Write-Output ""

$L=@{11="K";12="L";13="M";14="N";15="O";16="P";17="Q"}
function Norm($f,$c){
  if($f -eq "" -or -not $f.StartsWith("=")){ return $f }
  $s=$f
  # columna actual -> @ ; anterior -> # ; dos atras -> &
  foreach($pair in @(@($c,'@'),@($c-1,'#'),@($c-2,'&'))){
    $cn=[int]$pair[0]; $tok=[string]$pair[1]
    if($cn -lt 1){ continue }
    $col=""; $n=$cn; while($n -gt 0){ $m=($n-1)%26; $col=[char](65+$m)+$col; $n=[math]::Floor(($n-1)/26) }
    $pat='(?<![A-Za-z0-9_$])'+$col+'(\$?)(\d+)'
    $s=$s -replace $pat, ($tok+'$1$2')
  }
  return $s
}
function AuditRows($sh,$nm,$r1,$r2){
  Write-Output ("### "+$nm+": formula INCONSISTENTE entre FY2027 y FY2032 ###")
  $n=0
  for($r=$r1;$r -le $r2;$r++){
    $base=""; $bad=@()
    foreach($c in 12,13,14,15,16,17){
      $f=""
      try{ $f=[string]$sh.Cells.Item($r,$c).Formula }catch{}
      if($f -eq ""){ continue }
      $nf=Norm $f $c
      if($base -eq ""){ $base=$nf; continue }
      if($nf -ne $base){ $bad+=($L[$c]) }
    }
    if($bad.Count -gt 0){
      $lab=""
      foreach($cc in 2,3,4){ $t=""; try{ $t=[string]$sh.Cells.Item($r,$cc).Text }catch{}; if($t.Trim() -ne ""){ $lab=$t; break } }
      if($lab.Length -gt 38){ $lab=$lab.Substring(0,38) }
      $fL=""; try{ $fL=[string]$sh.Cells.Item($r,12).Formula }catch{}
      $fD=""; $cd=[int]$bad[0]
      foreach($k in $L.Keys){ if($L[$k] -eq $bad[0]){ $cd=$k } }
      try{ $fD=[string]$sh.Cells.Item($r,$cd).Formula }catch{}
      if($fL.Length -gt 62){ $fL=$fL.Substring(0,62)+".." }
      if($fD.Length -gt 62){ $fD=$fD.Substring(0,62)+".." }
      Write-Output ("  r"+([string]$r).PadRight(4)+$lab.PadRight(39)+" difiere en: "+($bad -join ","))
      Write-Output ("         L: "+$fL)
      Write-Output ("         "+$bad[0]+": "+$fD)
      $n++
    }
  }
  if($n -eq 0){ Write-Output "  (ninguna)" }
  Write-Output ""
}
AuditRows $sm "SEGMENT MODEL" 10 235
AuditRows $cm "CONSOLIDATED MODEL" 10 380
