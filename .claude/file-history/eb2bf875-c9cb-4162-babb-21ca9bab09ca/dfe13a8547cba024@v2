$xl.Calculation=-4135

# ---------------- escribir 6 anos (E..J) en una fila ----------------
function Fila6($r,$v1,$v2,$v3,$v4,$v5,$v6){
  $as.Cells.Item([int]$r,5).Value2=[double]$v1
  $as.Cells.Item([int]$r,6).Value2=[double]$v2
  $as.Cells.Item([int]$r,7).Value2=[double]$v3
  $as.Cells.Item([int]$r,8).Value2=[double]$v4
  $as.Cells.Item([int]$r,9).Value2=[double]$v5
  $as.Cells.Item([int]$r,10).Value2=[double]$v6
}

