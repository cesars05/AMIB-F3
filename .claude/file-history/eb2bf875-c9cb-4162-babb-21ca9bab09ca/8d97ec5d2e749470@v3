$cm.Range("L199").Formula="=-L378"
$cm.Range("L199:Q199").FillRight()
$xl.Calculation=-4105; $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
Foto "B) PRUEBA: sin barrido; la caja se acumula (solo se reparte el producto de una venta)"

# --- restaurar ---
$xl.Calculation=-4135
$cm.Range("L199").Formula=$guarda
$cm.Range("L199:Q199").FillRight()
$xl.Calculation=-4105; $xl.CalculateFullRebuild(); $xl.CalculateFullRebuild()
$wb.Save()
Write-Output ""
Write-Output ("RESTAURADO: r199 L = "+[string]$cm.Range("L199").Formula+"   Q = "+[string]$cm.Range("Q199").Formula)
Write-Output ("  IRR "+[string]$er.Cells.Item($MAP["irr"],3).Text+"   DCF "+[string]$d.Range("E41").Text)
$tot=0
foreach($nm in "Assumptions","Segment Model","Consolidated Model","DCF","EPV","SOTP","Summary","Expected Returns"){
  $s=$wb.Worksheets.Item($nm); $e=0
  try{ $e=[int]$s.UsedRange.SpecialCells(-4123,16).Count }catch{}
  if($e -gt 0){ Write-Output ("  ERRORES en "+$nm+": "+$e) }
  $tot+=$e
}
Write-Output ("  celdas con error: "+$tot)
