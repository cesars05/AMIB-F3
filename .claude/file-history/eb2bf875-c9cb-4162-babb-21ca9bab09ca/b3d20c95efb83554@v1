$ErrorActionPreference="Stop"
function T($sb){ for($k=0;$k -lt 20;$k++){ try{ return & $sb }catch{ $m=$_.Exception.Message; if($m -match "0x80010001|RPC_E_CALL|rejected|0x800AC472"){ Start-Sleep -Milliseconds 900 } else { throw } } }; throw "Excel ocupado" }
$wb=$null
for($t=0;$t -lt 30;$t++){
  try{ $xl=[System.Runtime.InteropServices.Marshal]::GetActiveObject("Excel.Application")
    foreach($w in $xl.Workbooks){ if([string]$w.Name -match "Alumasc"){ $wb=$w } }
  }catch{}
  if($wb -ne $null){ break }; Start-Sleep -Milliseconds 1200
}
Write-Output "### celdas con error en las 7 hojas ###"
foreach($nm in "Assumptions","Segment Model","Consolidated Model","DCF","EPV","SOTP","Summary"){
  $s=T { $wb.Worksheets.Item($nm) }
  $rng=$null
  try{ $rng=$s.UsedRange.SpecialCells(-4123,16) }catch{ continue }
  if($rng -eq $null){ continue }
  Write-Output ("  --- "+$nm+" : "+[string]$rng.Count+" ---")
  $i=0
  foreach($c in $rng){
    $i++; if($i -gt 8){ Write-Output "      (mas...)"; break }
    Write-Output ("      "+[string]$c.Address($false,$false).PadRight(7)+" = "+[string]$c.Text+"   frm= "+[string]$c.Formula)
  }
}
Write-Output ""
$d=T { $wb.Worksheets.Item("DCF") }
Write-Output "### DCF columna I (Terminal Value) y bloque de valuacion ###"
foreach($r in 11,13,15,17,19,20,21,22,23,24,25,26){
  Write-Output ("  I"+([string]$r).PadRight(4)+" = "+([string](T { $d.Cells.Item($r,9).Text })).PadRight(14)+" frm= "+[string](T { $d.Cells.Item($r,9).Formula }))
}
Write-Output ""
foreach($a in "E30","E31","E32","E33","P12","P16"){
  Write-Output ("  "+$a.PadRight(5)+" = "+([string](T { $d.Range($a).Text })).PadRight(14)+" frm= "+[string](T { $d.Range($a).Formula }))
}
