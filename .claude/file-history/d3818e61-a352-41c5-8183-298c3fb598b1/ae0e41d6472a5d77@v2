import json, datetime, win32com.client as w
from openpyxl.utils import get_column_letter as L
x=w.GetActiveObject('Excel.Application'); wb=x.ActiveWorkbook; ws=wb.Worksheets('Market Growth & Inflation')
wb.SaveCopyAs('backup_before_part4.xlsx')
D=json.load(open('infl.json'))
BLACK=0; PCT='0.0%'
def V(): return ws.Range('B1:B520').Value2
def find(p,start=1,end=520):
    v=V()
    for r in range(start,end+1):
        t=v[r-1][0]
        if isinstance(t,str) and t.startswith(p): return r
    raise Exception('nf '+p)
def fmt_from(t,r,c1='B',c2='Q'):
    ws.Range('%s%d:%s%d'%(c1,t,c2,t)).Copy(); ws.Range('%s%d:%s%d'%(c1,r,c2,r)).PasteSpecial(-4122); x.CutCopyMode=False
def ins(after,n):
    ws.Rows('%d:%d'%(after+1,after+n)).Insert(Shift=-4121,CopyOrigin=0)
    ws.Range('A%d:R%d'%(after+1,after+n)).ClearFormats()
    ws.Range('A%d:R%d'%(after+1,after+n)).Font.Name='Arial'; ws.Range('A%d:R%d'%(after+1,after+n)).Font.Size=11
def setf(r,c1,c2,fn):
    ws.Range(ws.Cells(r,c1),ws.Cells(r,c2)).Formula=tuple([tuple(fn(L(c),c) for c in range(c1,c2+1))])
x.ScreenUpdating=False; x.Calculation=-4135
snap=ws.Range('B13:Q25').Value2

# ---------- 1. monthly table columns H,I,J ----------
hm=find('Monthly Inflation Data')
heads={8:('MX','Mexico INPC Bread, Tortillas & Cereals YoY (%) (INEGI)'),9:('BR','Brazil IPCA Panificados YoY (%) (IBGE)'),10:('ES','Spain CPI Bread & Bakery Products YoY (%) (INE)')}
ws.Cells(hm,7).Value='Brazil IPCA General YoY (%) (IBGE)'
for c,(k,t) in heads.items():
    ws.Range('G%d:G%d'%(hm,hm+108)).Copy(); ws.Range('%s%d:%s%d'%(L(c),hm,L(c),hm+108)).PasteSpecial(-4122)
    ws.Cells(hm,c).Value=t
    for i in range(1,109):
        d=ws.Cells(hm+i,2).Value2
        dt=datetime.datetime(1899,12,30)+datetime.timedelta(days=int(d)); key='%d%02d'%(dt.year,dt.month)
        v=D[k].get(key)
        ws.Cells(hm+i,c).Value=v if v is not None else None
x.CutCopyMode=False

