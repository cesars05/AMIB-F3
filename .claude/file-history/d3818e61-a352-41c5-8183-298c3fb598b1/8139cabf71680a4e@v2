def srcrows(lab):
    s=find(lab); return dict(cur=s+1,con=s+2,vol=s+3,bval=s+4,sh=s+5,pl=s+6,art=s+7)
def build(h,rows,srcn,ccy,subtitle,conlab,pl=True,art=False,infl=None):
    S=srcrows(srcn); r=rows
    sub,size,gr,pr,re_,c1,ct,vo,vg,c2,pk,pg,sh,de,va=[r[k] for k in 'sub size gr pr re c1 ct vo vg c2 pk pg sh de va'.split()]
    for k,tmpl in [('sub',33),('size',34),('gr',35),('pr',36),('re',37),('c1',38),('ct',39),('vo',40),('vg',41),('c2',42),('pk',43),('pg',44),('sh',47),('de',48),('va',49)]:
        fmt_from(tmpl,r[k])
    ws.Cells(sub,2).Value=subtitle
    ws.Cells(size,2).Value='Market Size, Retail Value RSP (Current Prices)'
    ws.Cells(gr,2).Value='Market Growth (Nominal)'
    ws.Cells(pr,2).Value='o/w Price Effect'; ws.Cells(re_,2).Value='o/w Real Growth (Volume and Mix)'
    ws.Cells(ct,2).Value=conlab; ws.Cells(vo,2).Value="Retail Volume ('000 tonnes)"; ws.Cells(vg,2).Value='Volume Growth'
    ws.Cells(pk,2).Value='Price per kg (%s, Current Prices)'%ccy; ws.Cells(pg,2).Value='Price per kg Growth'
    setf(size,3,15,lambda c,i:'=%s%d'%(c,S['cur']))
    setf(gr,3,15,lambda c,i:'=%s%d/%s%d-1'%(c,S['cur'],prv(i),S['cur']))
    setf(pr,3,15,lambda c,i:'=(1+%s%d)/(1+%s%d)-1'%(c,gr,c,re_))
    setf(re_,3,15,lambda c,i:'=%s%d/%s%d-1'%(c,S['con'],prv(i),S['con']))
    setf(ct,3,15,lambda c,i:'=%s%d'%(c,S['con']))
    setf(vo,3,15,lambda c,i:'=%s%d'%(c,S['vol']))
    setf(vg,3,15,lambda c,i:'=%s%d/%s%d-1'%(c,S['vol'],prv(i),S['vol']))
    setf(pk,3,15,lambda c,i:'=%s%d/%s%d'%(c,size,c,vo))
    setf(pg,3,15,lambda c,i:'=(%s%d/%s%d)/(%s%d/%s%d)-1'%(c,S['cur'],c,S['vol'],prv(i),S['cur'],prv(i),S['vol']))
    for rr in (size,ct,vo,pk,va): ws.Cells(rr,16).Formula='=IFERROR((O%d/J%d)^(1/5)-1,"")'%(rr,rr); ws.Cells(rr,16).NumberFormat=PCT
    for rr in (c1,c2): ws.Range('B%d:P%d'%(rr,rr)).ClearContents()
    if infl:
        vi=r['vi']; fmt_from(45,vi); ws.Cells(vi,2).Value='Price per kg Growth vs Inflation (pp)'
        setf(vi,3,15,lambda c,i:'=%s%d-%s%d'%(c,pg,c,infl))
    if pl:
        fmt_from(51,r['pl']); ws.Cells(r['pl'],2).Value='Private Label Market Share'
        setf(r['pl'],3,15,lambda c,i:'=IF(%s%d="","",%s%d/100)'%(c,S['pl'],c,S['pl']))
    if art:
        fmt_from(52,r['art']); ws.Cells(r['art'],2).Value='Artisanal Bakeries Market Share'
        setf(r['art'],3,15,lambda c,i:'=IF(%s%d="","",%s%d/100)'%(c,S['art'],c,S['art']))
        ws.Range('K%d:O%d'%(r['art'],r['art'])).ClearContents()
    if pl: ws.Range('K%d:O%d'%(r['pl'],r['pl'])).ClearContents()
    # keep share/delta/value formulas consistent (direct refs): share hist, delta hist
    setf(sh,3,10,lambda c,i:'=%s%d/100'%(c,S['sh']))
    setf(sh,11,15,lambda c,i:'=%s%d+%s%d'%(L(i-1),sh,c,de))
    setf(de,3,10,lambda c,i:'=(%s%d-%s%d)/100'%(c,S['sh'],prv(i),S['sh']))
    setf(va,3,10,lambda c,i:'=%s%d'%(c,S['bval']))
    setf(va,11,15,lambda c,i:'=%s%d*%s%d'%(c,size,c,sh))

