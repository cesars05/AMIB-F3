V=lambda: ws.Range('B1:B420').Value2
def find(prefix,start=1,end=420):
    v=V()
    for r in range(start,end+1):
        t=v[r-1][0]
        if isinstance(t,str) and t.startswith(prefix): return r
    raise Exception('not found '+prefix)
def fmt_from(t,r):
    ws.Range('B%d:P%d'%(t,t)).Copy(); ws.Range('B%d:P%d'%(r,r)).PasteSpecial(-4122); x.CutCopyMode=False
def ins(after,n):
    ws.Rows('%d:%d'%(after+1,after+n)).Insert(Shift=-4121,CopyOrigin=0)
    ws.Range('A%d:Q%d'%(after+1,after+n)).ClearFormats()
    ws.Range('A%d:Q%d'%(after+1,after+n)).Font.Name='Arial'; ws.Range('A%d:Q%d'%(after+1,after+n)).Font.Size=11
def setf(r,c1,c2,fn):
    ws.Range(ws.Cells(r,c1),ws.Cells(r,c2)).Formula=tuple([tuple(fn(L(c),c) for c in range(c1,c2+1))])
def prv(c): return 'A' if c==3 else L(c-1)
