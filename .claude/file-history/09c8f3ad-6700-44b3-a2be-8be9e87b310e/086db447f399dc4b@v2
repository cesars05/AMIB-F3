def add_runs(p, text):
    for i, part in enumerate(re.split(r'\*\*', text)):
        if not part: continue
        r = p.add_run(part)
        r.bold = (i % 2 == 1)


doc = Document()
st = doc.styles['Normal']
st.font.name = 'Aptos'
st.font.size = Pt(11)
for head, items in SCRIPT:
    hp = doc.add_paragraph()
    r = hp.add_run(head); r.bold = True; r.font.highlight_color = WD_COLOR_INDEX.GRAY_25
    for it in items:
        if isinstance(it, list):
            for b in it:
                p = doc.add_paragraph(style='List Bullet')
                p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
                add_runs(p, b)
        else:
            p = doc.add_paragraph()
            p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
            add_runs(p, it)
doc.save('guion.docx')
