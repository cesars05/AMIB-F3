def emu_in(v):
    return int(v * IN)


def kla_slide(s, title, subtitle, footer, top_paras, boxes, logo_blob, logo_w):
    set_simple_text(shape_by_name(s, 'Title 2'), title)
    set_simple_text(shape_by_name(s, 'Subtitle 1'), subtitle)
    set_simple_text(shape_by_name(s, 'Text Placeholder 35'), footer)
    for nm in ('Rectangle 7', 'Rectangle 10', 'Rectangle 16', 'Rectangle 18', 'Picture 6'):
        delete(shape_by_name(s, nm))
    top = shape_by_name(s, 'Text Placeholder 8')
    set_geom(top, x=emu_in(0.575), y=emu_in(1.479), w=emu_in(7.995), h=emu_in(2.036))
    write_paras(top, top_paras)
    for k, (head, fill, label, paras) in enumerate(boxes):
        x = emu_in(0.575 + k * 2.748)
        h = add_rect(s, x, emu_in(3.638), emu_in(2.499), emu_in(0.5), fill=fill, line='000000')
        fill_shape_text(h, [mk_para([(head, {'b': True, 'color': 'FFFFFF', 'size': 13})], size=13, bullet=False, algn='ctr')])
        add_textbox(s, x, emu_in(4.15), emu_in(2.499), emu_in(0.26),
                    [mk_para([I(label, size=12)], size=12, bullet=False, algn='ctr')])
        b = add_rect(s, x, emu_in(4.422), emu_in(2.499), emu_in(2.083), fill='FFFFFF', line=NAVY)
        fill_shape_text(b, paras, anchor=MSO_ANCHOR.TOP, margins=(91440, 64008, 91440, 45720))
    pic = s.shapes.add_picture(io.BytesIO(logo_blob), emu_in(9.35), emu_in(1.9), width=emu_in(logo_w))
    return pic


def bx(runs, spc=0):
