def add_runs(p, text):
    for seg in re.split(r'(\[\[.*?\]\])', text):
        opt = seg.startswith('[[')
        if opt: seg = seg[2:-2]
        for i, part in enumerate(re.split(r'\*\*', seg)):
            if not part: continue
            r = p.add_run(part); r.bold = (i % 2 == 1)
            if opt: r.font.highlight_color = WD_COLOR_INDEX.YELLOW


