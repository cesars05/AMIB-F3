        d = ld.get_data(universe=["MU.OQ"], fields=campos)
        print(f"  OK {etq}: {len(d)} filas")
        print(d.head(6).to_string(index=False))
    except Exception as e:
        print(f"  -- {etq}: {str(e)[:130]}")
ld.close_session()
