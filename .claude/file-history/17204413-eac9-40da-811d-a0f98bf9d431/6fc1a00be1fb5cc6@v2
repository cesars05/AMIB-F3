for campos, etq in ((["TR.InvestorFullName", "TR.SharesHeld", "TR.HoldingsDate"], "holders de un RIC"),
                    (["TR.PctOfSharesOutHeld", "TR.InvestorType"], "tipo de inversionista"),
                    (["TR.SharesHeldValue", "TR.SharesHeldChange"], "cambio en tenencia")):
