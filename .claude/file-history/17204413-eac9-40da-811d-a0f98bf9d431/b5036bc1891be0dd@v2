"""Que sourceCodes trae el feed, para armar la whitelist."""
import lseg.data as ld
from lseg.data import news
import warnings; warnings.filterwarnings("ignore")
import pandas as pd, sys, collections
try:
    sys.stdout.reconfigure(encoding="utf-8")
except Exception:
    pass
pd.set_option("display.width", 240, "display.max_colwidth", 110)
ld.open_session()

RICS = {"AVGO.OQ": "Broadcom", "ADI.OQ": "Analog Devices", "CLS.N": "Celestica",
        "ONTO.N": "Onto Innovation", "GEV.N": "GE Vernova", "NEE.N": "NextEra"}

cuenta = collections.Counter()
muestras = {}
for ric, nombre in RICS.items():
    try:
        h = news.get_headlines(f"R:{ric} AND Language:LEN", count=40)
        print(f"{nombre:18s} {len(h):3d} titulares")
        for _, r in h.iterrows():
            sc = str(r.get("sourceCode", "?"))
            cuenta[sc] += 1
            muestras.setdefault(sc, str(r.get("headline", ""))[:100])
    except Exception as e:
        print(f"{nombre:18s} -- {str(e)[:90]}")

print(f"\n{'sourceCode':34s} {'n':>4s}  ejemplo")
print("-" * 150)
for sc, n in cuenta.most_common(40):
    print(f"{sc:34s} {n:4d}  {muestras[sc]}")
ld.close_session()
