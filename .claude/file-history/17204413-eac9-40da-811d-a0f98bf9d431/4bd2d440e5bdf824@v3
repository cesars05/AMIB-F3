CRACK = {"RBc1": PRC, "HOc1": PRC, "CLc1": PRC}


# ---------------------------------------------------------------------------
# Bajada de datos: una sola pasada, deduplicando (ric, campo)
# ---------------------------------------------------------------------------
def rics_necesarios(seleccion):
    pares = set()
    for nombre in seleccion:
        cfg = INDICADORES[nombre]
        if "ric" in cfg:
            pares.add((cfg["ric"], cfg["campo"]))
        elif cfg["calc"] == "crack321":
            pares.update(CRACK.items())
        else:
            a, ca, _, b, cb = cfg["calc"]
            pares.update({(a, ca), (b, cb)})
    return pares


def bajar(pares, inicio, fin):
    """Agrupa por campo para minimizar llamadas; devuelve {(ric, campo): Series}."""
    series = {}
    por_campo = {}
    for ric, campo in pares:
        por_campo.setdefault(campo, []).append(ric)

    for campo, rics in por_campo.items():
        print(f"  bajando {len(rics):2d} RICs con {campo}...")
        d = ld.get_history(universe=rics, fields=[campo], interval="daily",
                            start=inicio, end=fin)
        for ric in rics:
            try:
                if isinstance(d.columns, pd.MultiIndex):
                    s = d[ric][campo]
                elif len(rics) == 1:
                    s = d.iloc[:, 0]
                else:
                    s = d[ric]
                s = s.astype(float).dropna()
                if len(s):
                    series[(ric, campo)] = s
                else:
                    print(f"    -- {ric} sin datos")
            except Exception:
                print(f"    -- {ric} no disponible")
    return series


def construir(nombre, series):
    """Resuelve un indicador a una sola Series, ya sea directo o calculado."""
    cfg = INDICADORES[nombre]

    if "ric" in cfg:
        return series.get((cfg["ric"], cfg["campo"]))

    if cfg["calc"] == "crack321":
        try:
            rb, ho, cl = (series[(r, c)] for r, c in CRACK.items())
        except KeyError:
            return None
        # RBOB y HO cotizan en $/galon -> x42 para pasarlos a $/barril antes de
        # restar el crudo. Sin la conversion el spread sale en -101 en vez de +65.
        # Ojo: son contratos continuos con fechas de roll distintas entre si,
        # asi que la serie tiene saltos espurios en los rolls. No se corrige.
        idx = cl.index
        rb = rb.reindex(idx).ffill()
        ho = ho.reindex(idx).ffill()
        return ((2 * rb * GAL_POR_BBL + ho * GAL_POR_BBL - 3 * cl) / 3).dropna()

    a, ca, op, b, cb = cfg["calc"]
    sa, sb = series.get((a, ca)), series.get((b, cb))
    if sa is None or sb is None:
        return None
    sb = sb.reindex(sa.index).ffill()
    s = (sa - sb) if op == "-" else (sa / sb)
    return (s * cfg.get("escala", 1)).dropna()


