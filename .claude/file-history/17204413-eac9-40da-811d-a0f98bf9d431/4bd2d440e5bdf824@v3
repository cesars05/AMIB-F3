def valor_base(serie, antes_de):
    """Ultimo cierre ESTRICTAMENTE anterior al inicio del periodo.

    Es la convencion de Workspace: el retorno YTD se mide contra el cierre del
    anio previo, no contra el primer dato dentro del rango.
    """
    previos = serie[serie.index < antes_de]
    return previos.iloc[-1] if not previos.empty else serie.iloc[0]


def graficar(serie, cfg, archivo, inicio_ytd, inicio_mtd):
    s_ytd = serie[serie.index >= inicio_ytd]
    s_mtd = s_ytd[s_ytd.index >= inicio_mtd]
    color = PALETA[cfg.get("color", "azul")]
    fmt = cfg["fmt"]

    fig, ax = plt.subplots(figsize=TAMANO, dpi=300)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_color(PALETA["eje"])
    ax.spines["bottom"].set_color(PALETA["eje"])
    ax.tick_params(axis="both", length=3, color=PALETA["eje"],
                   labelsize=6.5, labelcolor="black")

    if len(s_mtd):
        ax.axvspan(s_mtd.index[0], s_ytd.index[-1], color="#D9D9D9", alpha=0.5, zorder=0)

    if cfg.get("tipo") == "area":
        # En un spread la referencia relevante es el cero, no la media
        ax.axhline(0, color=PALETA["eje"], linewidth=0.9, zorder=2)
        ax.fill_between(s_ytd.index, 0, s_ytd.values, color=color, alpha=0.18, zorder=2)
        ax.plot(s_ytd.index, s_ytd.values, color=color, linewidth=1.3, zorder=3)
        ax.set_ylim(bottom=min(0, s_ytd.min() * 1.05))
    elif cfg.get("sigma", True):
        # OJO: la banda es media +/- 1 sigma de TODO el periodo. Si la serie
        # tuvo un quiebre de regimen (Gold/Oil paso de 78 a 50 en dias en
        # marzo), la media queda a caballo del quiebre y la banda no dice
        # nada. Revisar el panel antes de publicarlo.
        banda_sigma(ax, s_ytd, fontsize=5.5)
        ax.plot(s_ytd.index, s_ytd.values, color=color, linewidth=1.3, zorder=3)
    else:
        ax.plot(s_ytd.index, s_ytd.values, color=color, linewidth=1.3, zorder=3)

    primeros = s_ytd.index.to_series().groupby(s_ytd.index.to_period("M")).first()
    ax.set_xticks(primeros.values)
    ax.set_xticklabels([d.strftime("%b") for d in primeros.index.to_timestamp()])
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: fmt.format(v)))
    ax.margins(x=0)

    ax.annotate(fmt.format(s_ytd.iloc[-1]), xy=(s_ytd.index[-1], s_ytd.iloc[-1]),
                xytext=(4, 0), textcoords="offset points", va="center", ha="left",
                fontsize=6.5, fontweight="bold", color=color, annotation_clip=False)

    fig.savefig(archivo, dpi=300, bbox_inches="tight", pad_inches=0.02)
    plt.close(fig)
    return s_ytd


def fmt_seguro(fmt, valor):
    try:
        return fmt.format(valor)
    except (ValueError, TypeError):
        return str(valor)


