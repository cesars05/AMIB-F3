# Render del tier macro (barras/lineas mensuales, ventana en meses)
# ---------------------------------------------------------------------------
MESES_MACRO = 24


def graficar_macro(serie, cfg, archivo):
    """Ultimos MESES_MACRO meses. Barras para cambios, linea para niveles.

    Sin banda sigma y sin sombreado del mes en curso: ninguno de los dos
    significa nada sobre ~24 observaciones mensuales de un cambio MM.
    """
    corte = serie.index[-1] - pd.DateOffset(months=MESES_MACRO)
    s = serie[serie.index >= corte]
    color = PALETA[cfg.get("color", "azul")]
    fmt = cfg["fmt"]

    fig, ax = plt.subplots(figsize=TAMANO, dpi=300)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_color(PALETA["eje"])
    ax.spines["bottom"].set_color(PALETA["eje"])
    ax.tick_params(axis="both", length=3, color=PALETA["eje"],
                   labelsize=6.5, labelcolor="black")

    if cfg.get("referencia") is not None:
        # Los PMI se leen contra 50: arriba expansion, abajo contraccion
        ax.axhline(cfg["referencia"], color=PALETA["gris"], linewidth=0.9,
                   linestyle="--", zorder=2)
        ax.text(s.index[0], cfg["referencia"], " %g" % cfg["referencia"],
                color=PALETA["gris"], fontsize=5.5, va="bottom", ha="left")

    if cfg["forma"] == "barra":
        # Verde/rojo segun signo: en un cambio MM el signo es la lectura
        colores = [PALETA["verde"] if v >= 0 else PALETA["rojo"] for v in s.values]
        ancho = max(10, int(420 / max(len(s), 1)))
        ax.bar(s.index, s.values, color=colores, width=ancho, zorder=3)
        ax.axhline(0, color=PALETA["eje"], linewidth=0.9, zorder=4)
    else:
        ax.plot(s.index, s.values, color=color, linewidth=1.4, zorder=3)

    # Un tick por observacion satura el eje; se marca ~cada trimestre
    paso = max(1, len(s) // 8)
    ticks = list(s.index[::paso])
    ax.set_xticks(ticks)
    ax.set_xticklabels([d.strftime("%b-%y") for d in ticks], fontsize=6)
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: fmt.format(v)))

    ax.annotate(fmt.format(s.iloc[-1]), xy=(s.index[-1], s.iloc[-1]),
                xytext=(4, 0), textcoords="offset points", va="center", ha="left",
                fontsize=6.5, fontweight="bold", color=PALETA["negro"],
                annotation_clip=False)

    fig.savefig(archivo, dpi=300, bbox_inches="tight", pad_inches=0.02)
    plt.close(fig)
    return s


def correr_macro(seleccion):
    """Bajada + render del tier macro. Devuelve el dict de resultados."""
    os.makedirs(SALIDA + "/macro", exist_ok=True)
    resultados, sin_datos = {}, []

    for nombre in seleccion:
        cfg = MACRO[nombre]
        try:
            # SIN interval y SIN fields: son series mensuales, no diarias.
            # Pasarles interval="daily" devuelve vacio (el bug del barrido viejo).
            d = ld.get_history(universe=[cfg["ric"]], start="2022-01-01",
                               end=datetime.now().strftime("%Y-%m-%d"))
            s = d.iloc[:, 0].astype(float).dropna() * cfg.get("escala", 1)
        except Exception:
            s = None
        if s is None or len(s) < 3:
            sin_datos.append(nombre)
            continue

        archivo = SALIDA + "/macro/" + nombre + ".png"
        graficar_macro(s, cfg, archivo)

        ultimo, prior = float(s.iloc[-1]), float(s.iloc[-2])
        prom3 = float(s.iloc[-3:].mean())
        f = cfg["fmt"]
        # Sin YTD/MTD: el % YTD de un cambio mensual seria el cambio de un cambio
        resumen = "%s: %s (prior %s; 3m avg %s)" % (
            s.index[-1].strftime("%b-%y"), f.format(ultimo), f.format(prior), f.format(prom3))
        resultados[nombre] = {
            "titulo": cfg["titulo"], "ric": cfg["ric"], "archivo": archivo,
            "tier": "macro", "last": round(ultimo, 4), "prior": round(prior, 4),
            "prom_3": round(prom3, 4), "fecha": str(s.index[-1].date()),
            "resumen": resumen,
        }
        print("OK  %-44s %s" % (cfg["titulo"], resumen))

    if sin_datos:
        print("\\nSin datos (%d): %s" % (len(sin_datos), ", ".join(sin_datos)))
    return resultados


def guardar(resultados):
    """Merge, no sobrescritura: una corrida con --solo o --tier macro no debe
    borrar del JSON los indicadores que no pidio. El deck lo lee completo."""
    acumulado = {}
    if os.path.exists("datos_indicadores.json"):
        try:
            with open("datos_indicadores.json", encoding="utf-8") as f:
                acumulado = json.load(f)
        except (ValueError, OSError):
            acumulado = {}
    acumulado.update(resultados)
    with open("datos_indicadores.json", "w", encoding="utf-8") as f:
        json.dump(acumulado, f, indent=2, ensure_ascii=False)


def main():'''

