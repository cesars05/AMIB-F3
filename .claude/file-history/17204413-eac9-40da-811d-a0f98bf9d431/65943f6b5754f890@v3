hoy = datetime.now()
inicio_ytd = f"{hoy.year}-01-01"
fin = hoy.strftime("%Y-%m-%d")
trimestre = (hoy.month - 1) // 3 * 3 + 1
PERIODOS = {
    "1W":  (hoy - timedelta(days=7)).strftime("%Y-%m-%d"),
    "MTD": hoy.replace(day=1).strftime("%Y-%m-%d"),
    "QTD": hoy.replace(month=trimestre, day=1).strftime("%Y-%m-%d"),
    "YTD": inicio_ytd,
}
BENCHMARK = (".SPX", "S&P 500")


def valor_base(serie, antes_de):
    """Ultimo cierre estrictamente anterior al inicio del periodo."""
    previos = serie[serie.index < antes_de]
    return previos.iloc[-1] if not previos.empty else serie.iloc[0]


universo = list(rics.values()) + [BENCHMARK[0]]
d = ld.get_history(universe=universo, fields=["TRDPRC_1"], interval="daily",
                    start=f"{hoy.year - 1}-12-01", end=fin)

series = {}
for ric in universo:
    try:
        s = (d[ric]["TRDPRC_1"] if isinstance(d.columns, pd.MultiIndex)
             else d[ric]).astype(float).dropna()
        if len(s) > 5:
            series[ric] = s
    except Exception:
        pass

sin_datos = [s for s, r in rics.items() if r not in series]
if sin_datos:
    print(f"  Sin serie: {', '.join(sin_datos)}")

filas = {}
for simbolo, ric in rics.items():
    if ric not in series:
        continue
    s = series[ric]
    ult = float(s.iloc[-1])
    filas[simbolo] = {p: (ult / float(valor_base(s, i)) - 1) * 100
                      for p, i in PERIODOS.items()}

s_b = series[BENCHMARK[0]]
ult_b = float(s_b.iloc[-1])
filas_bmk = {p: (ult_b / float(valor_base(s_b, i)) - 1) * 100
             for p, i in PERIODOS.items()}

# Ordenada por PESO, no por retorno: en un portafolio lo primero que se lee es
# donde esta el dinero
orden = [s for s in pos.index if s in filas]
df = pd.DataFrame(filas).T.loc[orden, list(PERIODOS)]
