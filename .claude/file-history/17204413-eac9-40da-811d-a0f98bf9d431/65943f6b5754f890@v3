def leer_estado(ruta):
    """Parsea el CSV de IBKR: cada fila arranca con seccion y Header/Data.

    Una seccion puede traer VARIOS encabezados. "Net Asset Value", por
    ejemplo, trae la tabla por clase de activo y despues otro encabezado
    suelto con el Time Weighted Rate of Return. Por eso cada Header abre un
    bloque nuevo en vez de sobrescribir al anterior.
    """
    secciones = {}
    with open(ruta, encoding="utf-8-sig") as f:
        for fila in csv.reader(f):
            if len(fila) < 3:
                continue
            sec, tipo = fila[0], fila[1]
            if tipo == "Header":
                secciones.setdefault(sec, []).append({"cols": fila[2:], "filas": []})
            elif tipo == "Data" and secciones.get(sec):
                secciones[sec][-1]["filas"].append(fila[2:])
    return secciones


def tabla(secciones, nombre, columna=None):
    """Devuelve el bloque de la seccion. Si se pasa `columna`, el primero que
    la contenga; si no, el primero."""
    bloques = secciones.get(nombre, [])
    if not bloques:
        return pd.DataFrame()
    elegido = bloques[0]
    if columna:
        elegido = next((b for b in bloques if columna in b["cols"]), bloques[0])
    ancho = len(elegido["cols"])
    filas = [f[:ancho] + [""] * (ancho - len(f)) for f in elegido["filas"]]
    return pd.DataFrame(filas, columns=elegido["cols"])


def filas_de(secciones, nombre):
    """Todas las filas Data de la seccion, sin importar el bloque."""
    return [f for b in secciones.get(nombre, []) for f in b["filas"]]


def num(x):
    try:
        return float(str(x).replace(",", ""))
    except (ValueError, TypeError):
        return float("nan")


print(f"Leyendo {os.path.basename(ESTADO)}...")
sec = leer_estado(ESTADO)

periodo = ""
for f in filas_de(sec, "Statement"):
    if f[0] == "Period":
        periodo = f[1]

# --- posiciones abiertas ---------------------------------------------------
pos = tabla(sec, "Open Positions")
pos = pos[pos["DataDiscriminator"] == "Summary"].copy()
for c in ("Quantity", "Cost Price", "Cost Basis", "Close Price", "Value",
          "Unrealized P/L"):
    pos[c] = pos[c].map(num)
pos = pos.dropna(subset=["Value"]).set_index("Symbol")

# --- bolsa y nombre de cada simbolo ----------------------------------------
info = tabla(sec, "Financial Instrument Information")
bolsas = dict(zip(info["Symbol"], info["Listing Exch"]))
nombres = dict(zip(info["Symbol"], info["Description"]))
rics = {s: s + BOLSA_A_SUFIJO.get(bolsas.get(s, ""), ".OQ") for s in pos.index}

# --- NAV, TWR y flujos -----------------------------------------------------
nav = tabla(sec, "Net Asset Value", columna="Asset Class")
total_nav = num(nav[nav["Asset Class"] == "Total"]["Current Total"].iloc[0])
twr = None
for f in filas_de(sec, "Net Asset Value"):
    # El TWR viene en su propio bloque, como unico valor con signo de %
    if f and str(f[0]).rstrip("%").replace(".", "").replace("-", "").isdigit():
        twr = num(str(f[0]).rstrip("%"))
cambio = {f[0]: num(f[1]) for f in filas_de(sec, "Change in NAV")}

valor_mercado = float(pos["Value"].sum())
pos["peso"] = pos["Value"] / valor_mercado * 100
pos["ret_vs_costo"] = (pos["Close Price"] / pos["Cost Price"] - 1) * 100
pos = pos.sort_values("Value", ascending=False)

print(f"  {len(pos)} posiciones, valor de mercado {valor_mercado:,.2f} USD")
print(f"  NAV {total_nav:,.2f} USD   TWR del periodo {twr:.2f}%")


