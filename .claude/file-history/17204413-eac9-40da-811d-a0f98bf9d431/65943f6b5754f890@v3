def barras_h(valores, etiquetas, archivo, fmt, color_fijo=None):
    fig, ax = plt.subplots(figsize=(4.25, 2.55), dpi=300)
    colores = color_fijo or colores_por_signo(valores)
    ax.barh(range(len(valores)), valores, color=colores, height=0.72, zorder=3)
    if min(valores) < 0:
        ax.axvline(0, color=PALETA["eje"], linewidth=0.9, zorder=4)
    for lado in ("top", "right", "bottom", "left"):
        ax.spines[lado].set_visible(False)
    ax.set_xticks([])
    ax.set_yticks(range(len(valores)))
    ax.set_yticklabels(etiquetas, fontsize=6.5)
    ax.tick_params(axis="y", length=0, labelcolor=PALETA["texto"])
    ax.invert_yaxis()

    rango = max(valores) - min(min(valores), 0)
    margen = rango * 0.02
    for y, v in enumerate(valores):
        ax.text(v + (margen if v >= 0 else -margen), y, fmt.format(v),
                va="center", ha="left" if v >= 0 else "right", fontsize=6,
                fontweight="bold", color=PALETA["texto"])
    ax.set_xlim(min(min(valores), 0) - rango * 0.28, max(valores) + rango * 0.28)
    fig.savefig(f"{SALIDA}/{archivo}", dpi=300, bbox_inches="tight", pad_inches=0.02)
    plt.close(fig)


barras_h(pos["peso"].values, list(pos.index), "Pesos.png", "{:.1f}%",
