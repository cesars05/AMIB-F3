# ---------------------------------------------------------------------------
# P/E forward historico
# ---------------------------------------------------------------------------
def serie_pe(rics):
    """TR.FwdPE semanal. Devuelve DataFrame fechas x RIC.

    get_data apila los RICs en filas sin columna de fecha utilizable, asi que
    se reconstruye el eje con bdate_range sobre el conteo por instrumento.
    """
    d = ld.get_data(universe=list(rics), fields=["TR.FwdPE"],
                    parameters={"SDate": inicio_pe, "EDate": fin, "Frq": "W"})
    d.columns = ["ric", "pe"]
    out = {}
    for ric in rics:
        s = d[d["ric"] == ric]["pe"].astype(float).reset_index(drop=True)
        if s.notna().sum() < 10:
            print(f"    -- {ric} sin P/E forward")
            continue
        out[ric] = s
    if not out:
        return pd.DataFrame()
    n = max(len(s) for s in out.values())
    idx = pd.bdate_range(end=hoy, periods=n, freq="W-FRI")
    return pd.DataFrame({r: s.reindex(range(n)).values for r, s in out.items()},
                        index=idx)


def grafico_pe(df, nombres, titulo_archivo, etiqueta_prom="2Y Average"):
    fig, ax = plt.subplots(figsize=ANCHO, dpi=300)
    ejes_limpios(ax, labelsize=6.5)

    for (ric, color) in zip(df.columns, CICLO_COLORES):
        s = df[ric].dropna()
        ax.plot(s.index, s.values, color=PALETA[color], linewidth=1.3,
                label=nombres[ric], zorder=3)

    prom = float(df.stack().mean())
    linea_referencia(ax, prom, f"{etiqueta_prom}, {prom:.1f}x", fontsize=6,
                     x=df.index[0])

    # Un tick por trimestre, formato Mon-YY (el default sale como "2024-10")
    trims = df.index.to_series().groupby(df.index.to_period("Q")).first()
    # El primer trimestre cae pegado al eje Y y su etiqueta se encima con el
    # origen; se omite.
    trims = trims.iloc[1:]
    ax.set_xticks(trims.values)
    ax.set_xticklabels([x.strftime("%b-%y") for x in trims.index.to_timestamp()],
                       fontsize=6)
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"{v:.0f}x"))
    ax.margins(x=0)
    ax.legend(loc="upper left", frameon=False, fontsize=6, ncol=3,
              handlelength=1.4, borderpad=0.2, columnspacing=1.0)
    ax.set_ylim(bottom=0)

    fig.savefig(f"{SALIDA}/{titulo_archivo}", dpi=300, bbox_inches="tight",
                pad_inches=0.02)
    plt.close(fig)
    return prom


# ---------------------------------------------------------------------------
# Retornos
# ---------------------------------------------------------------------------
def valor_base(serie, antes_de):
    previos = serie[serie.index < antes_de]
    return previos.iloc[-1] if not previos.empty else serie.iloc[0]


def retornos(nombres):
    d = ld.get_history(universe=list(nombres), fields=["TRDPRC_1"],
                        interval="daily", start=f"{hoy.year - 1}-12-01", end=fin)
    filas = {}
    for ric in nombres:
        try:
            s = (d[ric]["TRDPRC_1"] if isinstance(d.columns, pd.MultiIndex)
                 else d[ric]).astype(float).dropna()
        except Exception:
            continue
        if len(s) < 5:
            continue
        ult = float(s.iloc[-1])
        filas[nombres[ric]] = {p: (ult / float(valor_base(s, i)) - 1) * 100
                               for p, i in PERIODOS.items()}
    return pd.DataFrame(filas).T[list(PERIODOS)]


