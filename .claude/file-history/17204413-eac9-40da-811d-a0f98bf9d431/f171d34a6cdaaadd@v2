# Pares que normalmente se mueven juntos. Cuando se separan, eso ES la noticia.
PARES = [
    ("SOX Index", "Nasdaq 100", "semis vs Nasdaq"),
    ("HYG", "LQD", "credito high yield vs grado de inversion"),
