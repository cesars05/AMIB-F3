    <style>
        :root {
            --bb-black: #000000;
            --bb-dark-grey: #0A0A0A;
            --bb-mid-grey: #1A1A1A;
            --bb-orange: #FF9900;
            --bb-blue: #0055FF;
            --bb-green: #00FF00;
            --bb-red: #FF0000;
            --bb-white: #FFFFFF;
            --bb-light-grey: #888888;
            --border-color: #333333;
        }
        body {
            font-family: 'Segoe UI', 'Roboto', 'Courier New', monospace;
            background-color: var(--bb-black);
            color: var(--bb-white);
            margin: 0;
            padding: 0;
            line-height: 1.4;
        }
        .container {
            max-width: 1500px;
            margin: 0 auto;
            padding: 30px;
        }
        header {
            border-bottom: 5px solid var(--bb-orange);
            padding-bottom: 20px;
            margin-bottom: 40px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        .header-title h1 {
            font-size: 2.8rem;
            margin: 0;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -1.5px;
            color: var(--bb-white);
        }
        .header-title .kicker {
            color: var(--bb-orange);
            font-size: 1.1rem;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 5px;
        }
        .header-meta {
            text-align: right;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.9rem;
            color: var(--bb-light-grey);
            line-height: 1.3;
        }
        .section {
            margin-bottom: 80px;
        }
        .section-header {
            display: flex;
            align-items: center;
            margin-bottom: 30px;
        }
        .section-header h2 {
            font-size: 1.6rem;
            margin: 0;
            text-transform: uppercase;
            background: var(--bb-orange);
            color: var(--bb-black);
            padding: 6px 20px;
            font-weight: 900;
        }
        .section-header .section-desc {
            margin-left: 25px;
            color: var(--bb-light-grey);
            font-size: 1.1rem;
            font-style: italic;
        }
        .bb-table {
            width: 100%;
            border-collapse: collapse;
            font-family: 'Courier New', Courier, monospace;
            border: 1px solid var(--border-color);
            background-color: var(--bb-black);
        }
        .bb-table th {
            background-color: var(--bb-mid-grey);
            color: var(--bb-orange);
            text-align: left;
            padding: 15px;
            font-size: 0.9rem;
            border: 1px solid var(--border-color);
            text-transform: uppercase;
        }
        .bb-table td {
            padding: 12px 15px;
            border: 1px solid var(--border-color);
            font-size: 1rem;
        }
        .bb-table tr:hover {
            background-color: #111;
        }
        .val-pos { color: var(--bb-green); font-weight: bold; }
        .val-neg { color: var(--bb-red); font-weight: bold; }
        .val-accent { color: var(--bb-orange); font-weight: bold; }

        .chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 30px;
        }
        .chart-card {
            background: var(--bb-dark-grey);
            border: 1px solid var(--border-color);
            padding: 25px;
            border-radius: 4px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.7);
        }
        .chart-card h3 {
            margin: 0 0 20px 0;
            font-size: 1.3rem;
            color: var(--bb-orange);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 12px;
            text-transform: uppercase;
        }
        .chart-card img {
            width: 100%;
            height: auto;
            border: 1px solid #222;
        }
        .deep-dive-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 40px;
        }
        .deep-dive-card {
            background: var(--bb-dark-grey);
            border: 1px solid var(--border-color);
            padding: 30px;
            border-radius: 8px;
            border-top: 6px solid var(--bb-orange);
        }
        .deep-dive-card h3 {
            margin: 0 0 20px 0;
            font-size: 1.7rem;
            color: var(--bb-white);
        }
        .metric-row {
            display: flex;
            justify-content: space-between;
            font-size: 1rem;
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 8px;
        }
        .metric-label { color: var(--bb-light-grey); }
        .metric-value { color: var(--bb-orange); font-weight: bold; }
        footer {
            margin-top: 100px;
            padding: 40px;
            text-align: center;
            font-size: 0.9rem;
            color: var(--bb-light-grey);
            border-top: 1px solid var(--border-color);
            font-family: 'Courier New', Courier, monospace;
        }
        @media print {
            body { background: white; color: black; }
            .container { width: 100%; margin: 0; }
            header, .section, .chart-card, .deep-dive-card { background: white !important; color: black !important; border: 1px solid #ccc !important; }
            .bb-table th { background: #eee !important; color: black !important; }
            .bb-table td { color: black !important; border: 1px solid #ccc !important; }
            .val-pos { color: green !important; }
            .val-neg { color: red !important; }
            .val-accent { color: #c00 !important; }
            .section-header h2 { background: #eee !important; color: black !important; }
        }
    </style>
</head>
