<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deep Value AI - Bloomberg Elite Edition</title>
    <style>
        :root {
            /* Bloomberg Terminal Palette */
            --bloomberg-black: #000000;
            --bloomberg-dark-grey: #1a1a1a;
            --bloomberg-mid-grey: #333333;
            --bloomberg-orange: #ff9900;
            --bloomberg-blue: #0055ff;
            --bloomberg-green: #00ff00;
            --bloomberg-red: #ff0000;
            --bloomberg-white: #ffffff;
            --bloomberg-light-grey: #cccccc;
            --border-color: #444444;
        }
        body {
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            background-color: var(--bloomberg-black);
            color: var(--bloomberg-white);
            margin: 0;
            padding: 0;
            line-height: 1.4;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        header {
            border-bottom: 3px solid var(--bloomberg-orange);
            padding-bottom: 20px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        .header-title h1 {
            font-size: 2.2rem;
            margin: 0;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -1px;
        }
        .header-title .kicker {
            color: var(--bloomberg-orange);
            font-size: 0.9rem;
            font-weight: bold;
            text-transform: uppercase;
        }
        .header-meta {
            text-align: right;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.8rem;
            color: var(--bloomberg-light-grey);
        }
        .section {
            margin-bottom: 40px;
        }
        .section-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        .section-header h2 {
            font-size: 1.4rem;
            margin: 0;
            color: var(--bloomberg-white);
            text-transform: uppercase;
            background: var(--bloomberg-orange);
            color: var(--bloomberg-black);
            padding: 4px 12px;
            font-weight: 800;
        }
        .section-header .section-desc {
            margin-left: 15px;
            color: var(--bloomberg-light-grey);
            font-size: 0.9rem;
            font-style: italic;
        }

        /* Bloomberg Table Style */
        .bloomberg-table {
            width: 100%;
            border-collapse: collapse;
            font-family: 'Courier New', Courier, monospace;
            border: 1px solid var(--border-color);
            background-color: var(--bloomberg-black);
        }
        .bloomberg-table th {
            background-color: var(--bloomberg-mid-grey);
            color: var(--bloomberg-orange);
            text-align: left;
            padding: 8px 12px;
            font-size: 0.85rem;
            border: 1px solid var(--border-color);
            text-transform: uppercase;
        }
        .bloomberg-table td {
            padding: 6px 12px;
            border: 1px solid var(--border-color);
            font-size: 0.9rem;
        }
        .bloomberg-table tr:hover {
            background-color: #222;
        }
        .val-pos { color: var(--bloomberg-green); }
        .val-neg { color: var(--bloomberg-red); }
        .val-bold { font-weight: bold; color: var(--bloomberg-orange); }

        /* Chart Grid */
        .chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 20px;
        }
        .chart-card {
            background: var(--bloomberg-dark-grey);
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 4px;
        }
        .chart-card h3 {
            margin: 0 0 15px 0;
            font-size: 1.1rem;
            color: var(--bloomberg-orange);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
        }
        .chart-card img {
            width: 100%;
            height: auto;
            filter: brightness(0.8) contrast(1.2);
        }

        /* Deep Dive Cards */
        .deep-dive-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }
        .deep-dive-card {
            background: var(--bloomberg-dark-grey);
            border: 1px solid var(--border-color);
            padding: 20px;
            border-radius: 8px;
            position: relative;
        }
        .deep-dive-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0;
            width: 4px; height: 100%;
            background: var(--bloomberg-orange);
        }
        .deep-dive-card h3 {
            margin: 0 0 10px 0;
            font-size: 1.3rem;
            color: var(--bloomberg-white);
        }
        .deep-dive-card .metric {
            font-size: 0.8rem;
            color: var(--bloomberg-light-grey);
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
        }

        footer {
            margin-top: 50px;
            padding: 20px;
            text-align: center;
            font-size: 0.7rem;
            color: var(--bloomberg-light-grey);
            border-top: 1px solid var(--border-color);
        }

        @media print {
            body { background: white; color: black; }
            .container { width: 100%; margin: 0; }
            header, .section, .chart-card, .deep-dive-card {
                background: white !important;
                color: black !important;
                border: 1px solid #ccc !important;
            }
            .bloomberg-table th { background: #eee !important; color: black !important; }
            .bloomberg-table td { color: black !important; }
            .val-pos { color: green !important; }
            .val-neg { color: red !important; }
            .val-bold { color: #c00 !important; }
            .section-header h2 { background: #eee !important; color: black !important; }
            .subtitle { color: #666 !important; }
        }
    </style>
</head>
