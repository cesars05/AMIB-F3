    if isinstance(v, str) and v.startswith('='):
        c.Formula = v
    else:
        c.Value = v
    if nf:
        c.NumberFormat = nf
    if color is not None:
        c.Font.Color = color
    if bold is not None:
        c.Font.Bold = bold
    if italic is not None:
        c.Font.Italic = italic
    return c


