def put(ws, ref, v, fmt=None, bold=False, font=None, fill=None, wrap=False, align=None):
    c = ws[ref]
    c.value = v
    if font:
        c.font = font
    elif isinstance(v, str) and v.startswith("="):
        c.font = BOLD if bold else BLK
    elif isinstance(v, (int, float)):
        c.font = Font(name="Arial", size=10, color="0000FF", bold=bold)
    else:
        c.font = BOLD if bold else BLK
    if fmt:
        c.number_format = fmt
    if fill:
        c.fill = fill
    if wrap or align:
        c.alignment = Alignment(wrap_text=wrap, horizontal=align, vertical="top" if wrap else None)
    return c


def header(ws, row, labels, start_col=1):
    for i, t in enumerate(labels):
        c = ws.cell(row=row, column=start_col + i, value=t)
        c.font = HDR
        c.fill = HFILL
        c.alignment = Alignment(horizontal="center" if i else "left", wrap_text=True)


def section(ws, row, text, ncols):
    for i in range(1, ncols + 1):
        ws.cell(row=row, column=i).fill = SFILL
    ws.cell(row=row, column=1, value=text).font = BOLD


