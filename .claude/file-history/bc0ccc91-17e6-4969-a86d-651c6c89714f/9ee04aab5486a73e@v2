def circ(s, x, y, d, label, fill=NAVY_, col=GOLD_, size=14):
    c = label_box(s, x, y, d, d, label, fill=fill, color=col, size=size, shape=MSO_SHAPE.OVAL); return c

def simple_chart(s, kind, x, y, w, h, cats, series, colors, labels=True, legend=False, fmt='General', gap=60):
    cd = CategoryChartData(); cd.categories = cats
    for nm, vals in series: cd.add_series(nm, vals)
    gf = s.shapes.add_chart(kind, Inches(x), Inches(y), Inches(w), Inches(h), cd); ch = gf.chart
    ch.font.size = Pt(11); ch.font.name = "Arial"
    ch.has_legend = legend; ch.has_title = False
    if legend:
        ch.legend.position = XL_LEGEND_POSITION.BOTTOM; ch.legend.include_in_layout = False; ch.legend.font.size = Pt(11)
    pl = ch.plots[0]
    if kind == XL_CHART_TYPE.DOUGHNUT:
        for i, pt in enumerate(pl.series[0].points):
            pt.format.fill.solid(); pt.format.fill.fore_color.rgb = rgb(colors[i])
    else:
        pl.gap_width = gap
        for i, se in enumerate(pl.series):
            se.format.fill.solid(); se.format.fill.fore_color.rgb = rgb(colors[i % len(colors)])
        ch.value_axis.visible = False; ch.value_axis.has_major_gridlines = False
        ch.category_axis.format.line.color.rgb = rgb(GREY2); ch.category_axis.tick_labels.font.size = Pt(11)
    if labels:
        pl.has_data_labels = True; dl = pl.data_labels; dl.font.size = Pt(11); dl.font.bold = True; dl.number_format = fmt; dl.number_format_is_linked = False
        if kind != XL_CHART_TYPE.DOUGHNUT: dl.position = XL_LABEL_POSITION.OUTSIDE_END
        else: dl.font.color.rgb = rgb("#FFFFFF")
    return ch

def table(s, x, y, w, rows, colw, rowh=0.5, size=11, head_fill=NAVY_):
    gf = s.shapes.add_table(len(rows), len(rows[0]), Inches(x), Inches(y), Inches(w), Inches(rowh * len(rows)))
    t = gf.table
    tblPr = gf._element.graphic.graphicData.tbl.tblPr
    for a in ("bandRow", "firstRow"): tblPr.set(a, "0")
    for j, cw in enumerate(colw): t.columns[j].width = Inches(cw)
    for i, r in enumerate(rows):
        t.rows[i].height = Inches(rowh)
        for j, v in enumerate(r):
            c = t.cell(i, j); c.margin_left = c.margin_right = Inches(0.08); c.margin_top = c.margin_bottom = Inches(0.04)
            c.vertical_anchor = MSO_ANCHOR.MIDDLE
            c.fill.solid(); c.fill.fore_color.rgb = rgb(head_fill if i == 0 else (GREY1 if i % 2 == 0 else "#FFFFFF"))
            tf = c.text_frame; tf.word_wrap = True; p = tf.paragraphs[0]
            add_runs(p, v, size, "#FFFFFF" if i == 0 else ink, bold=(i == 0 or j == 0))
    return t

