def mv(src, dst):
    if not os.path.exists(src):
        print("MISSING", src); return
    os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
    shutil.move(src, dst)
    log.append((src, dst))

def mv_doc(src_dir, old_stem, dst_dir, new_stem):
    """Move a converted doc family (pdf/PDF, md, *_figuras*.pdf) and rewrite md refs."""
    moved = []
    for f in os.listdir(src_dir):
        base, ext = os.path.splitext(f)
        if base == old_stem or re.fullmatch(re.escape(old_stem) + r"_figuras(_\d+)?", base):
            suffix = base[len(old_stem):]
            mv(os.path.join(src_dir, f), os.path.join(dst_dir, new_stem + suffix + ext.lower()))
            moved.append(new_stem + suffix + ext.lower())
    md = os.path.join(dst_dir, new_stem + ".md")
    if os.path.exists(md):
        t = open(md, encoding="utf-8").read()
        t = t.replace(old_stem, new_stem)
        open(md, "w", encoding="utf-8", newline="\n").write(t)
    if not moved:
        print("NO FILES for", old_stem)

