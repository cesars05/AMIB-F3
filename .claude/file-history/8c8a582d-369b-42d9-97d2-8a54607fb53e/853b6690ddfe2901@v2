def meta(md):
    t = open(md, encoding="utf-8", errors="replace").read(1500)
    m = re.search(r"paginas:\s*(\d+)", t); f = re.search(r"figuras:\s*(\d+)", t)
    return (m.group(1) if m else "-"), (f.group(1) if f else "0")

