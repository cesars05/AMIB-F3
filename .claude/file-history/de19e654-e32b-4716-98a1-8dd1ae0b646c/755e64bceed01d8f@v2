SECTION = Font(name=FONT_NAME, color="000000", bold=True, size=12)
ITALIC_GRAY = Font(name=FONT_NAME, italic=True, color="595959", size=9)

FILL_TITLE = PatternFill("solid", fgColor="1F4E78")
FILL_HEADER = PatternFill("solid", fgColor="2E75B6")
FILL_INPUT_LABEL = PatternFill("solid", fgColor="D9E1F2")
FILL_TODO = PatternFill("solid", fgColor="FFFF00")
FILL_SECTION = PatternFill("solid", fgColor="BDD7EE")

THIN = Side(style="thin", color="BFBFBF")
