def set_col_widths(ws, widths):
    for i, w in enumerate(widths, start=1):
        ws.column_dimensions[get_column_letter(i)].width = w

def title_bar(ws, text, span, row=1):
    ws.merge_cells(start_row=row, start_column=1, end_row=row, end_column=span)
    c = ws.cell(row=row, column=1, value=text)
    c.font = TITLE
    c.fill = FILL_TITLE
    c.alignment = Alignment(horizontal="left", vertical="center", indent=1)
    ws.row_dimensions[row].height = 26

def section(ws, row, col, text, span=1):
    ws.merge_cells(start_row=row, start_column=col, end_row=row, end_column=col+span-1)
    c = ws.cell(row=row, column=col, value=text)
    c.font = SECTION
    c.fill = FILL_SECTION
    c.alignment = Alignment(horizontal="left", vertical="center", indent=1)

def label(ws, row, col, text, bold=False):
    c = ws.cell(row=row, column=col, value=text)
    c.font = BLACK_BOLD if bold else BLACK
    return c

def input_cell(ws, row, col, value, fmt=None):
    c = ws.cell(row=row, column=col, value=value)
    c.font = BLUE_BOLD
    c.fill = FILL_INPUT_LABEL
    c.border = BORDER
    if fmt:
        c.number_format = fmt
    c.alignment = Alignment(horizontal="center")
    return c

def todo_cell(ws, row, col, fmt=None, note=None):
    c = ws.cell(row=row, column=col, value=None)
    c.fill = FILL_TODO
    c.border = BORDER
    c.font = BLACK
    if fmt:
        c.number_format = fmt
    c.alignment = Alignment(horizontal="center")
    return c

