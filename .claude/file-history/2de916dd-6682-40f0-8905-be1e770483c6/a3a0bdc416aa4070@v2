    for k in ('value_cur', 'value_con', 'value_usd', 'volume', 'unit_price_rsp', 'bimbo_share', 'bimbo_value'):
        v = e[k]
        print(f'  {k:15s}', ' '.join('' if x is None else (f'{x:,.1f}' if abs(x) >= 100 else f'{x:.3f}') for x in (v or [])))
mx = out['euro']['Mexico']
print('FX implied (MXN/USD, Euromonitor):', [round(a / b, 4) if a and b else None for a, b in zip(mx['value_cur'], mx['value_usd'])])
print('FX Bimbo disclosed:              ', [out['fx_bimbo'][y] for y in YRS])
