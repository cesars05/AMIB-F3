def sheet(name, title, source, slide, widths=None):
    ws = wb.create_sheet(name)
    ws.sheet_view.showGridLines = False
    ws.sheet_view.zoomScale = 85
    ws.column_dimensions["A"].width = 3.7
    for col, w in (widths or {}).items():
        ws.column_dimensions[col].width = w
    ws["B2"] = "US Steel Outlook – Data"; ws["B2"].font = F(size=12, bold=True, color=NAVY)
    ws["B3"] = title; ws["B3"].font = F(bold=True)
    ws["B4"] = source; ws["B4"].font = F(size=9, italic=True, color="595959")
    index_rows.append((name, title, slide, source))
    return ws


def header(ws, row, col, labels):
    for i, lab in enumerate(labels):
        c = ws.cell(row, col + i, lab)
        c.font = F(bold=True, color=NAVY); c.fill = HDR_FILL
        c.border = Border(bottom=thin); c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)


def put(ws, row, col, val, fmt=None, blue=False, bold=False):
    c = ws.cell(row, col, val)
    c.font = F(color=BLUE if blue else "000000", bold=bold)
    if fmt: c.number_format = fmt
    return c


def inp(ws, row, col, label, val, fmt=None):
    ws.cell(row, col, label).font = F(bold=True)
    c = ws.cell(row, col + 1, val); c.font = F(color=BLUE, bold=True); c.fill = IN_FILL
    c.border = Border(top=thin, bottom=thin, left=thin, right=thin)
    if fmt: c.number_format = fmt
    return c


