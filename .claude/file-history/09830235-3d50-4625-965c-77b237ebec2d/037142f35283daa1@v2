def slide(title, subtitle=None, source=None, link=None):
    assert source is None or len(source) <= 95, f"source too long ({len(source)}): {source}"
    s = d.content_slide(title, subtitle, source=source)
    if source and link:
        for ph in s.placeholders:
            if (ph.top or 0) / 914400 > 6.5 and ph.has_text_frame and ph.text_frame.text == source:
                ph.text_frame.paragraphs[0].runs[0].hyperlink.address = link
    return s


def bul(s, x, y, w, h, lines, size=12, spacing=6):
    return d.text(s, x, y, w, h, ["- " + l for l in lines], size=size, align="justify", spacing=spacing)


def exhibit(s, x, y, w, h, name, title, sub, boxes=(), align="center", img_dir=None):
    """Aztlan block header written by us + screenshot without its own title, fitted in the box.
    boxes = [(fx, fy, fw, fh)] fractions of the image -> red dashed focus boxes."""
    y2 = d.block_header(s, x, y, w, title, sub)
    W, H = Image.open((img_dir or IMG) + name).size
    bw, bh = w, y + h - y2 - 0.04
    iw, ih = (bw, bw * H / W) if bw * H / W <= bh else (bh * W / H, bh)
    ix = x + (bw - iw) / 2 if align == "center" else x
    s.shapes.add_picture((img_dir or IMG) + name, Inches(ix), Inches(y2 + 0.02), Inches(iw), Inches(ih))
    for fx, fy, fw, fh in boxes:
        d.dashed_box(s, ix + fx * iw, y2 + 0.02 + fy * ih, fw * iw, fh * ih, color=RED, width=1.5)
    return y2 + 0.02 + ih


def chart_base(gf):
    ch = gf.chart
    return ch


def line_dates(s, x, y, w, h, dates, series, colors, widths, val_fmt, vmin, vmax, major, date_fmt="yyyy", major_unit=("1", "years"),
               labels_end=True, end_fmt="{:+.0%}", legend=False):
    cd = CategoryChartData(); cd.categories = dates
    for n, v in series.items(): cd.add_series(n, v)
    gf = s.shapes.add_chart(XL_CHART_TYPE.LINE, Inches(x), Inches(y), Inches(w), Inches(h), cd); ch = gf.chart
    ch.has_title = False; ch.font.name = "Arial"; ch.font.size = Pt(9)
    ch._chartSpace.find(f"{{{C_NS}}}chart/{{{C_NS}}}autoTitleDeleted").set("val", "1")
    d._no_fill_chart(ch)
    for ser, col, wd in zip(ch.plots[0].series, colors, widths):
        ser.format.line.color.rgb = rgb(col); ser.format.line.width = Pt(wd); ser.smooth = False
        ser.marker.style = XL_MARKER_STYLE.NONE
    va = ch.value_axis; va.minimum_scale, va.maximum_scale, va.major_unit = vmin, vmax, major
    va.has_major_gridlines = True; va.major_gridlines.format.line.color.rgb = rgb("#E6E6E6"); va.major_gridlines.format.line.width = Pt(0.5)
    va.tick_labels.number_format = val_fmt; va.tick_labels.number_format_is_linked = False; va.tick_labels.font.size = Pt(9)
    va.format.line.fill.background(); va.major_tick_mark = XL_TICK_MARK.NONE
    ca = ch.category_axis; ca.tick_labels.font.size = Pt(9); ca.format.line.color.rgb = rgb("#7F7F7F")
    ca.tick_labels.number_format = date_fmt; ca.tick_labels.number_format_is_linked = False
    dax = ch._chartSpace.find(f".//{{{C_NS}}}dateAx")
    if dax is not None:
        for tag, val in (("majorUnit", major_unit[0]), ("majorTimeUnit", major_unit[1])):
            e = dax.find(f"{{{C_NS}}}{tag}")
            if e is None: e = etree.SubElement(dax, f"{{{C_NS}}}{tag}")
            e.set("val", val)
    ch.has_legend = legend
    if legend:
        from pptx.enum.chart import XL_LEGEND_POSITION
        ch.legend.position = XL_LEGEND_POSITION.BOTTOM; ch.legend.include_in_layout = False; ch.legend.font.size = Pt(9)
    if labels_end:
        for (n, v), ser, col in zip(series.items(), ch.plots[0].series, colors):
            k = max(i for i, q in enumerate(v) if q is not None)
            d._custom_label(ser.points[k], f"{n} {end_fmt.format(v[k])}", size=9, bold=True, color=col, pos=XL_LABEL_POSITION.RIGHT)
    return gf, ch


def clustered(s, x, y, w, h, cats, series, colors, fmt, vmin=None, vmax=None, legend=True, label_size=9, gap=80, overlap=-20, horizontal=False,
              layout=None):
    kind = XL_CHART_TYPE.BAR_CLUSTERED if horizontal else XL_CHART_TYPE.COLUMN_CLUSTERED
    if horizontal:
        cats = cats[::-1]; series = {k: v[::-1] for k, v in series.items()}
    gf, ch = d._chart(s, kind, x, y, w, h, cats, series)
    pl = ch.plots[0]; pl.gap_width, pl.overlap = gap, overlap
    allv = [v for vs in series.values() for v in vs]
    d._axis_style(ch, vmin=vmin if vmin is not None else min(0, min(allv) * 1.25), vmax=vmax if vmax is not None else max(allv) * 1.2,
                  label_low=True, cat_size=9)
    d._plot_layout(ch, *(layout or ((0.22, 0.02, 0.72, 0.86) if horizontal else (0.02, 0.06, 0.96, 0.76 if legend else 0.84))))
    for ser, col in zip(pl.series, colors):
        d._fill(ser.format, col)
        d._labels(ser, size=label_size, fmt=fmt, pos=XL_LABEL_POSITION.OUTSIDE_END)
    d._legend(ch, legend)
    return gf, ch


def implication(title, sub, cols, source, bar_text):
    """'What it means' slide: tail bar + 3 boxed columns (ALLOC s16 grammar)."""
    s = slide(title, sub, source=source)
    y = d.tail_bar(s, 0.575, 1.6, 12.3, bar_text, h=0.5, fill=NAVY, size=14)
    cw, gap = 3.95, (12.302 - 3 * 3.95) / 2
    for k, (head, lines) in enumerate(cols):
        x = 0.575 + k * (cw + gap)
        d.rect(s, x, y + 0.25, cw, 0.42, fill=STEEL if k != 1 else NAVY2, text=head, size=13, bold=True, color="#FFFFFF")
        d.bullet_box(s, x, y + 0.67, cw, 6.72 - (y + 0.67), lines, size=12, line="#A6A6A6")
    return s


