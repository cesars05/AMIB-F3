def new_sheet(name, title, source, widths):
    if name in wb.sheetnames: del wb[name]
    ws = wb.create_sheet(name)
    ws.sheet_view.showGridLines = False; ws.sheet_view.zoomScale = 85
    ws.column_dimensions["A"].width = 3.7
    for c, w in widths.items(): ws.column_dimensions[c].width = w
    ws["B2"] = "US Steel Outlook – Data"; ws["B2"].font = F(size=12, bold=True, color=NAVY)
    ws["B3"] = title; ws["B3"].font = F(bold=True)
    ws["B4"] = source; ws["B4"].font = F(size=9, italic=True, color="595959")
    return ws


def header(ws, r, c, labels):
    for i, lab in enumerate(labels):
        x = ws.cell(r, c + i, lab); x.font = F(bold=True, color=NAVY); x.fill = HDR; x.border = Border(bottom=thin)
        x.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)


def put(ws, r, c, v, fmt=None, blue=False, bold=False):
    x = ws.cell(r, c, v); x.font = F(color=BLUE if blue else "000000", bold=bold)
    if fmt: x.number_format = fmt
    return x


