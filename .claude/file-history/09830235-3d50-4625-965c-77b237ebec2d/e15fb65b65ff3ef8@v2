def slide(title, subtitle=None, source=None, link=None):
    assert source is None or len(source) <= 92, f"source too long ({len(source)}): {source}"
    s = d.content_slide(title, subtitle, source=source)
    if source and link:
        for ph in s.placeholders:
            if (ph.top or 0) / 914400 > 6.5 and ph.has_text_frame and ph.text_frame.text == source:
                ph.text_frame.paragraphs[0].runs[0].hyperlink.address = link
    return s


def img(s, name, x, y, w=None, h=None, rule=True):
    W, H = Image.open(IMG + name).size
    if w and not h: h = w * H / W
    if h and not w: w = h * W / H
    s.shapes.add_picture(IMG + name, Inches(x), Inches(y), Inches(w), Inches(h))
    if rule:
        d.line(s, x, y - 0.06, x + w, y - 0.06, color="#000000", width=0.75)
    return x, y, w, h


def bullets(s, x, y, w, h, lines, size=14, anchor="top"):
    return d.text(s, x, y, w, h, ["- " + l for l in lines], size=size, align="justify", spacing=8, anchor=anchor)


def clustered(s, x, y, w, h, cats, series, colors, fmt, vmin=None, vmax=None, legend=True, label_size=9, gap=80, overlap=-20):
    gf, ch = d._chart(s, XL_CHART_TYPE.COLUMN_CLUSTERED, x, y, w, h, cats, series)
    pl = ch.plots[0]; pl.gap_width, pl.overlap = gap, overlap
    allv = [v for vs in series.values() for v in vs]
    d._axis_style(ch, vmin=vmin if vmin is not None else min(0, min(allv) * 1.25),
                  vmax=vmax if vmax is not None else max(allv) * 1.2, label_low=True)
    d._plot_layout(ch, 0.02, 0.06, 0.96, 0.76 if legend else 0.84)
    for ser, col in zip(pl.series, colors):
        d._fill(ser.format, col)
        d._labels(ser, size=label_size, fmt=fmt, pos=XL_LABEL_POSITION.OUTSIDE_END)
    d._legend(ch, legend)
    return gf, ch


