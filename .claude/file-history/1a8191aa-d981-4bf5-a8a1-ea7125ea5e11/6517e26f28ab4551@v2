def cols(s, x, y, w, items, h=2.4, size=12, sep=True):
    """n columnas: cada una con encabezado en negrita color primario y bullets, separadas por reglas finas."""
    n = len(items)
    cw = w / n
    for i, (head, bullets) in enumerate(items):
        d.text(s, x + i * cw + 0.1, y, cw - 0.2, 0.34, head, size=size + 1, bold=True, color=NAVY, inset=0)
