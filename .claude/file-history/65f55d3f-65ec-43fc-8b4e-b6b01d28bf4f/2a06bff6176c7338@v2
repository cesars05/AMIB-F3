def settext(obj, t):
    tf = obj.text_frame
    para = tf.paragraphs[0]
    if para.runs:
        para.runs[0].text = t
        for r in para.runs[1:]:
            r.text = ""
    else:
        para.text = t
    for extra in tf.paragraphs[1:]:
        extra._p.getparent().remove(extra._p)

def byname(s, n):
    return [x for x in s.shapes if x.name == n][0]

