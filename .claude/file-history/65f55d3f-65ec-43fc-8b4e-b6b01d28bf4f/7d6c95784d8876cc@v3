def covchart(sl, left, series, limit, limname, mx):
    """series: list of (name, values, color). Barras + línea punteada del covenant."""
    fmt = '0.0"x"'
    cd = CategoryChartData(number_format=fmt)
    cd.categories = yrs
    for nm, vals, _ in series:
        cd.add_series(nm, vals)
    cd.add_series(limname, [limit] * len(yrs))
    gf = sl.shapes.add_chart(XL_CHART_TYPE.COLUMN_CLUSTERED, left, T, W, H, cd)
    ch = gf.chart
    ch.has_legend = True
    ch.legend.include_in_layout = False
    ch.legend.position = XL_LEGEND_POSITION.BOTTOM
    ch.legend.font.size = Pt(11)
    ch.font.size = Pt(12)
    va = ch.value_axis
    va.visible = False
    va.has_major_gridlines = False
    va.minimum_scale = 0
    va.maximum_scale = mx
    ch.category_axis.format.line.color.rgb = RGBColor(0x80, 0x80, 0x80)
    pl = ch.plots[0]
    pl.gap_width = 60
    pl.overlap = -10
    for se, (_, _, col) in zip(list(pl.series)[:len(series)], series):
        se.format.fill.solid()
        se.format.fill.fore_color.rgb = col
        dl = se.data_labels
        dl.show_value = True
        dl.number_format = fmt
        dl.number_format_is_linked = False
        dl.position = XL_LABEL_POSITION.OUTSIDE_END
        dl.font.size = Pt(11)
    bar = ch._chartSpace.xpath(".//c:barChart")[0]
    ser_l = bar.xpath("c:ser")[len(series)]
    bar.remove(ser_l)
    for e in ser_l.xpath("c:invertIfNegative") + ser_l.xpath("c:spPr"):
        ser_l.remove(e)
    line = etree.Element(C + "lineChart")
    etree.SubElement(line, C + "grouping").set("val", "standard")
    etree.SubElement(line, C + "varyColors").set("val", "0")
    line.append(ser_l)
    sp = etree.fromstring(
        '<c:spPr xmlns:c="%s" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main">'
        '<a:ln w="28575" cap="rnd"><a:solidFill><a:srgbClr val="C0392B"/></a:solidFill>'
        '<a:prstDash val="dash"/><a:round/></a:ln></c:spPr>' % CNS)
    ser_l.xpath("c:tx")[0].addnext(sp)
    mk = etree.fromstring('<c:marker xmlns:c="%s"><c:symbol val="none"/></c:marker>' % CNS)
    sp.addnext(mk)
    etree.SubElement(line, C + "marker").set("val", "1")
    for ax in bar.xpath("c:axId"):
        etree.SubElement(line, C + "axId").set("val", ax.get("val"))
    bar.addnext(line)

