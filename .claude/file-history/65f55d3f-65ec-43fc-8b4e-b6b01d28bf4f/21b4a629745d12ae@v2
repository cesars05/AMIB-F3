def settext(shape, t):
    tf = shape.text_frame
    para = tf.paragraphs[0]
    if para.runs:
        para.runs[0].text = t
        for r in para.runs[1:]:
            r.text = ""
    else:
        para.text = t

def new_slide(title, subtitle, note):
    s = p.slides.add_slide(layout)
    for x in s.placeholders:
        if x.name.startswith("Title"):
            settext(x, title)
        elif x.name.startswith("Subtitle"):
            settext(x, subtitle)
    tp = [x for x in s.placeholders if x.name.startswith("Text Placeholder")]
    settext(tp[-1], note)
    n = tp[-1]
    n.left, n.top, n.width, n.height = 3300000, 6290000, 7950000, 480000
    for para in n.text_frame.paragraphs:
        for r in para.runs:
            r.font.size = Pt(9)
    for x in list(s.placeholders):
        if x.has_text_frame and not x.text_frame.text.strip():
            x._element.getparent().remove(x._element)
    return s

def textbox(s, x, y, w, h, text, size=12, bold=False, italic=False, color=BLACK, align=None, anchor=None):
    tb = s.shapes.add_textbox(x, y, w, h)
    tb.text_frame.word_wrap = True
    tb.text_frame.text = text
    if anchor:
        tb.text_frame.vertical_anchor = anchor
    para = tb.text_frame.paragraphs[0]
    if align:
        para.alignment = align
    r = para.runs[0]
    r.font.size = Pt(size); r.font.bold = bold; r.font.italic = italic; r.font.color.rgb = color
    return tb

def band(s, x, y, w, h, text, size=13):
    b = s.shapes.add_shape(MSO_SHAPE.RECTANGLE, x, y, w, h)
    b.fill.solid(); b.fill.fore_color.rgb = NAVY
    b.line.fill.background()
    tf = b.text_frame
    tf.margin_left = Emu(120000)
    tf.vertical_anchor = MSO_ANCHOR.MIDDLE
    tf.text = text
    para = tf.paragraphs[0]
    para.alignment = PP_ALIGN.LEFT
    r = para.runs[0]
    r.font.size = Pt(size); r.font.bold = True; r.font.color.rgb = WHITE
    return b

def panel(s, x, y, w, h, head):
    body = s.shapes.add_shape(MSO_SHAPE.RECTANGLE, x, y, w, h)
    body.fill.solid(); body.fill.fore_color.rgb = GRAY
    body.line.fill.background()
    band(s, x, y, w, 400000, head)

def bar_chart(s, x, y, w, h, cats, series, fmt, mx, legend=True, mn=0, label_size=12, gap=60, overlap=-10):
    cd = CategoryChartData(number_format=fmt)
    cd.categories = cats
    for nm, vals, _ in series:
        cd.add_series(nm, vals)
    ch = s.shapes.add_chart(XL_CHART_TYPE.COLUMN_CLUSTERED, x, y, w, h, cd).chart
    ch.has_title = False
    ch.has_legend = legend
    if legend:
        ch.legend.include_in_layout = False
        ch.legend.position = XL_LEGEND_POSITION.TOP
        ch.legend.font.size = Pt(12)
    ch.font.size = Pt(12)
    ch.value_axis.visible = False
    ch.value_axis.has_major_gridlines = False
    ch.value_axis.minimum_scale = mn
    ch.value_axis.maximum_scale = mx
    ch.category_axis.format.line.color.rgb = RGBColor(0x80, 0x80, 0x80)
    ch.category_axis.tick_labels.font.size = Pt(12)
    ch.category_axis.tick_label_position = XL_TICK_LABEL_POSITION.LOW
    pl = ch.plots[0]
    pl.gap_width = gap
    pl.overlap = overlap
    for se, (_, _, col) in zip(pl.series, series):
        se.format.fill.solid(); se.format.fill.fore_color.rgb = col
        se.invert_if_negative = False
        dl = se.data_labels
        dl.show_value = True
        dl.number_format = fmt
        dl.number_format_is_linked = False
        dl.position = XL_LABEL_POSITION.OUTSIDE_END
        dl.font.size = Pt(label_size); dl.font.bold = True
    return ch

def table(s, x, y, w, col0, rows, rowh=300000, size=11):
    n, m = len(rows), len(rows[0])
    gf = s.shapes.add_table(n, m, x, y, w, rowh * n)
    t = gf.table
    t.columns[0].width = col0
    for j in range(1, m):
        t.columns[j].width = int((w - col0) / (m - 1))
    for i, row in enumerate(rows):
        t.rows[i].height = rowh
        for j, v in enumerate(row):
            c = t.cell(i, j)
            c.text = v
            c.fill.solid()
            c.fill.fore_color.rgb = RGBColor(0xE3, 0xE6, 0xEC) if i == 0 else WHITE
            c.margin_top = c.margin_bottom = Emu(20000)
            c.vertical_anchor = MSO_ANCHOR.MIDDLE
            para = c.text_frame.paragraphs[0]
            para.alignment = PP_ALIGN.LEFT if j == 0 else PP_ALIGN.CENTER
            r = para.runs[0]
            r.font.size = Pt(size); r.font.color.rgb = BLACK
            r.font.bold = (i == 0)
    return gf

def cards(s, items, x0=7750000, y0=1450000, w=3950000, h=1380000, gap=130000):
    y = y0
    for i, (head, body) in enumerate(items, 1):
        bx = s.shapes.add_shape(MSO_SHAPE.RECTANGLE, x0, y, w, h)
        bx.fill.solid(); bx.fill.fore_color.rgb = GRAY
        bx.line.fill.background()
        band(s, x0, y, w, 400000, "%d  %s" % (i, head))
        textbox(s, x0 + 100000, y + 450000, w - 200000, h - 480000, body, size=13)
        y += h + gap

