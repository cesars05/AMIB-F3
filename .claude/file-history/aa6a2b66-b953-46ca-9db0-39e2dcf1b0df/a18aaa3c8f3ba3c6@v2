$xl = [Runtime.InteropServices.Marshal]::GetActiveObject('Excel.Application')
$m  = $xl.Workbooks.Item('20260922_SETSA Transportes.xlsx').Worksheets.Item('Modelo SETSA')

function Move-ToEnd([string]$needle) {
    $f = $m.Columns.Item(3).Find($needle, [Type]::Missing, -4163, 2)   # xlValues, xlPart
    if ($f -eq $null) { return "NO ENCONTRADO: $needle" }
    $r = $f.Row
    $last = $m.Cells.Item($m.Rows.Count, 3).End(-4162).Row
    if ($r -ge $last) { return "ya al final: $needle" }
    $m.Rows.Item($r).Cut() | Out-Null
    $m.Rows.Item($last + 1).Insert() | Out-Null
    return "movido: $needle (fila $r -> $last)"
}

Move-ToEnd 'Check: activo - (pasivo'
