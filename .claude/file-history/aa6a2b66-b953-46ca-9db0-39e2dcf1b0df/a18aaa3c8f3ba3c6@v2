if ($f -ne $null) { $f.Value2 = 'Check: cartera en concurso - balance'; Move-ToEnd 'Check: cartera en concurso - balance' }
$xl.CutCopyMode = $false
$last = $m.Cells.Item($m.Rows.Count, 3).End(-4162).Row
