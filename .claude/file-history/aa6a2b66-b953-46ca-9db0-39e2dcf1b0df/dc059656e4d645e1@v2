def new_sheet(title, heading, tab, info, notes_col=True):
    ws = wb.create_sheet(title)
    ws.sheet_view.showGridLines = False
    ws.sheet_view.zoomScale = 85
    ws.sheet_properties.tabColor = tab
    ws.column_dimensions["A"].width = 2
    ws.column_dimensions["B"].width = 2
    ws.column_dimensions["C"].width = 58
    for c in COLS: ws.column_dimensions[c].width = 16
    ws.column_dimensions["J"].width = 3
    ws.column_dimensions["K"].width = 60
    ws.row_dimensions[2].height = 37.2
    for col in range(3, 12):
        ws.cell(2, col).fill = fill(NAVY)
    t = ws.cell(2, 3, heading); t.font = F(size=30, color=WHITE); t.alignment = Alignment(horizontal="left", vertical="center")
    for i, (txt, bold, ital, sz) in enumerate(info):
        r = 4 + i
        for col in range(3, 5): ws.cell(r, col).fill = fill(GREY_INFO)
        c = ws.cell(r, 3, txt); c.font = F(size=sz, bold=bold, italic=ital)
    return ws

def header(ws, r, label, cols=True, note=None):
    c = ws.cell(r, 3, label); c.font = F(size=11, bold=True, color=WHITE); c.fill = fill(NAVY)
    c.border = Border(bottom=thin)
    if cols:
        for i, col in enumerate(COLS):
            h = ws[f"{col}{r}"]; h.value = PER[i]; h.font = F(size=11, bold=True, color=WHITE)
            h.fill = fill(NAVY); h.alignment = Alignment(horizontal="right"); h.border = Border(bottom=thin)
    if note is not None:
        n = ws.cell(r, 11, note); n.font = F(size=11, bold=True, color=WHITE); n.fill = fill(NAVY); n.border = Border(bottom=thin)

def subheader(ws, r):
    c = ws.cell(r, 3, "Periodo"); c.font = F(italic=True); c.fill = fill(SUB)
    for i, col in enumerate(COLS):
        h = ws[f"{col}{r}"]; h.value = SUBP[i]; h.font = F(italic=True); h.fill = fill(SUB)
        h.alignment = Alignment(horizontal="right")

def line(ws, r, label, vals, kind="input", fmt=NUM, bold=False, indent=1, top=False, note=None, italic=None):
    """kind: input (azul) | calc (negro) | link (verde, otra hoja)"""
    it = (not bold) if italic is None else italic
    c = ws.cell(r, 3, label); c.font = F(bold=bold, italic=it, color=BLACK)
    c.alignment = Alignment(horizontal="left", indent=0 if bold else indent)
    if top: c.border = Border(top=thin)
    color = {"input": BLUE, "calc": BLACK, "link": GREEN}[kind]
    for i, col in enumerate(COLS):
        v = vals[i] if isinstance(vals, (list, tuple)) else vals(col, i)
        cell = ws[f"{col}{r}"]
        cell.value = v
        cell.font = F(bold=bold, italic=(kind == "input" and not bold), color=color)
        cell.fill = fill(GREY_NUM); cell.number_format = fmt
        cell.alignment = Alignment(horizontal="right")
        if top: cell.border = Border(top=thin)
    if note:
        n = ws.cell(r, 11, note); n.font = F(size=9, italic=True, color="595959")
        n.alignment = Alignment(wrap_text=False)

def label(ws, r, text, bold=True, top=True):
    c = ws.cell(r, 3, text); c.font = F(bold=bold)
    if top: c.border = Border(top=thin)

def prev(col):  # columna anterior
    return L(COLS.index(col) + C0 - 1)

class R:  # contador de filas con registro por clave
    def __init__(self, start): self.r = start; self.k = {}
    def nxt(self, key=None, skip=0):
        self.r += 1 + skip
        if key: self.k[key] = self.r
        return self.r
    def __getitem__(self, k): return self.k[k]

