$ErrorActionPreference = 'Stop'
$xl = [Runtime.InteropServices.Marshal]::GetActiveObject('Excel.Application')
$t = $null; foreach ($w in $xl.Workbooks) { if ($w.Name -eq '20260922_SETSA Transportes.xlsx') { $t = $w } }
if (-not $t) { throw 'libro no encontrado' }
$tx = $t.Worksheets.Item('Transacciones Precedentes')
$m  = $t.Worksheets.Item('Modelo SETSA')

# validar filas del modelo
if ([string]$m.Range('C42').Value2 -ne 'EBITDA Ajustado') { throw 'Modelo C42 no es EBITDA Ajustado' }
if (-not ([string]$m.Range('C321').Value2).StartsWith('Capex Neto')) { throw 'Modelo C321 no es Capex' }
if ([string]$m.Range('F13').Text -ne '2023A' -or [string]$m.Range('H13').Text -ne '2025A') { throw 'columnas de años inesperadas' }

$r = 0; for ($i = 40; $i -le 60; $i++) { if (([string]$tx.Cells.Item($i,3).Value2).StartsWith('TEV / (EBITDA Ajustado - Capex')) { $r = $i } }
if ($r -eq 0) { throw 'no encontre la fila de EBITDA - capex' }

# fila nueva arriba: TEV / EBITDA Ajustado Promedio 2023-25
$tx.Rows.Item($r).Insert() | Out-Null
$tx.Rows.Item($r + 1).Copy() | Out-Null; $tx.Rows.Item($r).PasteSpecial(-4122) | Out-Null; $xl.CutCopyMode = $false
$tx.Range("C$r").Value2 = 'TEV / EBITDA Ajustado Promedio 2023–25'
$tx.Range("F$r").Formula = "=F40/AVERAGE('Modelo SETSA'!F42:H42)"
$r2 = $r + 1
$tx.Range("C$r2").Value2 = 'TEV / (EBITDA Ajustado - Capex), Promedio 2023–25'
$tx.Range("F$r2").Formula = "=F40/(AVERAGE('Modelo SETSA'!F42:H42)-AVERAGE('Modelo SETSA'!F321:H321))"

$xl.CalculateFull()
$err = 0; foreach ($ws in $t.Worksheets) { foreach ($c in $ws.UsedRange.Cells) { if (([string]$c.Text).StartsWith('#') -or ([string]$c.Formula).Contains('#REF')) { $err++ } } }
"errores=$err"
"EBITDA aj 2023-25: " + $m.Range('F42').Text + ' / ' + $m.Range('G42').Text + ' / ' + $m.Range('H42').Text + " | Capex: " + $m.Range('F321').Text + ' / ' + $m.Range('G321').Text + ' / ' + $m.Range('H321').Text
for ($i = 48; $i -le 55; $i++) { "$i | " + $tx.Cells.Item($i,3).Value2 + " | " + $tx.Range("F$i").Formula + " = " + $tx.Range("F$i").Text }
$t.Save(); "guardado=" + $t.Saved
