def num(s):
    s = s.strip()
    if s in ('-', '–', '($0)', '$0'): return 0.0
    neg = s.startswith('(') or s.startswith('-') or s.startswith('($')
    x = re.sub(r'[^\d.]', '', s)
    if x == '': return None
    v = float(x)
    if s.endswith('%'): v = v / 100
    return -v if neg else v

def isnum(s):
    s = s.strip()
    return bool(re.fullmatch(r'\(?-?\$?\(?[\d,]+(\.\d+)?%?x?\)?%?x?|-|–|\(\$0\)', s))

def parse(page, reverse):
    lines = [l for l in open(f'{D}\\pdf_p{page}.txt', encoding='utf-8').read().splitlines() if l.strip()]
    toks = []
    for l in lines:
        parts = l.split()
        if len(parts) > 1 and all(isnum(p) for p in parts): toks += parts
        else: toks.append(l)
    out = {}; i = 0
    while i < len(toks):
        if not isnum(toks[i]) and i + 6 < len(toks) + 1 and all(isnum(t) for t in toks[i+1:i+7]):
            vals = [num(t) for t in toks[i+1:i+7]]
            if reverse: vals = vals[::-1]
            lab = toks[i].strip()
            k = lab; n = 2
            while k in out: k = f'{lab}#{n}'; n += 1
            out[k] = vals; i += 7
        else: i += 1
    return out

