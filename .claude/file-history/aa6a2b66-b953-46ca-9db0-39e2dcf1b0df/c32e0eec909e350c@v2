def compare(tag, srcvals, model_label, sign=1, tol=2.0, nth=1, pct=False):
    r = mrow(model_label, nth)
    if r is None: results.append((tag, model_label, 'FILA NO ENCONTRADA EN MODELO', '')); return
    mv = mvals(r)
    for i, (s, v) in enumerate(zip(srcvals, mv)):
        if s is None: continue
        v = 0.0 if v in (None, '') else v
        if isinstance(v, str): results.append((tag, model_label, PER[i], f'texto en modelo: {v}')); continue
        diff = v - sign * s
        t = (0.0015 if pct else tol)
        if abs(diff) > t:
            results.append((tag, f'{model_label} (fila {r})', PER[i], f'presentacion={sign*s:,.4f} modelo={v:,.4f} dif={diff:,.4f}'))
    results.append((tag, f'{model_label} (fila {r})', 'OK' if not any(x[1].startswith(model_label) and x[2] in PER for x in results) else 'REVISAR', ''))

