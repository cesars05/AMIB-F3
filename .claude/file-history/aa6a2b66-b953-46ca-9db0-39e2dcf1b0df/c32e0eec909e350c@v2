def mrow(lab, nth=1):
    hits = [r for r in range(1, m.max_row + 1) if str(m.cell(r, 3).value) == lab]
    return hits[nth - 1] if len(hits) >= nth else None
def mvals(r): return [m.cell(r, c).value for c in range(4, 10)]

