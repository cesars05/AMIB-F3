$ErrorActionPreference = 'Stop'
$xl = [Runtime.InteropServices.Marshal]::GetActiveObject('Excel.Application')
$w = $xl.Workbooks.Item('20260930_SETSA_Posibles_Compradores.xlsx')
$w.SaveCopyAs("$PSScriptRoot\backup_compradores_antes_filtro.xlsx")
$s = $w.Worksheets.Item('Posibles Compradores (2)')
if ([string]$s.Range('C5').Value2 -ne 'Comprador' -or [string]$s.Range('J5').Value2 -ne 'Afinidad') { throw 'layout inesperado' }
$keep = @('Alta', 'Media-Alta')
$SECT = 15917529

# 1) borrar filas de afinidad menor (de abajo hacia arriba)
$last = 44
for ($r = $last; $r -ge 7; $r--) {
    $name = [string]$s.Cells.Item($r, 3).Value2
    $aff = [string]$s.Cells.Item($r, 10).Value2
    $isSect = ($s.Cells.Item($r, 4).Interior.Color -eq $SECT)
    if (-not $isSect -and $name -ne '' -and $keep -notcontains $aff) { $s.Rows.Item($r).Delete() | Out-Null }
}
# 2) borrar secciones que quedaron vacías
$r = 7
while ($true) {
    $name = [string]$s.Cells.Item($r, 3).Value2
    if ($name -eq '') { break }
    $isSect = ($s.Cells.Item($r, 4).Interior.Color -eq $SECT)
    $nextSect = ($s.Cells.Item($r + 1, 4).Interior.Color -eq $SECT) -or ([string]$s.Cells.Item($r + 1, 3).Value2 -eq '')
    if ($isSect -and $nextSect) { $s.Rows.Item($r).Delete() | Out-Null } else { $r++ }
}
# 3) rebandear dentro de cada sección
$r = 7; $k = 0
while ([string]$s.Cells.Item($r, 3).Value2 -ne '') {
    if ($s.Cells.Item($r, 4).Interior.Color -eq $SECT) { $k = 0 }
    else {
        foreach ($c in 3,4,5,6,7,8,9,11) {
            if ($k % 2) { $s.Cells.Item($r, $c).Interior.Color = 15921906 } else { $s.Cells.Item($r, $c).Interior.Pattern = -4142 }
        }
        $k++
    }
    $r++
}
$s.Range('C2').Value2 = 'Grupo SESA (SETSA Transportes) ' + [char]0x2013 + ' Compradores Prioritarios (Afinidad Alta y Media-Alta)'
$s.Name = 'Compradores Prioritarios'
$w.Worksheets.Item(1).Activate() | Out-Null; $s.Range('A1').Select() | Out-Null
for ($i = 7; $i -le $r + 6; $i++) { "$i | " + $s.Cells.Item($i, 3).Text + ' | ' + $s.Cells.Item($i, 10).Text }
$w.Save(); 'guardado=' + $w.Saved
