{
  "name": "amib-f3",
  "productName": "AMIB F3",
  "version": "0.1.0",
  "description": "App de estudio, diagnóstico y simulador para el examen AMIB Figura 3 (Serie 210)",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "cesars05",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "e2e:linux": "npm run build && xvfb-run -a -s \"-screen 0 1920x1080x24\" playwright test",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  }
}
